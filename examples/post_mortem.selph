; ─────────────────────────────────────────────────────────────────────────
; Post-mortem spec analysis (§9.49)
; ─────────────────────────────────────────────────────────────────────────
;
; After a curriculum run, grow-v2 binds __curriculum_results__ and calls
; `run-post-mortem` if defined. Instead of retrying with more budget,
; this version analyzes each failed task's spec to classify the failure
; mode — guiding what M-chain forms or builtins to build next.
;
; Each result ns has:
;   "name", "found", "candidates", "output-type", "m-chain-ran",
;   "strategy", "spec" (list of (input, output) pairs),
;   "max-candidates", "depth", "arity" (optional)

; ── Helpers ───────────────────────────────────────────────────────────

(define pm-failures
  (lambda (results)
    (filter (lambda (r) (not (ns-get r "found"))) results)))

(define pm-member?
  (lambda (v lst)
    (if (= (length lst) 0) false
      (if (= v (head lst)) true
        (pm-member? v (tail lst))))))

(define pm-unique
  (lambda (lst)
    (reduce (lambda (acc v)
              (if (pm-member? v acc) acc (append acc (list v))))
            lst (list))))

(define pm-all?
  (lambda (pred lst)
    (if (= (length lst) 0) true
      (if (pred (head lst))
        (pm-all? pred (tail lst))
        false))))

(define pm-any?
  (lambda (pred lst)
    (if (= (length lst) 0) false
      (if (pred (head lst)) true
        (pm-any? pred (tail lst))))))

(define pm-count
  (lambda (pred lst)
    (reduce (lambda (acc v) (if (pred v) (+ acc 1) acc)) lst 0)))

; ── Grid spec extractors ─────────────────────────────────────────────
;
; For arity-1 task-args, each input is ((grid)), so unwrap with head.

(define pm-get-input-grid
  (lambda (pair)
    (let ((inp (head pair)))
      (if (list? inp)
        (if (and (= (length inp) 1) (list? (head inp)))
          (head inp)   ; unwrap arity-1 wrapper
          inp)
        inp))))

(define pm-get-output-grid
  (lambda (pair)
    (head (tail pair))))

; ── Size analysis ────────────────────────────────────────────────────

(define pm-size-category
  (lambda (spec)
    (let ((pairs spec))
      (let ((size-rels
              (map (lambda (p)
                (let ((ig (pm-get-input-grid p))
                      (og (pm-get-output-grid p)))
                  (let ((ih (try (length ig) 0))
                        (iw (try (length (head ig)) 0))
                        (oh (try (length og) 0))
                        (ow (try (length (head og)) 0)))
                    (if (and (= ih oh) (= iw ow)) "same-size"
                      (if (and (<= oh ih) (<= ow iw)) "shrink"
                        (if (and (>= oh ih) (>= ow iw)) "grow"
                          "reshape"))))))
                pairs)))
        (let ((u (pm-unique size-rels)))
          (if (= (length u) 1) (head u)
            (if (pm-all? (lambda (s) (or (= s "shrink") (= s "same-size"))) u) "shrink"
              (if (pm-all? (lambda (s) (or (= s "grow") (= s "same-size"))) u) "grow"
                "mixed-size"))))))))

; ── Color analysis ───────────────────────────────────────────────────

; Extract unique values from a grid (list of list of int).
(define pm-grid-colors
  (lambda (g)
    (pm-unique (reduce append g (list)))))

(define pm-color-category
  (lambda (spec)
    (let ((pairs spec))
      (let ((rels
              (map (lambda (p)
                (let ((ig (pm-get-input-grid p))
                      (og (pm-get-output-grid p)))
                  (let ((ic (try (pm-grid-colors ig) (list)))
                        (oc (try (pm-grid-colors og) (list))))
                    (if (= (length ic) 0) "unknown"
                      (if (pm-all? (lambda (c) (pm-member? c ic)) oc)
                        (if (pm-all? (lambda (c) (pm-member? c oc)) ic)
                          "same-colors"
                          "color-subset")
                        (if (pm-all? (lambda (c) (pm-member? c oc)) ic)
                          "color-superset"
                          "new-colors"))))))
                pairs)))
        (let ((u (pm-unique rels)))
          (if (= (length u) 1) (head u) "mixed-colors"))))))

; ── Output constancy ─────────────────────────────────────────────────

(define pm-constant-output?
  (lambda (spec)
    (if (<= (length spec) 1) false
      (let ((outs (map pm-get-output-grid spec)))
        (let ((first-out (head outs)))
          (pm-all? (lambda (o) (= o first-out)) (tail outs)))))))

; ── Dimension consistency ────────────────────────────────────────────

(define pm-output-dims-consistent?
  (lambda (spec)
    (let ((dims (map (lambda (p)
                  (let ((og (pm-get-output-grid p)))
                    (list (try (length og) -1)
                          (try (length (head og)) -1))))
                spec)))
      (if (<= (length dims) 1) true
        (let ((first-d (head dims)))
          (pm-all? (lambda (d) (= d first-d)) (tail dims)))))))

; ── Object count analysis ────────────────────────────────────────────

; Count unique non-background colors in a grid.
; Background = most common color (simple heuristic).
(define pm-grid-fg-color-count
  (lambda (g)
    (let ((colors (pm-grid-colors g)))
      (if (<= (length colors) 1) 0
        (- (length colors) 1)))))

(define pm-object-category
  (lambda (spec)
    (let ((counts
            (map (lambda (p)
              (let ((ig (pm-get-input-grid p)))
                (try (pm-grid-fg-color-count ig) -1)))
              spec)))
      (if (pm-any? (lambda (c) (= c -1)) counts) "unknown"
        (let ((u (pm-unique counts)))
          (if (= (length u) 1)
            (concat "fixed-" (head u) "-fg-colors")
            (concat "varying-" (length u) "-distinct")))))))

; ── Scale detection ──────────────────────────────────────────────────

(define pm-scale-category
  (lambda (spec)
    (let ((ratios
            (map (lambda (p)
              (let ((ig (pm-get-input-grid p))
                    (og (pm-get-output-grid p)))
                (let ((ih (try (length ig) 0))
                      (oh (try (length og) 0)))
                  (if (= ih 0) 0
                    (if (= (modulo oh ih) 0) (/ oh ih) -1)))))
              spec)))
      (let ((u (pm-unique ratios)))
        (if (and (= (length u) 1) (> (head u) 1))
          (concat "scale-" (head u) "x")
          (if (and (= (length u) 1) (= (head u) 1))
            "no-scale"
            "no-uniform-scale"))))))

; ── Builtin probe: try every unary grid op ────────────────────────────
;
; For each failure, try applying each grid builtin to the input and
; check if it produces the expected output across ALL training pairs.
; Returns the name of the first matching op, or "none".

(define pm-grid-ops
  (list
    (list "grid-rotate-cw"  grid-rotate-cw)
    (list "grid-rotate-ccw" grid-rotate-ccw)
    (list "grid-rotate-180" grid-rotate-180)
    (list "grid-flip-h"     grid-flip-h)
    (list "grid-flip-v"     grid-flip-v)
    (list "grid-transpose"  grid-transpose)
    (list "grid-trim"       grid-trim)
    (list "grid-gravity-down"  grid-gravity-down)
    (list "grid-gravity-up"    grid-gravity-up)
    (list "grid-gravity-left"  grid-gravity-left)
    (list "grid-gravity-right" grid-gravity-right)))

; Try one op on all spec pairs. Returns true if it matches everywhere.
(define pm-op-matches-all?
  (lambda (op spec)
    (pm-all? (lambda (p)
      (let ((ig (pm-get-input-grid p))
            (og (pm-get-output-grid p)))
        (= (try (op ig) nil) og)))
      spec)))

; Find first matching unary op, or "none".
(define pm-probe-unary
  (lambda (spec)
    (pm-probe-unary-loop pm-grid-ops spec)))

(define pm-probe-unary-loop
  (lambda (ops spec)
    (if (= (length ops) 0) "none"
      (let ((entry (head ops)))
        (let ((name (head entry))
              (op   (head (tail entry))))
          (if (try (pm-op-matches-all? op spec) false)
            name
            (pm-probe-unary-loop (tail ops) spec)))))))

; ── Depth-2 probe: try op1(op2(input)) ───────────────────────────────

(define pm-probe-depth2
  (lambda (spec)
    (pm-probe-d2-outer pm-grid-ops spec)))

(define pm-probe-d2-outer
  (lambda (ops1 spec)
    (if (= (length ops1) 0) "none"
      (let ((e1 (head ops1)))
        (let ((n1 (head e1))
              (o1 (head (tail e1))))
          (let ((result (pm-probe-d2-inner o1 n1 pm-grid-ops spec)))
            (if (= result "none")
              (pm-probe-d2-outer (tail ops1) spec)
              result)))))))

(define pm-probe-d2-inner
  (lambda (op1 name1 ops2 spec)
    (if (= (length ops2) 0) "none"
      (let ((e2 (head ops2)))
        (let ((n2 (head e2))
              (o2 (head (tail e2))))
          (if (try (pm-op-matches-all?
                     (lambda (g) (op1 (o2 g)))
                     spec) false)
            (concat name1 "(" n2 ")")
            (pm-probe-d2-inner op1 name1 (tail ops2) spec)))))))

; ── Object-level probes ───────────────────────────────────────────────
;
; Deeper probes that operate at the object level rather than whole-grid.
; These fire for the "object-recomposition" and "object-extraction"
; prescription buckets to sub-classify failures.

; -- Helpers --

; Safe object extraction: returns list of objects or empty list on error.
(define pm-safe-objects
  (lambda (g)
    (try (grid-objects g) (list))))

; Count objects in a grid (connected components, 4-connected).
(define pm-object-count
  (lambda (g)
    (length (pm-safe-objects g))))

; -- Object-recomposition sub-classification --
;
; For same-size + same-colors tasks. Probes:
;   1. Object count conservation (same # objects in/out?)
;   2. Per-object unary transform (extract each obj, transform, place back)
;   3. Object repositioning (same objects, different positions)
;   4. Single-object change (only one object differs)

(define pm-subtype-recomp
  (lambda (spec)
    (let ((pairs spec))
      ; Step 1: Check object count conservation across all pairs
      (let ((obj-counts
              (map (lambda (p)
                (let ((ig (pm-get-input-grid p))
                      (og (pm-get-output-grid p)))
                  (list (try (pm-object-count ig) -1)
                        (try (pm-object-count og) -1))))
                pairs)))
        (let ((counts-conserved
                (pm-all? (lambda (c) (= (nth c 0) (nth c 1))) obj-counts))
              (in-counts (map (lambda (c) (nth c 0)) obj-counts))
              (typical-count (nth (head obj-counts) 0)))

          ; Step 2: Try per-object unary transforms
          (let ((per-obj-result (try (pm-probe-per-object-transform spec) "none")))

            ; Step 3: Try direct object extraction match (output = one of input's objects?)
            (let ((obj-extract-result (try (pm-probe-object-index spec) "none")))

              ; Step 4: Check if only one object differs between input and output
              (let ((single-change (try (pm-probe-single-object-change spec) false)))

                ; Classify
                (if (not (= per-obj-result "none"))
                  (concat "per-object-transform:" per-obj-result)
                  (if (not (= obj-extract-result "none"))
                    (concat "object-select:" obj-extract-result)
                    (if single-change
                      (if counts-conserved
                        (concat "single-object-change:n=" typical-count)
                        "object-count-change")
                      (if counts-conserved
                        (if (and (> typical-count 0) (<= typical-count 2))
                          (concat "few-objects-recomp:n=" typical-count)
                          (if (> typical-count 2)
                            (concat "many-objects-recomp:n=" typical-count)
                            "no-objects-detected"))
                        "object-count-change"))))))))))))

; Try each unary transform on each object individually, place back, check match.
; Returns the transform name or "none".
(define pm-per-object-transforms
  (list
    (list "rotate-cw"   grid-rotate-cw)
    (list "rotate-ccw"  grid-rotate-ccw)
    (list "rotate-180"  grid-rotate-180)
    (list "flip-h"      grid-flip-h)
    (list "flip-v"      grid-flip-v)))

(define pm-probe-per-object-transform
  (lambda (spec)
    (pm-probe-pot-loop pm-per-object-transforms spec)))

(define pm-probe-pot-loop
  (lambda (ops spec)
    (if (= (length ops) 0) "none"
      (let ((entry (head ops)))
        (let ((name (head entry))
              (op   (head (tail entry))))
          (if (try (pm-pot-matches-all? op spec) false)
            name
            (pm-probe-pot-loop (tail ops) spec)))))))

; Check if applying `op` to every object in input and placing back gives output.
(define pm-pot-matches-all?
  (lambda (op spec)
    (pm-all? (lambda (p)
      (let ((ig (pm-get-input-grid p))
            (og (pm-get-output-grid p)))
        (let ((objs (pm-safe-objects ig)))
          (if (= (length objs) 0) false
            (let ((bg (grid-background ig)))
              ; Start from a blank grid of same dims, place transformed objects
              (let ((result (pm-apply-to-all-objects ig objs op bg)))
                (= result og)))))))
      spec)))

; Apply op to each object, place at its original position on a bg-filled grid.
(define pm-apply-to-all-objects
  (lambda (grid objs op bg)
    (let ((h (grid-height grid))
          (w (grid-width grid)))
      (let ((base (grid-blank h w bg)))
        (reduce
          (lambda (acc i)
            (let ((obj (nth objs i))
                  (transformed (op (nth objs i))))
              ; Find position of this object in the original grid
              (let ((pos (try (pm-find-object-pos grid obj bg) nil)))
                (if (nil? pos)
                  acc  ; skip if can't find position
                  (try (grid-place acc transformed (nth pos 0) (nth pos 1)) acc)))))
          (range (length objs))
          base)))))

; Find the top-left position of an object within a grid.
; Object is a sub-grid with bg=0; find where its non-bg cells map.
(define pm-find-object-pos
  (lambda (grid obj bg)
    (let ((oh (grid-height obj))
          (ow (grid-width obj)))
      ; Scan for first non-bg cell in obj, find its position in grid
      (pm-find-obj-pos-scan grid obj bg 0 0 oh ow))))

(define pm-find-obj-pos-scan
  (lambda (grid obj bg r c oh ow)
    (if (>= r oh) nil
      (if (>= c ow)
        (pm-find-obj-pos-scan grid obj bg (+ r 1) 0 oh ow)
        (let ((cell (grid-get obj r c)))
          (if (= cell bg)
            (pm-find-obj-pos-scan grid obj bg r (+ c 1) oh ow)
            ; Found first non-bg cell at (r, c) in obj
            ; Search grid for this cell value and check if obj fits there
            (pm-find-obj-in-grid grid obj bg r c)))))))

(define pm-find-obj-in-grid
  (lambda (grid obj bg obj-r obj-c)
    (let ((gh (grid-height grid))
          (gw (grid-width grid))
          (oh (grid-height obj))
          (ow (grid-width obj))
          (target (grid-get obj obj-r obj-c)))
      ; The object's top-left in the grid would be at (gr - obj-r, gc - obj-c)
      ; Try each position where target appears
      (pm-find-obj-grid-scan grid obj bg obj-r obj-c target 0 0 gh gw oh ow))))

(define pm-find-obj-grid-scan
  (lambda (grid obj bg or oc target r c gh gw oh ow)
    (if (>= r gh) nil
      (if (>= c gw)
        (pm-find-obj-grid-scan grid obj bg or oc target (+ r 1) 0 gh gw oh ow)
        (if (= (grid-get grid r c) target)
          ; Candidate: obj top-left would be at (r - or, c - oc)
          (let ((tr (- r or))
                (tc (- c oc)))
            (if (and (>= tr 0) (>= tc 0)
                     (<= (+ tr oh) gh) (<= (+ tc ow) gw))
              (if (pm-obj-fits-at? grid obj bg tr tc oh ow)
                (list tr tc)
                (pm-find-obj-grid-scan grid obj bg or oc target r (+ c 1) gh gw oh ow))
              (pm-find-obj-grid-scan grid obj bg or oc target r (+ c 1) gh gw oh ow)))
          (pm-find-obj-grid-scan grid obj bg or oc target r (+ c 1) gh gw oh ow))))))

; Check if obj placed at (tr, tc) matches grid for all non-bg cells.
(define pm-obj-fits-at?
  (lambda (grid obj bg tr tc oh ow)
    (pm-all?
      (lambda (r)
        (pm-all?
          (lambda (c)
            (let ((cell (grid-get obj r c)))
              (if (= cell bg) true
                (= (grid-get grid (+ tr r) (+ tc c)) cell))))
          (range ow)))
      (range oh))))

; -- Object index probe (for extraction bucket too) --
;
; Try grid-object(input, 0..3) and grid-trim(input) against output.

(define pm-probe-object-index
  (lambda (spec)
    (let ((result
            (reduce
              (lambda (acc idx)
                (if (not (= acc "none")) acc
                  (if (pm-all? (lambda (p)
                        (let ((ig (pm-get-input-grid p))
                              (og (pm-get-output-grid p)))
                          (= (try (grid-object ig idx) nil) og)))
                        spec)
                    (concat "grid-object-" idx)
                    acc)))
              (list 0 1 2 3)
              "none")))
      ; Also try grid-trim
      (if (not (= result "none")) result
        (if (pm-all? (lambda (p)
              (let ((ig (pm-get-input-grid p))
                    (og (pm-get-output-grid p)))
                (= (try (grid-trim ig) nil) og)))
              spec)
          "grid-trim"
          result)))))

; -- Single-object-change probe --
;
; Check if exactly one object differs between input and output
; (all others are identical). Indicates a targeted edit.

(define pm-probe-single-object-change
  (lambda (spec)
    (pm-all? (lambda (p)
      (let ((ig (pm-get-input-grid p))
            (og (pm-get-output-grid p)))
        (let ((in-objs (pm-safe-objects ig))
              (out-objs (pm-safe-objects og)))
          (if (not (= (length in-objs) (length out-objs))) false
            (if (= (length in-objs) 0) false
              (let ((diffs (pm-count (lambda (i)
                      (not (= (nth in-objs i) (nth out-objs i))))
                      (range (length in-objs)))))
                (= diffs 1)))))))
      spec)))

; -- Object-extraction sub-classification --
;
; For shrink tasks. Probes:
;   1. Direct object index match (grid-object(x, 0..3))
;   2. grid-trim match
;   3. Color-based extraction (extract cells of one non-bg color)
;   4. Smallest/largest object
;   5. Crop to bounding box of non-bg content

(define pm-subtype-extract
  (lambda (spec)
    ; Use Rust builtin for fast probing
    (let ((result (try (grid-probe-extract spec) (ns ("found" false) ("method" "none")))))
      (if (ns-get result "found")
        (concat "direct:" (ns-get result "source"))
        (concat "complex:" (try (pm-extract-obj-info spec) "unknown"))))))

; Try extracting objects of each non-background color and check vs output.
(define pm-probe-color-extract
  (lambda (spec)
    (let ((first-in (pm-get-input-grid (head spec))))
      (let ((bg (try (grid-background first-in) 0))
            (colors (try (pm-grid-colors first-in) (list))))
        (let ((non-bg (filter (lambda (c) (not (= c bg))) colors)))
          (pm-probe-color-loop non-bg bg spec))))))

(define pm-probe-color-loop
  (lambda (colors bg spec)
    (if (= (length colors) 0) "none"
      (let ((color (head colors)))
        (if (pm-all? (lambda (p)
              (let ((ig (pm-get-input-grid p))
                    (og (pm-get-output-grid p)))
                (let ((extracted (try (pm-extract-by-color ig color bg) nil)))
                  (= extracted og))))
              spec)
          (concat "color-" color)
          (pm-probe-color-loop (tail colors) bg spec))))))

; Extract cells of a specific color from grid, trim to bounding box.
(define pm-extract-by-color
  (lambda (grid color bg)
    (let ((h (grid-height grid))
          (w (grid-width grid)))
      ; Build a mask: keep only `color` cells, rest = bg
      (let ((masked (map (lambda (r)
                      (map (lambda (c)
                        (if (= (grid-get grid r c) color) color bg))
                        (range w)))
                    (range h))))
        (grid-trim masked)))))

; Summarize the extraction shape for complex cases.
(define pm-extract-obj-info
  (lambda (spec)
    (let ((first-p (head spec)))
      (let ((ig (pm-get-input-grid first-p))
            (og (pm-get-output-grid first-p)))
        (let ((in-objs  (length (pm-safe-objects ig)))
              (out-objs (length (pm-safe-objects og)))
              (ih (try (length ig) 0))
              (iw (try (length (head ig)) 0))
              (oh (try (length og) 0))
              (ow (try (length (head og)) 0)))
          (concat "in=" in-objs "obj-" ih "x" iw
                  ">out=" out-objs "obj-" oh "x" ow))))))

; ── Constant discovery ────────────────────────────────────────────────
;
; Analyze a failing spec to discover implicit constants -- values that
; are consistent across all training examples but not present as inputs.
; These become extra-seeds for retry synthesis.

(define pm-discover-constants
  (lambda (spec)
    (let ((pairs spec))
      (let ((candidates (list)))
        ; Height ratio: output_h / input_h (if consistent integer)
        (let ((h-ratios (map (lambda (p)
                (let ((ig (pm-get-input-grid p))
                      (og (pm-get-output-grid p)))
                  (let ((ih (try (length ig) 0))
                        (oh (try (length og) 0)))
                    (if (and (> ih 0) (> oh 0) (= (modulo oh ih) 0))
                      (/ oh ih) -1))))
                pairs)))
          (let ((candidates
                  (if (and (pm-all-same? h-ratios) (> (head h-ratios) 1))
                    (append candidates (list (head h-ratios)))
                    candidates)))
            ; Width ratio: output_w / input_w
            (let ((w-ratios (map (lambda (p)
                    (let ((ig (pm-get-input-grid p))
                          (og (pm-get-output-grid p)))
                      (let ((iw (try (length (head ig)) 0))
                            (ow (try (length (head og)) 0)))
                        (if (and (> iw 0) (> ow 0) (= (modulo ow iw) 0))
                          (/ ow iw) -1))))
                    pairs)))
              (let ((candidates
                      (if (and (pm-all-same? w-ratios)
                               (> (head w-ratios) 1)
                               (not (pm-member? (head w-ratios) candidates)))
                        (append candidates (list (head w-ratios)))
                        candidates)))
                ; Small useful constants: 2, 3 (common ARC scale factors)
                (let ((candidates
                        (reduce (lambda (acc c)
                                  (if (pm-member? c acc) acc (append acc (list c))))
                                (list 2 3) candidates)))
                  candidates)))))))))

(define pm-all-same?
  (lambda (lst)
    (if (<= (length lst) 1) true
      (pm-all? (lambda (v) (= v (head lst))) (tail lst)))))

; ── Extra-seeds retry ────────────────────────────────────────────────
;
; Re-run synthesis with discovered constants as extra-seeds. Only
; attempts if there are constants to inject and held-out test data.

(define pm-retry-with-seeds
  (lambda (r constants)
    (let ((spec   (ns-get r "spec"))
          (budget (ns-get r "max-candidates"))
          (depth  (ns-get r "depth"))
          (arity  (try (ns-get r "arity") false))
          (test   (try (ns-get r "test") (list))))
      (let ((synth-ns
              (if (= (length test) 0)
                (ns ("spec" spec)
                    ("max-depth" (max depth 2))
                    ("max-candidates" budget)
                    ("extra-seeds" constants))
                (ns ("spec" spec)
                    ("max-depth" (max depth 2))
                    ("max-candidates" budget)
                    ("extra-seeds" constants)
                    ("test" test)))))
        (if arity
          (synthesize-args synth-ns)
          (synthesize synth-ns))))))

; ── Build diagnosis for one failure ──────────────────────────────────

(define pm-diagnose-one
  (lambda (r)
    (let ((name (ns-get r "name"))
          (spec (ns-get r "spec")))
      ; Use Rust builtin for fast grid classification
      (let ((diag (try (grid-diagnose-spec spec)
                    (ns ("size" "error") ("colors" "error") ("scale" "error")
                        ("constant-out" false) ("dims-consistent" false)
                        ("subtype" "error")))))
        (ns ("name"            name)
            ("size"            (ns-get diag "size"))
            ("colors"          (ns-get diag "colors"))
            ("constant-out"    (ns-get diag "constant-out"))
            ("dims-consistent" (ns-get diag "dims-consistent"))
            ("objects"         "n/a")
            ("scale"           (ns-get diag "scale"))
            ("probe-1"         "none")
            ("probe-2"         "skipped")
            ("constants"       (list))
            ("retry-found"     false)
            ("subtype"         (ns-get diag "subtype"))
            ("retry-source"    ""))))))

; ── Tally helper ─────────────────────────────────────────────────────

(define pm-tally
  (lambda (key diagnoses)
    (let ((vals (map (lambda (d) (ns-get d key)) diagnoses)))
      (reduce (lambda (acc v)
                (let ((cur (try (ns-get acc v) 0)))
                  (ns-put acc v (+ cur 1))))
              vals (ns)))))

; ── Prescription: diagnosis → actionable form recommendation ─────────
;
; Maps each failure's diagnosis signature to a concrete prescription:
; what M-chain form (existing or new) would cover this task pattern.
;
; Priority 1 = highest leverage (bug in existing coverage).
; Priority 2–4 = new forms by estimated impact.
; Priority 5–6 = hard / unclassified.

(define pm-prescribe
  (lambda (diag)
    (let ((size    (ns-get diag "size"))
          (colors  (ns-get diag "colors"))
          (scale   (ns-get diag "scale"))
          (p1      (ns-get diag "probe-1"))
          (p2      (ns-get diag "probe-2"))
          (const   (ns-get diag "constant-out"))
          (dims    (ns-get diag "dims-consistent"))
          (objs    (ns-get diag "objects"))
          (retry   (ns-get diag "retry-found"))
          (subtype (try (ns-get diag "subtype") "n/a")))

      ; If extra-seeds retry already solved it, no prescription needed.
      (if retry
        (ns ("rx" "recovered-by-retry")
            ("priority" 0)
            ("rationale" "extra-seeds retry solved this; no new form needed"))

      ; If a unary/depth-2 probe matched, the M-chain should have caught it.
      (if (not (= p1 "none"))
        (ns ("rx" "m-chain-coverage-gap")
            ("priority" 1)
            ("rationale" (concat "probe found " p1 " but M-chain missed it - check Form 2 pool")))

      (if (and (not (= p2 "none")) (not (= p2 "skipped")) (not (= p2 "error")))
        (ns ("rx" "m-chain-depth2-gap")
            ("priority" 1)
            ("rationale" (concat "depth-2 probe found " p2 " - check Form 2 L2 pool coverage")))

      ; Constant output -> Form 1 should have caught it.
      (if const
        (ns ("rx" "constant-output-gap")
            ("priority" 1)
            ("rationale" "constant output not caught by Form 1 - check grid? guard"))

      ; === Object-recomposition bucket: use subtype for finer classification ===
      (if (and (= size "same-size") (= colors "same-colors"))
        (pm-prescribe-recomp subtype)

      ; === Object-extraction bucket: use subtype for finer classification ===
      (if (= size "shrink")
        (pm-prescribe-extract subtype colors)

      ; Same-size + color-subset: masking / filtering
      (if (and (= size "same-size") (= colors "color-subset"))
        (ns ("rx" "color-filtering")
            ("priority" 3)
            ("rationale" "same dims + fewer colors -> color mask or object removal"))

      ; Same-size + new/superset colors: color introduction / overlay
      (if (and (= size "same-size")
               (or (= colors "color-superset") (= colors "new-colors")))
        (ns ("rx" "color-introduction")
            ("priority" 4)
            ("rationale" "same dims + new colors -> annotate/highlight/overlay pattern"))

      ; Grow + uniform scale: scaling / tiling
      (if (and (= size "grow") (not (= scale "no-uniform-scale")) (not (= scale "no-scale")))
        (ns ("rx" "scaling-or-tiling")
            ("priority" 3)
            ("rationale" (concat "output grows by " scale " -> grid-scale/grid-tile + transform")))

      ; Grow + non-uniform: composition (mirror, concat, border)
      (if (and (= size "grow") (or (= scale "no-uniform-scale") (= scale "no-scale")))
        (ns ("rx" "grid-composition")
            ("priority" 4)
            ("rationale" "output grows non-uniformly -> concat/border/pad/mirror variant"))

      ; Reshape (different aspect ratio): structural rearrangement
      (if (= size "mixed-size")
        (ns ("rx" "structural-rearrangement")
            ("priority" 5)
            ("rationale" "inconsistent size changes across examples -> conditional/branching transform"))

      ; Fallback: unclassified
      (ns ("rx" "unclassified")
          ("priority" 6)
          ("rationale" (concat "size=" size " colors=" colors " scale=" scale
                               " - needs manual inspection")))
      ))))))))))))))

; Sub-prescribe for the object-recomposition bucket based on subtype probes.
(define pm-prescribe-recomp
  (lambda (subtype)
    ; Check prefix patterns in the subtype string
    (if (try (string-starts-with subtype "per-object-transform:") false)
      (ns ("rx" (concat "recomp/per-object-" (string-drop subtype 21)))
          ("priority" 2)
          ("rationale" (concat "per-object transform detected: " (string-drop subtype 21)
                               " - auto-solvable via Form 9")))

    (if (try (string-starts-with subtype "object-select:") false)
      (ns ("rx" (concat "recomp/select-" (string-drop subtype 14)))
          ("priority" 1)
          ("rationale" (concat "object selection matched: " (string-drop subtype 14)
                               " - M-chain gap, should already solve")))

    (if (try (string-starts-with subtype "single-object-change:") false)
      (ns ("rx" "recomp/single-obj-edit")
          ("priority" 2)
          ("rationale" "exactly one object changes between input/output - targeted edit form"))

    (if (= subtype "object-count-change")
      (ns ("rx" "recomp/obj-count-change")
          ("priority" 3)
          ("rationale" "object count differs in/out - merge/split/create objects"))

    (if (try (string-starts-with subtype "few-objects-recomp:") false)
      (ns ("rx" "recomp/few-objects")
          ("priority" 3)
          ("rationale" (concat "conserved few objects (" subtype ") - spatial/relational transform")))

    (if (try (string-starts-with subtype "many-objects-recomp:") false)
      (ns ("rx" "recomp/many-objects")
          ("priority" 4)
          ("rationale" (concat "conserved many objects (" subtype ") - pattern/rule-based transform")))

    ; Fallback for error/no-objects/n/a
    (ns ("rx" "recomp/unclassified")
        ("priority" 4)
        ("rationale" (concat "object-recomp subtype=" subtype " - needs deeper probing")))
    ))))))))

; Sub-prescribe for the object-extraction bucket based on subtype probes.
(define pm-prescribe-extract
  (lambda (subtype colors)
    (if (try (string-starts-with subtype "direct:") false)
      (ns ("rx" (concat "extract/" (string-drop subtype 7)))
          ("priority" 1)
          ("rationale" (concat "direct extraction matched: " (string-drop subtype 7)
                               " - M-chain gap, should already solve")))

    (if (try (string-starts-with subtype "by-color:") false)
      (ns ("rx" (concat "extract/by-color"))
          ("priority" 2)
          ("rationale" (concat "color-based extraction: " (string-drop subtype 9)
                               " - add color-filter form")))

    ; Complex extraction
    (ns ("rx" "extract/complex")
        ("priority" 3)
        ("rationale" (concat "complex extraction (colors=" colors " sub=" subtype
                             ") - crop/select by property")))))))

; ── Aggregate prescriptions: tally + rank ────────────────────────────
;
; Takes a list of diagnoses (each with a "prescription" field) and
; returns a sorted list of (rx-name, count, priority, rationale),
; ordered by priority tier then count descending.

(define pm-aggregate-prescriptions
  (lambda (diagnoses)
    (let ((with-names
            (map (lambda (d)
              (list (ns-get (ns-get d "prescription") "rx")
                    (ns-get (ns-get d "prescription") "priority")
                    (ns-get (ns-get d "prescription") "rationale")
                    (ns-get d "name")))
              diagnoses)))
      ; Build tally: rx-name → ns with count, priority, rationale, examples
      (let ((tally
              (reduce
                (lambda (acc entry)
                  (let ((name (nth entry 0))
                        (pri  (nth entry 1))
                        (rat  (nth entry 2))
                        (task (nth entry 3)))
                    (let ((existing (try (ns-get acc name) nil)))
                      (if (nil? existing)
                        (ns-put acc name
                          (ns ("count" 1) ("priority" pri)
                              ("rationale" rat) ("examples" (list task))))
                        (ns-put acc name
                          (ns ("count" (+ (ns-get existing "count") 1))
                              ("priority" pri) ("rationale" rat)
                              ("examples"
                                (if (< (length (ns-get existing "examples")) 5)
                                  (append (ns-get existing "examples") (list task))
                                  (ns-get existing "examples")))))))))
                with-names
                (ns))))
        ; Convert to sorted list
        (let ((keys (ns-keys tally)))
          (let ((entries (map (lambda (k)
                    (let ((v (ns-get tally k)))
                      (ns ("rx" k)
                          ("count" (ns-get v "count"))
                          ("priority" (ns-get v "priority"))
                          ("rationale" (ns-get v "rationale"))
                          ("examples" (ns-get v "examples")))))
                  keys)))
            (pm-sort-by-priority entries)))))))

; Simple insertion sort for prescription ranking
(define pm-sort-by-priority
  (lambda (lst)
    (reduce
      (lambda (sorted item)
        (pm-insert-sorted sorted item))
      lst
      (list))))

(define pm-insert-sorted
  (lambda (sorted item)
    (if (= (length sorted) 0)
      (list item)
      (let ((a item) (b (head sorted)))
        (let ((pa (ns-get a "priority"))
              (pb (ns-get b "priority")))
          (if (< pa pb) (cons a sorted)
            (if (> pa pb) (cons b (pm-insert-sorted (tail sorted) a))
              ; Same priority: higher count first
              (if (> (ns-get a "count") (ns-get b "count"))
                (cons a sorted)
                (cons b (pm-insert-sorted (tail sorted) a))))))))))

; ── Auto-recovery: targeted re-synthesis from diagnosis ───────────────
;
; For each diagnosed failure, attempt recovery using diagnosis-specific
; strategies. Each strategy builds a targeted synthesis spec with:
;   - Discovered constants as extra-seeds
;   - Higher depth for composition chains
;   - Object-level decomposition for extraction tasks
;
; Returns the diagnosis with "auto-found" and "auto-source" fields added.

(define pm-auto-recover-one
  (lambda (r diag)
    (let ((rx (ns-get (ns-get diag "prescription") "rx"))
          (spec (ns-get r "spec"))
          (test (try (ns-get r "test") (list)))
          (subtype (try (ns-get diag "subtype") "n/a")))

      ; Dispatch to recovery strategy based on prescription.
      ; Only attempt cheap probes: extraction (grid-object/trim/compact/color)
      ; and scaling (direct grid-scale). Skip expensive object-recomposition
      ; probes (grid-objects + transform + place-back) for now.
      (let ((result
              (if (try (string-starts-with rx "extract/") false)
                (try (grid-probe-extract (ns-get r "spec")) (ns ("found" false)))
              (if (= rx "scaling-or-tiling")
                (try (grid-probe-scale (ns-get r "spec")
                       (try (ns-get diag "constants") (list 2 3)))
                     (ns ("found" false)))
                (ns ("found" false))))))

        (let ((found (try (ns-get result "found") false)))
          (ns-put (ns-put diag
            "auto-found" found)
            "auto-source" (if found
              (try (ns-get result "source") "")
              "")))))))

; -- Recovery: extraction tasks --
;
; Broader object selection: try grid-object with more indices,
; try grid-compact, try extracting unique non-bg color regions.

(define pm-recover-extract
  (lambda (r diag)
    (let ((spec (ns-get r "spec"))
          (test (try (ns-get r "test") (list))))

      ; Strategy 1: grid-compact (remove empty rows/cols)
      (if (pm-all? (lambda (p)
            (let ((ig (pm-get-input-grid p))
                  (og (pm-get-output-grid p)))
              (= (try (grid-compact ig) nil) og)))
            spec)
        (ns ("found" true)
            ("source" "grid-compact(x)")
            ("source-node"
              (make-lambda (list "x")
                (make-app "grid-compact" (make-app "nth" (make-symbol "x") (make-int 0))))))

      ; Strategy 2: try grid-object 0..5 with grid-trim wrapper
      (let ((obj-trim-result (pm-try-obj-trim-extract spec 0)))
        (if (not (nil? obj-trim-result))
          obj-trim-result

        ; Color extraction probe skipped (too slow in interpreted SELPH)
        (ns ("found" false))))))))

; Try grid-trim(grid-object(x, idx)) for idx 0..5
(define pm-try-obj-trim-extract
  (lambda (spec idx)
    (if (> idx 5) nil
      (if (pm-all? (lambda (p)
            (let ((ig (pm-get-input-grid p))
                  (og (pm-get-output-grid p)))
              (= (try (grid-trim (grid-object ig idx)) nil) og)))
            spec)
        (ns ("found" true)
            ("source" (concat "grid-trim(grid-object(x," idx "))"))
            ("source-node"
              (make-lambda (list "x")
                (make-app "grid-trim"
                  (make-app "grid-object"
                    (make-app "nth" (make-symbol "x") (make-int 0))
                    (make-int idx))))))
        (pm-try-obj-trim-extract spec (+ idx 1))))))

; Extract by the majority non-background color (trim result)
(define pm-recover-extract-by-majority-color
  (lambda (spec)
    (let ((first-in (pm-get-input-grid (head spec))))
      (let ((bg (grid-background first-in))
            (colors (pm-grid-colors first-in)))
        (let ((non-bg (filter (lambda (c) (not (= c bg))) colors)))
          (pm-try-majority-color-loop non-bg bg spec))))))

(define pm-try-majority-color-loop
  (lambda (colors bg spec)
    (if (= (length colors) 0) nil
      (let ((color (head colors)))
        (if (pm-all? (lambda (p)
              (let ((ig (pm-get-input-grid p))
                    (og (pm-get-output-grid p)))
                (let ((mask (pm-mask-to-color ig color bg)))
                  (= (try (grid-trim mask) nil) og))))
              spec)
          (ns ("found" true)
              ("source" (concat "trim(mask-to-color(x," color "))"))
              ("source-node"
                (make-lambda (list "x")
                  (make-app "grid-trim"
                    (make-app "grid-mask"
                      (make-app "nth" (make-symbol "x") (make-int 0))
                      (make-app "grid-blank"
                        (make-app "grid-height" (make-app "nth" (make-symbol "x") (make-int 0)))
                        (make-app "grid-width" (make-app "nth" (make-symbol "x") (make-int 0)))
                        (make-int bg))
                      (make-int color))))))
          (pm-try-majority-color-loop (tail colors) bg spec))))))

; Build a grid with only cells of `color`, rest = bg
(define pm-mask-to-color
  (lambda (grid color bg)
    (let ((h (grid-height grid))
          (w (grid-width grid)))
      (map (lambda (r)
        (map (lambda (c)
          (if (= (grid-get grid r c) color) color bg))
          (range w)))
        (range h)))))

; -- Recovery: single-object edit --
;
; Identify the changed object, try known transforms on just that object.

(define pm-recover-single-edit
  (lambda (r diag)
    (let ((spec (ns-get r "spec")))
      ; For each pair, find which object changed and what the change is
      (let ((first-p (head spec)))
        (let ((ig (pm-get-input-grid first-p))
              (og (pm-get-output-grid first-p)))
          (let ((in-objs (pm-safe-objects ig))
                (out-objs (pm-safe-objects og)))
            (if (not (= (length in-objs) (length out-objs)))
              (ns ("found" false))
              ; Find the changed object index
              (let ((changed-idx (pm-find-changed-obj in-objs out-objs 0)))
                (if (< changed-idx 0)
                  (ns ("found" false))
                  ; Try transforms on the changed object
                  (pm-try-single-obj-transforms spec changed-idx))))))))))

(define pm-find-changed-obj
  (lambda (in-objs out-objs idx)
    (if (>= idx (length in-objs)) -1
      (if (not (= (nth in-objs idx) (nth out-objs idx)))
        idx
        (pm-find-changed-obj in-objs out-objs (+ idx 1))))))

(define pm-single-obj-transforms
  (list
    (list "rotate-cw"   grid-rotate-cw)
    (list "rotate-ccw"  grid-rotate-ccw)
    (list "rotate-180"  grid-rotate-180)
    (list "flip-h"      grid-flip-h)
    (list "flip-v"      grid-flip-v)
    (list "fill-enclosed" grid-fill-enclosed)))

(define pm-try-single-obj-transforms
  (lambda (spec changed-idx)
    (pm-try-sot-loop pm-single-obj-transforms spec changed-idx)))

(define pm-try-sot-loop
  (lambda (ops spec changed-idx)
    (if (= (length ops) 0) (ns ("found" false))
      (let ((entry (head ops)))
        (let ((name (head entry))
              (op   (head (tail entry))))
          (if (try (pm-sot-matches-all? op spec changed-idx) false)
            (ns ("found" true)
                ("source" (concat "single-obj-edit:" name "@" changed-idx)))
            (pm-try-sot-loop (tail ops) spec changed-idx)))))))

; Check if applying op to object at changed-idx and placing back gives output
(define pm-sot-matches-all?
  (lambda (op spec changed-idx)
    (pm-all? (lambda (p)
      (let ((ig (pm-get-input-grid p))
            (og (pm-get-output-grid p)))
        (let ((objs (pm-safe-objects ig))
              (bg (grid-background ig)))
          (if (<= (length objs) changed-idx) false
            (let ((obj (nth objs changed-idx))
                  (transformed (try (op (nth objs changed-idx)) nil)))
              (if (nil? transformed) false
                (let ((pos (try (pm-find-object-pos ig obj bg) nil)))
                  (if (nil? pos) false
                    (let ((result (try (grid-place
                            (grid-blank (grid-height ig) (grid-width ig) bg)
                            ig 0 0) nil)))
                      ; Rebuild: place all objects, but replace changed one
                      (let ((rebuilt (try (pm-rebuild-with-edit ig objs op changed-idx bg) nil)))
                        (if (nil? rebuilt) false
                          (= rebuilt og))))))))))))
      spec)))

; Rebuild grid with one object transformed
(define pm-rebuild-with-edit
  (lambda (grid objs op changed-idx bg)
    (let ((h (grid-height grid))
          (w (grid-width grid)))
      (let ((base (grid-blank h w bg)))
        (reduce
          (lambda (acc i)
            (let ((obj (nth objs i))
                  (actual (if (= i changed-idx) (op (nth objs i)) (nth objs i))))
              (let ((pos (try (pm-find-object-pos grid obj bg) nil)))
                (if (nil? pos) acc
                  (try (grid-place acc actual (nth pos 0) (nth pos 1)) acc)))))
          (range (length objs))
          base)))))

; -- Recovery: few-objects recomposition --
;
; Try spatial relationship probes: sort objects by position, try
; known arrangements (top-to-bottom, left-to-right).

(define pm-recover-few-objects
  (lambda (r diag)
    ; TODO: spatial relationship probes (sort by position, try arrangements)
    (ns ("found" false))))

; -- Recovery: scaling/tiling --
;
; Inject scale factor as extra-seed and retry.

(define pm-recover-scaling
  (lambda (r diag)
    ; Try direct grid-scale(x, N) for N in discovered constants
    (let ((spec (ns-get r "spec"))
          (constants (try (ns-get diag "constants") (list))))
      (pm-try-direct-scale spec constants))))

(define pm-try-direct-scale
  (lambda (spec constants)
    (if (= (length constants) 0) (ns ("found" false))
      (let ((n (head constants)))
        (if (pm-all? (lambda (p)
              (let ((ig (pm-get-input-grid p))
                    (og (pm-get-output-grid p)))
                (= (try (grid-scale ig n) nil) og)))
              spec)
          (ns ("found" true)
              ("source" (concat "grid-scale(x," n ")"))
              ("source-node"
                (make-lambda (list "x")
                  (make-app "grid-scale"
                    (make-app "nth" (make-symbol "x") (make-int 0))
                    (make-int n)))))
          (pm-try-direct-scale spec (tail constants)))))))

; -- Shared: targeted re-synthesis --

(define pm-targeted-resynth
  (lambda (r seeds depth budget)
    (let ((spec   (ns-get r "spec"))
          (test   (try (ns-get r "test") (list)))
          (arity  (try (ns-get r "arity") false)))
      (let ((synth-ns
              (if (= (length test) 0)
                (ns ("spec" spec) ("max-depth" depth)
                    ("max-candidates" budget)
                    ("extra-seeds" seeds))
                (ns ("spec" spec) ("max-depth" depth)
                    ("max-candidates" budget)
                    ("extra-seeds" seeds) ("test" test)))))
        (if arity
          (synthesize-args synth-ns)
          (synthesize synth-ns))))))

; Derive useful seeds from input/output dimensions
(define pm-derive-dim-seeds
  (lambda (spec)
    (let ((first-p (head spec)))
      (let ((ig (pm-get-input-grid first-p))
            (og (pm-get-output-grid first-p)))
        (let ((ih (try (length ig) 0))
              (iw (try (length (head ig)) 0))
              (oh (try (length og) 0))
              (ow (try (length (head og)) 0))
              (in-obj-count (try (pm-object-count ig) 0))
              (out-obj-count (try (pm-object-count og) 0))
              (bg (try (grid-background ig) 0)))
          ; Collect potentially useful constants
          (let ((candidates (list)))
            (let ((candidates (if (and (> ih 0) (> oh 0) (= (modulo ih oh) 0) (> (/ ih oh) 1))
                    (append candidates (list (/ ih oh)))
                    candidates)))
              (let ((candidates (if (and (> in-obj-count 0) (not (pm-member? in-obj-count candidates)))
                      (append candidates (list in-obj-count))
                      candidates)))
                (let ((candidates (if (and (> bg 0) (not (pm-member? bg candidates)))
                        (append candidates (list bg))
                        candidates)))
                  ; Always include 2, 3 as common ARC constants
                  (reduce (lambda (acc c)
                    (if (pm-member? c acc) acc (append acc (list c))))
                    (list 2 3) candidates))))))))))

; ── Prescription-guided M-chain form generation ───────────────────────
;
; For high-count prescription buckets with no existing M-chain form
; coverage, dynamically generate decomposer functions and register
; them in __decomposers__. These run BEFORE scaffolding, extending
; the recognition chain itself rather than working around gaps.
;
; Generated forms probe task-specific patterns:
;   recomp/obj-count-change -> color-keep/remove probing
;   color-filtering         -> color-keep probing
;   recomp/single-obj-edit  -> per-object unary transform probing

; Collect all unique non-background colors from a grid.
(define pm-grid-colors
  (lambda (grid)
    (let ((bg (try (grid-background grid) 0)))
      (reduce
        (lambda (acc row)
          (reduce
            (lambda (acc2 cell)
              (if (or (= cell bg) (pm-member? cell acc2))
                acc2
                (append acc2 (list cell))))
            row acc))
        grid (list)))))

; Collect colors appearing across all training input grids for a task.
(define pm-task-colors
  (lambda (spec)
    (let ((pairs (try (ns-get spec "spec") spec)))
      (reduce
        (lambda (acc pair)
          (let ((inp (head pair)))
            (let ((grid (if (list? (head inp)) inp (head inp))))
              (let ((colors (try (pm-grid-colors grid) (list))))
                (reduce (lambda (a c) (if (pm-member? c a) a (append a (list c))))
                  colors acc)))))
        (if (list? pairs) pairs (list))
        (list)))))

; Try replacing each input color with background and check if it matches
; the output. Returns a match ns or nil.
(define pm-try-color-keep
  (lambda (grid output bg color)
    (let ((h (length grid))
          (w (if (> h 0) (length (head grid)) 0)))
      (if (or (= h 0) (not (= (length output) h)))
        nil
        (let ((kept (map
                (lambda (r)
                  (map (lambda (c)
                    (if (= (nth (nth grid r) c) color)
                      (nth (nth grid r) c)
                      bg))
                    (range w)))
                (range h))))
          (if (= kept output) (list "keep" color)
            ; Try remove: zero out one color
            (let ((removed (map
                    (lambda (r)
                      (map (lambda (c)
                        (if (= (nth (nth grid r) c) color)
                          bg
                          (nth (nth grid r) c)))
                        (range w)))
                    (range h))))
              (if (= removed output) (list "remove" color)
                nil))))))))

; Probe a single task spec for color-based transforms.
; Returns (ns ("found" true) ("source-node" ...) ("kind" ...)) or nil.
(define pm-probe-color-form
  (lambda (spec)
    (let ((pairs (ns-get spec "spec"))
          (test-pairs (try (ns-get spec "test") (list))))
      (if (< (length pairs) 2) nil
        (let ((first-inp (head (head (head pairs))))
              (first-out (head (tail (head pairs)))))
          (let ((grid (if (and (list? first-inp) (list? (head first-inp)))
                       first-inp
                       (if (and (list? first-inp) (= (length first-inp) 1)
                                (list? (head first-inp)) (list? (head (head first-inp))))
                         (head first-inp) nil))))
            (if (nil? grid) nil
              (let ((bg (try (grid-background grid) 0))
                    (colors (pm-grid-colors grid)))
                (pm-probe-color-form-loop pairs test-pairs colors bg)))))))))

; Loop over candidate colors, checking if keep/remove matches all pairs.
(define pm-probe-color-form-loop
  (lambda (pairs test-pairs colors bg)
    (if (= (length colors) 0) nil
      (let ((color (head colors)))
        (let ((match (pm-check-color-all-pairs pairs color bg)))
          (if (nil? match)
            (pm-probe-color-form-loop pairs test-pairs (tail colors) bg)
            (let ((op (head match))
                  (c (head (tail match))))
              ; Verify against test pairs if present
              (let ((test-ok (if (= (length test-pairs) 0) true
                    (not (nil? (pm-check-color-all-pairs test-pairs c bg))))))
                (if (not test-ok)
                  (pm-probe-color-form-loop pairs test-pairs (tail colors) bg)
                  ; Build AST: (lambda (x) (grid-replace-color (nth x 0) c bg))
                  ;         or (lambda (x) -- keep only color c)
                  (if (= op "remove")
                    (ns ("found" true)
                        ("kind" (concat "rx-form-color-remove-" (to-string c)))
                        ("source-node"
                          (make-lambda (list "x")
                            (make-app "grid-replace-color"
                              (make-app "nth" (make-symbol "x") (make-int 0))
                              (make-int c) (make-int bg)))))
                    ; "keep" = replace every non-c, non-bg color with bg
                    nil))))))))))

; Check a color keep/remove against all pairs in a list.
(define pm-check-color-all-pairs
  (lambda (pairs color bg)
    (let ((first-result
            (let ((inp (head (head (head pairs))))
                  (out (head (tail (head pairs)))))
              (let ((grid (if (and (list? inp) (list? (head inp)))
                           inp
                           (if (and (list? inp) (= (length inp) 1))
                             (head inp) nil))))
                (if (nil? grid) nil
                  (pm-try-color-keep grid out bg color))))))
      (if (nil? first-result) nil
        (let ((op (head first-result)))
          (if (reduce
                (lambda (ok pair)
                  (if (not ok) false
                    (let ((inp (head (head pair)))
                          (out (head (tail pair))))
                      (let ((grid (if (and (list? inp) (list? (head inp)))
                                   inp
                                   (if (and (list? inp) (= (length inp) 1))
                                     (head inp) nil))))
                        (if (nil? grid) false
                          (not (nil? (pm-try-color-keep grid out bg color))))))))
                (tail pairs) true)
            first-result
            nil))))))

; Generate and register decomposers for high-count prescription buckets.
; Called after prescriptions are aggregated, before the scaffolding loop.
(define pm-generate-rx-forms
  (lambda (prescriptions fails)
    (let ((high-count-rx (filter
            (lambda (rx)
              (let ((name (ns-get rx "rx"))
                    (count (ns-get rx "count")))
                (and (>= count 5)
                  (or (try (string-starts-with name "recomp/obj-count") false)
                      (= name "color-filtering")
                      (try (string-starts-with name "recomp/single-obj") false)))))
            prescriptions)))
      (if (= (length high-count-rx) 0) 0
        ; Register a color-probe decomposer that checks each task for
        ; simple color removal patterns (covers a subset of obj-count-change
        ; and color-filtering tasks).
        (do (print (concat "  Registering rx-guided color-probe decomposer for "
                           (to-string (length high-count-rx)) " buckets"))
            (try
              (eval-source
                (concat "(define __decomposers__ "
                  "(ns-put __decomposers__ \"rx-color-probe\" pm-rx-color-decomposer))"))
              nil)
            (length high-count-rx))))))

; The dynamically-registered decomposer. Probes the synth spec for
; simple color-based transforms (remove a single color, keep a single
; color). These cover many recomp/obj-count-change and color-filtering
; tasks where the output is the input with one color zeroed out.
(define pm-rx-color-decomposer
  (lambda (synth-spec)
    (let ((result (try (pm-probe-color-form synth-spec) nil)))
      (if (or (nil? result) (not (try (ns-get result "found") false)))
        (ns ("found" false))
        (ns ("found" true)
            ("nodes" (ns-get result "source-node"))
            ("candidates" 1))))))

; ── Scaffolding generator: prescription -> synthetic tasks ────────────
;
; For each prescription bucket, generate trivially-solvable tasks whose
; solutions become library functions. M7 then composes these against the
; hard tasks. This closes the meta-learning loop:
;   diagnose → prescribe → scaffold → solve → library-enrich → re-attempt
;
; Each scaffold is a list: (name spec) or (name spec depth) where
; spec = ((input output) ...) and depth defaults to 2 if omitted.
; Depth-3 scaffolds use budget 100000; depth-2 use 50000.
; We use small grids (3x3, 4x4) so synthesis is fast.

(define pm-sample-grids
  (list
    (list (list 1 2 3) (list 4 5 6) (list 7 8 9))
    (list (list 0 1 0) (list 1 0 1) (list 0 1 0))
    (list (list 3 3 0 0) (list 3 0 0 0) (list 0 0 0 2) (list 0 0 2 2))))

; ── Inverse scaffolds (§9.53 Phase 1) ──────────────────────────────
;
; For forward scaffolds like tiling/scaling/mirror/concat, produce
; an inverse scaffold that swaps each example's input and output.
; This teaches the synthesizer to learn the reverse operation
; (e.g., grid-untile from grid-tile scaffolds).

(define pm-scaffold-invertible?
  (lambda (scaffold)
    (let ((name (nth scaffold 0)))
      ; YES: tiling, scaling, concat, mirror
      (or (try (string-starts-with name "scaffold_tile_") false)
      (or (try (string-starts-with name "scaffold_scale") false)
      (or (try (string-starts-with name "scaffold_mirror") false)
      (or (try (string-starts-with name "scaffold_hconcat") false)
      (or (try (string-starts-with name "scaffold_vconcat") false)
          false))))))))
      ; NO: extraction (ill-posed inverse), color-swap (self-inverse)

(define pm-scaffold-inverse-pair
  (lambda (scaffold)
    (let ((name (nth scaffold 0))
          (spec (nth scaffold 1))
          (depth (if (>= (length scaffold) 3) (nth scaffold 2) 2)))
      (let ((inv-name (concat "inv_" name))
            (inv-spec (map (lambda (pair)
                        (let ((inp (head pair))
                              (out (head (tail pair))))
                          ; inp is (grid) for arity-1; unwrap to get bare grid as output
                          (list (list out) (head inp))))
                      spec))
            (inv-depth (if (>= depth 2) 3 depth)))
        (list inv-name inv-spec inv-depth)))))

(define pm-generate-inverse-scaffolds
  (lambda (forward)
    (map pm-scaffold-inverse-pair
      (filter pm-scaffold-invertible? forward))))

; ── Task-data scaffolds: use the failing task's own grids ────────────
;
; Instead of pm-sample-grids (hardcoded 3x3/4x4), extract input grids
; from the task's training spec and apply operations to them. This
; produces scaffolds whose library functions are pre-adapted to the
; task's actual grid shapes and color palettes.

; Size guard: only use grids ≤10x10 (large grids make synthesis slow).
(define pm-grid-small-enough?
  (lambda (g)
    (let ((h (try (length g) 99))
          (w (try (length (head g)) 99)))
      (and (<= h 10) (<= w 10)))))

; Extract input grids from a task result's spec, filtered by size.
(define pm-task-input-grids
  (lambda (task-result)
    (let ((spec (ns-get task-result "spec")))
      (let ((grids (map pm-get-input-grid spec)))
        (filter pm-grid-small-enough? grids)))))

; Build one scaffold from a task's grids + an operation.
; Returns (name spec depth) triple or nil if the op fails on any grid.
; Needs at least 2 grids to form a valid spec.
(define pm-scaffold-from-task-data
  (lambda (task-name op-name op grids)
    (if (< (length grids) 2) nil
      (let ((pairs (try
              (map (lambda (g)
                (list (list g) (op g)))
                grids)
              nil)))
        (if (nil? pairs) nil
          (list (concat "td_" op-name "_" task-name)
                pairs
                2))))))

; Operation families for task-data scaffolds, organized by rx bucket.
; Each entry: (op-name op-function)

(define pm-td-ops-scaling
  (list
    (list "scale_2"    (lambda (g) (grid-scale g 2)))
    (list "scale_3"    (lambda (g) (grid-scale g 3)))
    (list "tile_2x2"   (lambda (g) (grid-tile g 2 2)))
    (list "tile_1x3"   (lambda (g) (grid-tile g 3 1)))
    (list "tile_3x1"   (lambda (g) (grid-tile g 1 3)))
    (list "flip_h"     grid-flip-h)
    (list "flip_v"     grid-flip-v)
    (list "mirror_h"   (lambda (g) (grid-hconcat g (grid-flip-h g))))
    (list "mirror_v"   (lambda (g) (grid-vconcat g (grid-flip-v g))))))

(define pm-td-ops-extraction
  (list
    (list "trim"       grid-trim)
    (list "compact"    grid-compact)
    (list "object_0"   (lambda (g) (grid-object g 0)))
    (list "object_1"   (lambda (g) (grid-object g 1)))
    (list "trim_obj0"  (lambda (g) (grid-trim (grid-object g 0))))))

(define pm-td-ops-recomp
  (list
    (list "fill_enc"   grid-fill-enclosed)
    (list "grav_down"  grid-gravity-down)
    (list "grav_up"    grid-gravity-up)
    (list "rotate_cw"  grid-rotate-cw)
    (list "rotate_ccw" grid-rotate-ccw)
    (list "rotate_180" grid-rotate-180)
    (list "flip_h"     grid-flip-h)
    (list "flip_v"     grid-flip-v)))

(define pm-td-ops-color-filter
  (list
    (list "rotate_cw"  grid-rotate-cw)
    (list "flip_h"     grid-flip-h)
    (list "flip_v"     grid-flip-v)
    (list "transpose"  grid-transpose)))

(define pm-td-ops-composition
  (list
    (list "hconcat_self" (lambda (g) (grid-hconcat g g)))
    (list "vconcat_self" (lambda (g) (grid-vconcat g g)))
    (list "hconcat_rot"  (lambda (g) (grid-hconcat g (grid-rotate-cw g))))
    (list "mirror_h"     (lambda (g) (grid-hconcat g (grid-flip-h g))))
    (list "mirror_v"     (lambda (g) (grid-vconcat g (grid-flip-v g))))))

; Select which op family to use for a given rx bucket.
(define pm-td-ops-for-rx
  (lambda (rx-name)
    (if (= rx-name "scaling-or-tiling")       pm-td-ops-scaling
    (if (= rx-name "extract/complex")         pm-td-ops-extraction
    (if (or (= rx-name "recomp/obj-count-change")
            (or (= rx-name "recomp/few-objects")
                (= rx-name "recomp/single-obj-edit")))
      pm-td-ops-recomp
    (if (= rx-name "color-filtering")         pm-td-ops-color-filter
    (if (= rx-name "grid-composition")        pm-td-ops-composition
      (list))))))))

; Generate task-data scaffolds for one prescription bucket.
; rx-entry = prescription ns, fails = list of all failing task results.
(define pm-task-data-scaffolds-for-rx
  (lambda (rx-entry fails)
    (let ((rx-name  (ns-get rx-entry "rx"))
          (examples (ns-get rx-entry "examples")))
      (let ((ops (pm-td-ops-for-rx rx-name)))
        (if (= (length ops) 0) (list)
          ; For each failing task in this bucket, extract its grids and
          ; apply each operation. Collect non-nil scaffolds.
          (let ((all-scaffolds
                  (reduce append
                    (map (lambda (task-name)
                      ; Find the task result for this name
                      (let ((task-results (filter
                              (lambda (r) (= (ns-get r "name") task-name))
                              fails)))
                        (if (= (length task-results) 0) (list)
                          (let ((grids (pm-task-input-grids (head task-results))))
                            (if (< (length grids) 2) (list)
                              ; Try each op, collect non-nil scaffolds
                              (reduce append
                                (map (lambda (op-entry)
                                  (let ((op-name (head op-entry))
                                        (op-fn   (head (tail op-entry))))
                                    (let ((scaffold (try
                                            (pm-scaffold-from-task-data
                                              task-name op-name op-fn grids)
                                            nil)))
                                      (if (nil? scaffold) (list) (list scaffold)))))
                                  ops)
                                (list)))))))
                      examples)
                    (list))))
            ; Deduplicate: skip scaffolds whose spec matches an earlier one
            (pm-dedup-scaffolds all-scaffolds)))))))

; Deduplicate scaffolds by spec (element index 1). Keep first occurrence.
(define pm-dedup-scaffolds
  (lambda (scaffolds)
    (let ((result
            (reduce
              (lambda (acc scaffold)
                (let ((seen-specs (head acc))
                      (kept       (head (tail acc)))
                      (spec       (nth scaffold 1)))
                  (if (pm-member? spec seen-specs)
                    acc
                    (list (append seen-specs (list spec))
                          (append kept (list scaffold))))))
              scaffolds
              (list (list) (list)))))
      (head (tail result)))))

(define pm-generate-scaffolding
  (lambda (prescriptions fails)
    (let ((forward (reduce append
            (map pm-scaffold-for-rx prescriptions)
            (list))))
      (let ((inverses (pm-generate-inverse-scaffolds forward))
            (task-data (reduce append
              (map (lambda (rx-entry)
                (pm-task-data-scaffolds-for-rx rx-entry fails))
                prescriptions)
              (list))))
        (append (append forward inverses) task-data)))))

(define pm-scaffold-for-rx
  (lambda (rx-entry)
    (let ((rx-name (ns-get rx-entry "rx"))
          (count   (ns-get rx-entry "count")))
      ; Only generate scaffolding for buckets with enough tasks to matter
      (if (< count 2) (list)
        (if (= rx-name "scaling-or-tiling")
          (append (pm-scaffold-scaling) (pm-scaffold-tile-mirror))
        (if (= rx-name "extract/complex")
          (append (pm-scaffold-extraction)
            (append (pm-scaffold-extract-by-position)
                    (pm-scaffold-depth3-compositions)))
        (if (or (= rx-name "recomp/obj-count-change")
                (= rx-name "recomp/few-objects")
                (= rx-name "recomp/single-obj-edit"))
          (append (pm-scaffold-recomp)
            (append (pm-scaffold-object-compositions)
                    (pm-scaffold-depth3-compositions)))
        (if (= rx-name "color-filtering")
          (append (pm-scaffold-color-filter) (pm-scaffold-color-swap-extract))
        (if (= rx-name "grid-composition")
          (pm-scaffold-grid-compose)
          (list))))))))))

; ── Scaling scaffolds: grid-tile with various patterns ───────────────

(define pm-scaffold-scaling
  (lambda ()
    (let ((g1 (nth pm-sample-grids 0))
          (g2 (nth pm-sample-grids 1)))
      (list
        ; tile 2x2
        (list "scaffold_tile_2x2"
          (list (list (list g1) (grid-tile g1 2 2))
                (list (list g2) (grid-tile g2 2 2)))
          2)
        ; tile 3x1 (horizontal)
        (list "scaffold_tile_3x1"
          (list (list (list g1) (grid-tile g1 1 3))
                (list (list g2) (grid-tile g2 1 3)))
          2)
        ; tile 1x3 (vertical)
        (list "scaffold_tile_1x3"
          (list (list (list g1) (grid-tile g1 3 1))
                (list (list g2) (grid-tile g2 3 1)))
          2)
        ; scale 2x
        (list "scaffold_scale_2"
          (list (list (list g1) (grid-scale g1 2))
                (list (list g2) (grid-scale g2 2)))
          2)
        ; scale 3x
        (list "scaffold_scale_3"
          (list (list (list g1) (grid-scale g1 3))
                (list (list g2) (grid-scale g2 3)))
          2)))))

; ── Extraction scaffolds: grid-object, grid-trim, grid-compact ───────

(define pm-scaffold-extraction
  (lambda ()
    (let ((g1 (nth pm-sample-grids 0))
          (g2 (nth pm-sample-grids 1))
          (g3 (nth pm-sample-grids 2)))
      (list
        ; grid-trim
        (list "scaffold_trim"
          (list (list (list (list (list 0 0 0 0) (list 0 1 2 0) (list 0 3 4 0) (list 0 0 0 0)))
                      (list (list 1 2) (list 3 4)))
                (list (list (list (list 0 0 0 0 0) (list 0 0 5 0 0) (list 0 5 5 5 0) (list 0 0 5 0 0) (list 0 0 0 0 0)))
                      (list (list 0 5 0) (list 5 5 5) (list 0 5 0))))
          2)
        ; grid-compact
        (list "scaffold_compact"
          (list (list (list (list (list 1 0 2) (list 0 0 0) (list 3 0 4)))
                      (list (list 1 2) (list 3 4)))
                (list (list (list (list 5 0 6 0) (list 0 0 0 0) (list 7 0 8 0) (list 0 0 0 0)))
                      (list (list 5 6) (list 7 8))))
          2)
        ; grid-object (largest)
        (list "scaffold_object_0"
          (let ((big (list (list 0 1 1 0 0) (list 0 1 1 0 0) (list 0 0 0 2 0) (list 0 0 0 0 0)))
                (big2 (list (list 0 0 3 3 3) (list 0 0 3 3 3) (list 0 0 3 3 3) (list 4 0 0 0 0))))
            (list (list (list big) (grid-object big 0))
                  (list (list big2) (grid-object big2 0))))
          2)))))

; ── Recomposition scaffolds: object-level transforms ─────────────────

(define pm-scaffold-recomp
  (lambda ()
    (let ((g1 (list (list 0 1 0 0 2 0) (list 0 1 0 0 2 0) (list 0 0 0 0 0 0)
                    (list 0 0 3 0 0 0) (list 0 3 3 0 0 0) (list 0 0 0 0 0 0)))
          (g2 (list (list 0 0 4 0 0 0) (list 0 4 4 0 0 0) (list 0 0 0 0 0 0)
                    (list 0 0 0 5 5 0) (list 0 0 0 0 5 0) (list 0 0 0 0 0 0))))
      (list
        ; fill-enclosed on the whole grid
        (list "scaffold_fill_enclosed"
          (list (list (list (list (list 1 1 1) (list 1 0 1) (list 1 1 1)))
                      (grid-fill-enclosed (list (list 1 1 1) (list 1 0 1) (list 1 1 1))))
                (list (list (list (list 2 2 2 2) (list 2 0 0 2) (list 2 0 0 2) (list 2 2 2 2)))
                      (grid-fill-enclosed (list (list 2 2 2 2) (list 2 0 0 2) (list 2 0 0 2) (list 2 2 2 2)))))
          2)
        ; gravity-down
        (list "scaffold_gravity_down"
          (list (list (list (list (list 0 1 0) (list 0 0 0) (list 0 0 0)))
                      (list (list 0 0 0) (list 0 0 0) (list 0 1 0)))
                (list (list (list (list 2 0 3) (list 0 0 0) (list 0 0 0)))
                      (list (list 0 0 0) (list 0 0 0) (list 2 0 3))))
          2)))))

; ── Color filter scaffolds ───────────────────────────────────────────

(define pm-scaffold-color-filter
  (lambda ()
    (list
      ; replace-color (remove a color by setting to bg)
      (list "scaffold_remove_color"
        (list (list (list (list (list 1 2 1) (list 2 1 2) (list 1 2 1)))
                    (list (list 1 0 1) (list 0 1 0) (list 1 0 1)))
              (list (list (list (list 3 4 3) (list 4 3 4) (list 3 4 3)))
                    (list (list 3 0 3) (list 0 3 0) (list 3 0 3))))
        2))))

; ── Composition scaffolds: 2-op combinations ─────────────────────────

; Tile-with-mirror: checkerboard tiling (common ARC pattern ~5% of grow tasks)
(define pm-scaffold-tile-mirror
  (lambda ()
    (let ((g1 (list (list 1 2) (list 3 4)))
          (g2 (list (list 5 6) (list 7 8))))
      (list
        ; hconcat with flip-h: (x | flip-h(x))
        (list "scaffold_mirror_h"
          (list (list (list g1) (grid-hconcat g1 (grid-flip-h g1)))
                (list (list g2) (grid-hconcat g2 (grid-flip-h g2))))
          2)
        ; vconcat with flip-v: (x / flip-v(x))
        (list "scaffold_mirror_v"
          (list (list (list g1) (grid-vconcat g1 (grid-flip-v g1)))
                (list (list g2) (grid-vconcat g2 (grid-flip-v g2))))
          2)
        ; tile 2x2 then flip-h alternate cols (checkerboard)
        (list "scaffold_tile_flip_h"
          (let ((t1 (grid-hconcat g1 (grid-flip-h g1)))
                (t2 (grid-hconcat g2 (grid-flip-h g2))))
            (list (list (list g1) (grid-vconcat t1 (grid-flip-v t1)))
                  (list (list g2) (grid-vconcat t2 (grid-flip-v t2)))))
          2)
        ; scale 2 then flip-h
        (list "scaffold_scale2_flip_h"
          (list (list (list g1) (grid-flip-h (grid-scale g1 2)))
                (list (list g2) (grid-flip-h (grid-scale g2 2))))
          2)))))

; Object + transform compositions
(define pm-scaffold-object-compositions
  (lambda ()
    (let ((g1 (list (list 0 1 0 0 2 0) (list 0 1 0 0 2 0) (list 0 0 0 0 0 0)
                    (list 0 0 3 0 0 0) (list 0 3 3 0 0 0) (list 0 0 0 0 0 0)))
          (g2 (list (list 0 0 4 0 0 0) (list 0 4 4 0 0 0) (list 0 0 0 0 0 0)
                    (list 0 0 0 5 5 0) (list 0 0 0 0 5 0) (list 0 0 0 0 0 0))))
      (list
        ; extract largest object then rotate
        (list "scaffold_obj0_rotate_cw"
          (list (list (list g1) (grid-rotate-cw (grid-object g1 0)))
                (list (list g2) (grid-rotate-cw (grid-object g2 0))))
          2)
        ; extract largest then flip-h
        (list "scaffold_obj0_flip_h"
          (list (list (list g1) (grid-flip-h (grid-object g1 0)))
                (list (list g2) (grid-flip-h (grid-object g2 0))))
          2)
        ; extract then scale
        (list "scaffold_obj0_scale2"
          (list (list (list g1) (grid-scale (grid-object g1 0) 2))
                (list (list g2) (grid-scale (grid-object g2 0) 2)))
          2)))))

; Extract by object position (2nd largest, smallest)
(define pm-scaffold-extract-by-position
  (lambda ()
    (let ((g1 (list (list 0 1 1 0 0) (list 0 1 1 0 0) (list 0 0 0 2 0) (list 0 0 0 0 0)))
          (g2 (list (list 0 0 3 3 3) (list 0 0 3 3 3) (list 0 0 3 3 3) (list 4 0 0 0 0))))
      (list
        ; 2nd largest object
        (list "scaffold_object_1"
          (list (list (list g1) (grid-object g1 1))
                (list (list g2) (grid-object g2 1)))
          2)
        ; trim then compact
        (list "scaffold_trim_compact"
          (let ((padded1 (list (list 0 0 0 0 0) (list 0 1 0 2 0) (list 0 0 0 0 0) (list 0 3 0 0 0) (list 0 0 0 0 0)))
                (padded2 (list (list 0 0 0 0 0) (list 0 5 0 0 0) (list 0 0 0 6 0) (list 0 0 0 0 0))))
            (list (list (list padded1) (grid-compact padded1))
                  (list (list padded2) (grid-compact padded2))))
          2)))))

; Color-swap + extraction
(define pm-scaffold-color-swap-extract
  (lambda ()
    (list
      ; replace one color with another
      (list "scaffold_replace_color_1_to_2"
        (list (list (list (list (list 1 0 1) (list 0 1 0) (list 1 0 1)))
                    (list (list 2 0 2) (list 0 2 0) (list 2 0 2)))
              (list (list (list (list 1 0 0 1) (list 0 0 0 0) (list 1 0 0 1)))
                    (list (list 2 0 0 2) (list 0 0 0 0) (list 2 0 0 2))))
        2)
      ; keep only background (invert: remove all non-bg)
      (list "scaffold_keep_bg_only"
        (list (list (list (list (list 0 1 0) (list 1 0 1) (list 0 1 0)))
                    (list (list 0 0 0) (list 0 0 0) (list 0 0 0)))
              (list (list (list (list 0 2 3) (list 4 0 5) (list 6 7 0)))
                    (list (list 0 0 0) (list 0 0 0) (list 0 0 0))))
        2))))

; Grid composition: hconcat, vconcat of input with itself
(define pm-scaffold-grid-compose
  (lambda ()
    (let ((g1 (list (list 1 2) (list 3 4)))
          (g2 (list (list 5 6) (list 7 8))))
      (list
        (list "scaffold_hconcat_self"
          (list (list (list g1) (grid-hconcat g1 g1))
                (list (list g2) (grid-hconcat g2 g2)))
          2)
        (list "scaffold_vconcat_self"
          (list (list (list g1) (grid-vconcat g1 g1))
                (list (list g2) (grid-vconcat g2 g2)))
          2)
        ; hconcat with rotate-cw
        (list "scaffold_hconcat_rotate"
          (list (list (list g1) (grid-hconcat g1 (grid-rotate-cw g1)))
                (list (list g2) (grid-hconcat g2 (grid-rotate-cw g2))))
          2)))))

; ── Depth-3 composition scaffolds: 3-op chains ──────────────────────
;
; Generate scaffolds requiring depth-3 synthesis (3 nested operations).
; These target complex ARC tasks that depth-2 cannot reach.

(define pm-scaffold-depth3-compositions
  (lambda ()
    (let ((g1 (nth pm-sample-grids 0))
          (g2 (nth pm-sample-grids 1))
          (g3 (nth pm-sample-grids 2)))
      (list
        ; grid-trim(grid-rotate-cw(grid-object(x, 0)))
        (list "scaffold_d3_obj0_rot_trim"
          (let ((big1 (list (list 0 1 1 0 0) (list 0 1 1 0 0) (list 0 0 0 2 0) (list 0 0 0 0 0)))
                (big2 (list (list 0 0 3 3 3) (list 0 0 3 3 3) (list 0 0 3 3 3) (list 4 0 0 0 0))))
            (list (list (list big1) (grid-trim (grid-rotate-cw (grid-object big1 0))))
                  (list (list big2) (grid-trim (grid-rotate-cw (grid-object big2 0))))))
          3)
        ; grid-flip-h(grid-rotate-cw(grid-trim(x)))
        (list "scaffold_d3_trim_rot_fliph"
          (let ((padded1 (list (list 0 0 0 0 0) (list 0 1 2 0 0) (list 0 3 4 0 0) (list 0 0 0 0 0)))
                (padded2 (list (list 0 0 0 0 0) (list 0 0 5 6 0) (list 0 0 7 8 0) (list 0 0 0 0 0))))
            (list (list (list padded1) (grid-flip-h (grid-rotate-cw (grid-trim padded1))))
                  (list (list padded2) (grid-flip-h (grid-rotate-cw (grid-trim padded2))))))
          3)
        ; grid-compact(grid-flip-h(grid-rotate-cw(x)))
        (list "scaffold_d3_rot_fliph_compact"
          (let ((sp1 (list (list 1 0 2) (list 0 0 0) (list 3 0 4)))
                (sp2 (list (list 5 0 0 6) (list 0 0 0 0) (list 0 0 0 0) (list 7 0 0 8))))
            (list (list (list sp1) (grid-compact (grid-flip-h (grid-rotate-cw sp1))))
                  (list (list sp2) (grid-compact (grid-flip-h (grid-rotate-cw sp2))))))
          3)
        ; grid-scale(grid-trim(x), 2)
        (list "scaffold_d3_trim_scale2"
          (let ((padded1 (list (list 0 0 0 0) (list 0 1 2 0) (list 0 3 4 0) (list 0 0 0 0)))
                (padded2 (list (list 0 0 0 0 0) (list 0 0 5 0 0) (list 0 5 5 5 0) (list 0 0 5 0 0) (list 0 0 0 0 0))))
            (list (list (list padded1) (grid-scale (grid-trim padded1) 2))
                  (list (list padded2) (grid-scale (grid-trim padded2) 2))))
          3)
        ; grid-flip-h(grid-hconcat(x, grid-rotate-cw(x)))
        (list "scaffold_d3_hconcat_rot_fliph"
          (list (list (list g1) (grid-flip-h (grid-hconcat g1 (grid-rotate-cw g1))))
                (list (list g2) (grid-flip-h (grid-hconcat g2 (grid-rotate-cw g2)))))
          3)
        ; grid-rotate-cw(grid-flip-v(grid-trim(x)))
        (list "scaffold_d3_trim_flipv_rot"
          (let ((padded1 (list (list 0 0 0 0 0) (list 0 1 2 0 0) (list 0 3 4 0 0) (list 0 0 0 0 0)))
                (padded2 (list (list 0 0 0 0 0) (list 0 0 5 6 0) (list 0 0 7 8 0) (list 0 0 0 0 0))))
            (list (list (list padded1) (grid-rotate-cw (grid-flip-v (grid-trim padded1))))
                  (list (list padded2) (grid-rotate-cw (grid-flip-v (grid-trim padded2))))))
          3)
        ; grid-trim(grid-flip-h(grid-object(x, 0)))
        (list "scaffold_d3_obj0_fliph_trim"
          (let ((big1 (list (list 0 1 1 0 0) (list 0 1 1 0 0) (list 0 0 0 2 0) (list 0 0 0 0 0)))
                (big2 (list (list 0 0 3 3 3) (list 0 0 3 3 3) (list 0 0 3 3 3) (list 4 0 0 0 0))))
            (list (list (list big1) (grid-trim (grid-flip-h (grid-object big1 0))))
                  (list (list big2) (grid-trim (grid-flip-h (grid-object big2 0))))))
          3)))))

; ── Solve scaffolding and bind as library ────────────────────────────
;
; Takes list of (name, spec, [depth]) triples. For each, calls
; synthesize-args with the scaffold's depth and appropriate budget.
; If solved, evals the source and binds it via eval-source (define ...).
; Returns count of successfully solved + bound scaffolds.

(define pm-solve-scaffolding
  (lambda (scaffolds)
    (reduce
      (lambda (count scaffold)
        (let ((name (nth scaffold 0))
              (spec (nth scaffold 1))
              (depth (if (>= (length scaffold) 3) (nth scaffold 2) 2))
              (budget (if (>= (length scaffold) 3)
                        (if (>= (nth scaffold 2) 3) 100000 50000)
                        50000)))
          (let ((result (try
                  (synthesize-args
                    (ns ("spec" spec)
                        ("max-depth" depth)
                        ("max-candidates" budget)))
                  (ns ("found" false)))))
            (if (try (ns-get result "found") false)
              (let ((source (ns-get result "source")))
                ; Bind the solution as a named function
                (do (try (eval-source (concat "(define " name " " source ")")) nil)
                    (+ count 1)))
              count))))
      scaffolds
      0)))

; ── Re-attempt failures with expanded library ────────────────────────
;
; After scaffolding enriches the library, re-run synthesis on original
; failed tasks. Returns list of (name, found, source) for any recovered.

; Buckets that have scaffolding support (matching pm-scaffold-for-rx)
(define pm-scaffolded-rx-prefixes
  (list "scaling-or-tiling" "extract/" "recomp/" "color-filtering" "grid-composition"))

(define pm-rx-has-scaffolding?
  (lambda (rx)
    (pm-any? (lambda (prefix) (try (string-starts-with rx prefix) false))
      pm-scaffolded-rx-prefixes)))

(define pm-retry-with-library
  (lambda (fails diagnoses)
    ; Only retry tasks whose prescription matches a scaffolded bucket
    (let ((targeted (filter (lambda (r)
            (let ((name (ns-get r "name")))
              (let ((diag (head (filter (lambda (d) (= (ns-get d "name") name)) diagnoses))))
                (let ((rx (ns-get (ns-get diag "prescription") "rx")))
                  (pm-rx-has-scaffolding? rx)))))
            fails)))
      (filter (lambda (r) (ns-get r "found"))
        (map (lambda (r)
          (let ((name (ns-get r "name"))
                (spec (ns-get r "spec"))
                (test (try (ns-get r "test") (list))))
            (let ((result (try
                    (synthesize-args
                      (ns ("spec" spec)
                          ("max-depth" 2)
                          ("max-candidates" 50000)
                          ("test" test)))
                    (ns ("found" false)))))
              (let ((found (try (ns-get result "found") false))
                    (source (try (ns-get result "source") "")))
                (do (if found
                      (print (concat "  LIBRARY-RECOVERED  " name "  " source))
                      nil)
                    (ns ("name" name)
                        ("found" found)
                        ("source" source)))))))
          targeted)))))

; ── Main entry point ─────────────────────────────────────────────────

(define run-post-mortem
  (lambda (results)
    (let ((fails (pm-failures results)))
      (if (= (length fails) 0)
        (ns ("diagnoses" (list))
            ("prescriptions" (list))
            ("recovered" 0)
            ("total-failures" 0)
            ("total-results" (length results)))
        (let ((diagnoses (map pm-diagnose-one fails)))
          ; Attach prescription to each diagnosis
          (let ((with-rx (map (lambda (d)
                    (ns-put d "prescription" (pm-prescribe d)))
                  diagnoses)))
            ; Auto-recovery pass (skip if __pm_skip_recovery__ is set)
            (let ((with-recovery
                    (if (try __pm_skip_recovery__ false)
                      with-rx
                      (map (lambda (d)
                        (let ((r-entry (head (filter (lambda (r)
                                (= (ns-get r "name") (ns-get d "name")))
                              fails))))
                          (pm-auto-recover-one r-entry d)))
                        with-rx))))
              (let ((recovered-count
                      (pm-count (lambda (d) (try (ns-get d "auto-found") false))
                        with-recovery))
                    (prescriptions (pm-aggregate-prescriptions with-recovery)))
                ; Phase 1.5: Generate M-chain forms from prescriptions
                (let ((rx-forms-count (pm-generate-rx-forms prescriptions fails)))
                ; Phase 2: Scaffolding loop (skip if __pm_skip_scaffolding__)
                (let ((scaffolding-result
                        (if (try __pm_skip_scaffolding__ false)
                          (ns ("scaffolds-solved" 0) ("library-recovered" 0))
                          (pm-run-scaffolding-loop prescriptions fails with-recovery))))
                  (ns ("diagnoses" with-recovery)
                      ("prescriptions" prescriptions)
                      ("recovered" recovered-count)
                      ("scaffolds-solved" (ns-get scaffolding-result "scaffolds-solved"))
                      ("library-recovered" (ns-get scaffolding-result "library-recovered"))
                      ("total-failures" (length fails))
                      ("total-results" (length results)))))))))))))

; Phase 2: generate scaffolding -> solve -> retry (iterative)
;
; Each iteration: generate scaffolds → solve → bind as library → retry failures.
; Recovered solutions are bound as library functions so the next iteration can
; compose them. Stops when: no scaffolds generated, none solved, none recovered,
; or max iterations reached. Configurable via __pm_max_iterations__ (default 3).

(define pm-run-scaffolding-loop
  (lambda (prescriptions fails diagnoses)
    (let ((max-iters (try __pm_max_iterations__ 3)))
      (pm-iterate-scaffold prescriptions fails diagnoses max-iters 0 0))))

; Bind each recovered solution as a library function for the next iteration.
(define pm-bind-recovered
  (lambda (recovered)
    (reduce (lambda (acc r)
      (let ((name (ns-get r "name"))
            (source (ns-get r "source")))
        (do (try (eval-source (concat "(define pm-lib-" name " " source ")")) nil)
            (+ acc 1))))
      recovered 0)))

; Remove recovered tasks, re-diagnose remaining, re-prescribe, recurse.
(define pm-prepare-next-iteration
  (lambda (remaining-fails iters-left total-scaffolds total-recovered)
    (if (= (length remaining-fails) 0)
      (ns ("scaffolds-solved" total-scaffolds) ("library-recovered" total-recovered))
      (let ((new-with-rx (-> remaining-fails
                           (map pm-diagnose-one)
                           (map (lambda (d) (ns-put d "prescription" (pm-prescribe d)))))))
        (pm-iterate-scaffold
          (pm-aggregate-prescriptions new-with-rx)
          remaining-fails new-with-rx
          iters-left total-scaffolds total-recovered)))))


; One iteration: generate scaffolds, solve, retry, maybe recurse.
(define pm-iterate-scaffold
  (lambda (prescriptions fails diagnoses iters-left total-scaffolds total-recovered)
    (let ((result (ns ("scaffolds-solved" total-scaffolds)
                      ("library-recovered" total-recovered))))
      (if (<= iters-left 0) result
      (let ((iter-num (+ 1 (- (try __pm_max_iterations__ 3) iters-left))))
        (do (print (concat "-- Scaffold iteration " (to-string iter-num)
                           " -- " (to-string (length fails)) " failures remaining"))
        (let ((scaffolds (pm-generate-scaffolding prescriptions fails)))
          (if (= (length scaffolds) 0)
            (do (print "  No scaffolds generated, stopping.") result)
          (let ((solved-count (pm-solve-scaffolding scaffolds)))
            (if (= solved-count 0)
              (do (print "  No scaffolds solved, stopping.") result)
            (let ((recovered (pm-retry-with-library fails diagnoses))
                  (new-total-s (+ total-scaffolds solved-count)))
              (if (= (length recovered) 0)
                (do (print (concat "  " (to-string solved-count) " solved, 0 recovered, stopping."))
                    (ns ("scaffolds-solved" new-total-s) ("library-recovered" total-recovered)))
                (let ((new-total-r (+ total-recovered (length recovered)))
                      (remaining (filter
                        (lambda (f) (not (pm-member? (ns-get f "name")
                          (map (lambda (r) (ns-get r "name")) recovered))))
                        fails)))
                  (do (pm-bind-recovered recovered)
                  (do (print (concat "  " (to-string solved-count) " solved, "
                                     (to-string (length recovered)) " recovered. Iterating..."))
                  (pm-prepare-next-iteration
                    remaining (- iters-left 1)
                    new-total-s new-total-r))))))))))))))))
