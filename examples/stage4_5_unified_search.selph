; ============================================================================
; Stage 4+5: Unified Search Function & Self-Optimization
; ============================================================================
;
; Stage 4: Compose all strategies (flat, memo, BD, D&C) into a unified
;   search function. Profile on a diverse task suite and learn which
;   strategy to try first based on task features.
;
; Stage 5: The search function's budget allocation becomes an optimization
;   target — minimize total candidates across the task suite.
;
; Run: selph eval examples/stage4_5_unified_search.selph
; ============================================================================

; ============================================================================
; Predicate library (shared by BD and D&C)
; ============================================================================

(define pred-lib "(defmacro is_short (s) (< (string-length s) 3))
(defmacro is_long (s) (> (string-length s) 3))
(defmacro is_med (s) (= (string-length s) 3))
(defmacro starts_a (s) (string-starts-with s \"a\"))
(defmacro starts_b (s) (string-starts-with s \"b\"))
(defmacro ends_g (s) (string-ends-with s \"g\"))
(defmacro has_a (s) (string-contains s \"a\"))
(defmacro is_len1 (s) (= (string-length s) 1))")

; Define predicates in current env for BD and verification
(defmacro is_short (s) (< (string-length s) 3))
(defmacro is_long (s) (> (string-length s) 3))
(defmacro is_med (s) (= (string-length s) 3))
(defmacro starts_a (s) (string-starts-with s "a"))
(defmacro starts_b (s) (string-starts-with s "b"))
(defmacro ends_g (s) (string-ends-with s "g"))
(defmacro has_a (s) (string-contains s "a"))
(defmacro is_len1 (s) (= (string-length s) 1))

; ============================================================================
; Diverse task suite — 16 tasks spanning all strategy domains
; ============================================================================

