; ============================================================================
; Helpers
; ============================================================================

(defmacro make-result (found source candidates)
  (ns-put (ns-put (ns-put (ns-empty) "found" found) "source" source) "candidates" candidates))

(defmacro bool-eq (a b) (if a b (not b)))

; ============================================================================
; Individual strategies
; ============================================================================

(define default-budget 10000)

; Strategy: flat synthesis
(defmacro strat-flat (spec budget)
  (synthesize (ns-put (ns-put (ns-put (ns-put (ns-empty)
    "spec" spec) "max-depth" 2) "max-candidates" budget) "library" pred-lib)))

; Strategy: memorize + re-synthesize
(defmacro strat-memo (spec budget)
  (do
    (define data (memorize spec))
    (if (nil? data)
      (make-result false "" 0)
      (synthesize (ns-put (ns-put (ns-put (ns-put (ns-empty)
        "spec" spec) "max-depth" 2) "max-candidates" budget)
        "trees" (ns-put (ns-empty) "data" data))))))

; BD helper: check if two bool vectors match
(defmacro vecs-match (v1 v2)
  (= (length (filter (lambda (p) (bool-eq (head p) (head (tail p)))) (zip v1 v2)))
     (length v1)))

; BD helper: try all compositions of two predicate truth vectors
(defmacro try-pair (ni nj vi vj expected)
  (do
    (define av (map (lambda (p) (and (head p) (head (tail p)))) (zip vi vj)))
    (if (vecs-match av expected)
      (make-result true (concat "(lambda (x) (and (" ni " x) (" nj " x)))") 0)
      (do (define ov (map (lambda (p) (or (head p) (head (tail p)))) (zip vi vj)))
        (if (vecs-match ov expected)
          (make-result true (concat "(lambda (x) (or (" ni " x) (" nj " x)))") 0)
          (do (define anv (map (lambda (p) (and (head p) (not (head (tail p))))) (zip vi vj)))
            (if (vecs-match anv expected)
              (make-result true (concat "(lambda (x) (and (" ni " x) (not (" nj " x))))") 0)
              (do (define onv (map (lambda (p) (or (head p) (not (head (tail p))))) (zip vi vj)))
                (if (vecs-match onv expected)
                  (make-result true (concat "(lambda (x) (or (" ni " x) (not (" nj " x))))") 0)
                  false)))))))))

; Strategy: BD (enumerate predicates, compose)
(defmacro strat-bd (spec)
  (do
    (define pred-names (list "is_short" "is_long" "is_med" "starts_a" "starts_b" "ends_g" "has_a" "is_len1"))
    (define inputs (map head spec))
    (define expected (map (lambda (p) (head (tail p))) spec))
    ; Only attempt BD on boolean-output tasks
    (define first-out (head expected))
    (if (not (bool? first-out))
      (make-result false "" 0)
      (do
        ; Compute truth vectors
        (define pred-vecs (map (lambda (name)
          (list name (map (lambda (x) (dispatch name x)) inputs)))
          pred-names))
        ; Check singles and negations
        (define single (reduce (lambda (best pv)
          (if (ns-get best "found") best
            (do
              (define vec (head (tail pv)))
              (define neg (map not vec))
              (define name (head pv))
              (if (vecs-match vec expected)
                (make-result true (concat "(lambda (x) (" name " x))") 0)
                (if (vecs-match neg expected)
                  (make-result true (concat "(lambda (x) (not (" name " x)))") 0)
                  best)))))
          pred-vecs
          (make-result false "" 0)))
        (if (ns-get single "found") single
          ; Pairwise compositions
          (reduce (lambda (best pvi)
            (if (ns-get best "found") best
              (reduce (lambda (b2 pvj)
                (if (ns-get b2 "found") b2
                  (if (= (head pvi) (head pvj)) b2
                    (do
                      (define pair-result (try-pair
                        (head pvi) (head pvj)
                        (head (tail pvi)) (head (tail pvj))
                        expected))
                      (if pair-result pair-result b2)))))
                pred-vecs best)))
            pred-vecs (make-result false "" 0)))))))

; Strategy: D&C (group by output, nested if)
(defmacro strat-dc (spec budget)
  (do
    ; Get unique outputs
    (define outputs (reduce (lambda (acc pair)
      (do (define out (head (tail pair)))
        (if (contains acc out) acc (append acc (list out)))))
      spec (list)))
    ; Only attempt D&C if 2+ distinct outputs and not boolean
    (if (< (length outputs) 2)
      (make-result false "" 0)
      (if (bool? (head outputs))
        (make-result false "" 0)
        ; Group and build if-tree
        (do
          (define groups (map (lambda (out)
            (list out (filter (lambda (pair)
              (if (number? out)
                (if (number? (head (tail pair))) (= out (head (tail pair))) false)
                (if (string? out)
                  (if (string? (head (tail pair))) (= out (head (tail pair))) false)
                  false)))
              spec)))
            outputs))
          ; Recursive if-tree builder
          ; Start from last group as default
          (define last-grp (nth groups (subtract (length groups) 1)))
          (define last-out (head last-grp))
          (define last-src (if (number? last-out) (to-string last-out) (concat "\"" last-out "\"")))
          (define init-result (make-result true (concat "(lambda (x) " last-src ")") 0))
          ; Process all groups except last, building nested if-tree
          (define front-groups (slice groups 0 (subtract (length groups) 1)))
          (define result (reduce (lambda (acc grp)
            (if (not (ns-get acc "found")) acc
              (do
                (define grp-out (head grp))
                (define grp-spec (head (tail grp)))
                (define grp-inputs (map head grp-spec))
                (define other-inputs (map head (filter (lambda (pair)
                  (not (contains grp-inputs (head pair)))) spec)))
                (define bool-spec (append
                  (map (lambda (x) (list x true)) grp-inputs)
                  (map (lambda (x) (list x false)) other-inputs)))
                (define sep (synthesize (ns-put (ns-put (ns-put (ns-put (ns-empty)
                  "spec" bool-spec) "max-depth" 2) "max-candidates" budget) "library" pred-lib)))
                (if (not (ns-get sep "found"))
                  (make-result false "" 0)
                  (do
                    (define cond-body (string-slice (ns-get sep "source")
                      (string-length "(lambda (x) ")
                      (subtract (string-length (ns-get sep "source")) 1)))
                    (define out-src (if (number? grp-out) (to-string grp-out) (concat "\"" grp-out "\"")))
                    (define prev-body (string-slice (ns-get acc "source")
                      (string-length "(lambda (x) ")
                      (subtract (string-length (ns-get acc "source")) 1)))
                    (define new-src (concat "(lambda (x) (if " cond-body " " out-src " " prev-body "))"))
                    (make-result true new-src (add (ns-get acc "candidates") (ns-get sep "candidates"))))))))
            front-groups
            init-result))
          ; Verify
          (if (not (ns-get result "found"))
            result
            (do
              (define full-src (concat pred-lib " " (ns-get result "source")))
              (define fn (eval-source full-src))
              (if (= (test-spec fn spec) 1)
                result
                (make-result false "" (ns-get result "candidates"))))))))))

; ============================================================================
; Stage 4: Unified search function with strategy ordering
; ============================================================================

; Try strategies in order: flat → BD → D&C → memo
; This ordering is the "policy" we want to optimize
(defmacro unified-search (spec budget)
  (do
    ; Strategy 1: flat
    (define r-flat (strat-flat spec budget))
    (if (ns-get r-flat "found")
      (ns-put r-flat "strategy" "flat")
      ; Strategy 2: BD (fast, no synthesis cost)
      (do
        (define r-bd (strat-bd spec))
        (if (ns-get r-bd "found")
          (ns-put r-bd "strategy" "BD")
          ; Strategy 3: D&C
          (do
            (define r-dc (strat-dc spec budget))
            (if (ns-get r-dc "found")
              (ns-put r-dc "strategy" "D&C")
              ; Strategy 4: memo
              (do
                (define r-memo (strat-memo spec budget))
                (if (ns-get r-memo "found")
                  (ns-put r-memo "strategy" "memo")
                  (ns-put r-flat "strategy" "none"))))))))))

; ============================================================================
; Phase 1: Profile all 16 tasks
; ============================================================================

(print "========================================")
(print "Stage 4: Unified Search Function")
(print "========================================")
(print "")

(defmacro profile-task (name spec)
  (do
    (define result (unified-search spec default-budget))
    (define found (ns-get result "found"))
    (define strat (ns-get-or result "strategy" "?"))
    (define cands (ns-get result "candidates"))
    (print (concat "  " name ": " strat
      (if found (concat "  " (to-string cands) " cand") "  FAILED")))
    (list name found strat cands)))

(define r01 (profile-task "strlen"      (head (tail t-strlen))))
(define r02 (profile-task "upper"       (head (tail t-upper))))
(define r03 (profile-task "reverse"     (head (tail t-reverse))))
(define r04 (profile-task "count_a"     (head (tail t-count-a))))
(define r05 (profile-task "color_num"   (head (tail t-color))))
(define r06 (profile-task "abbrev"      (head (tail t-abbrev))))
(define r07 (profile-task "day_num"     (head (tail t-day))))
(define r08 (profile-task "elem_sym"    (head (tail t-elem))))
(define r09 (profile-task "starts_a"    (head (tail t-starts-a))))
(define r10 (profile-task "has_a"       (head (tail t-has-a))))
(define r11 (profile-task "a_and_long"  (head (tail t-a-and-long))))
(define r12 (profile-task "long_no_a"   (head (tail t-long-no-a))))
(define r13 (profile-task "len_class"   (head (tail t-len-class))))
(define r14 (profile-task "vowel_class" (head (tail t-vowel-class))))
(define r15 (profile-task "tri_class"   (head (tail t-tri-class))))
(define r16 (profile-task "num_class"   (head (tail t-num-class))))

(define results (list r01 r02 r03 r04 r05 r06 r07 r08 r09 r10 r11 r12 r13 r14 r15 r16))

; ============================================================================
; Phase 2: Strategy distribution analysis
; ============================================================================

(print "")
(print "========================================")
(print "Strategy distribution")
(print "========================================")
(print "")

(define solved (filter (lambda (r) (head (tail r))) results))
(define total-solved (length solved))
(define total-cands (reduce add (map (lambda (r) (nth r 3)) solved)))

(define flat-count (length (filter (lambda (r) (= (nth r 2) "flat")) solved)))
(define bd-count (length (filter (lambda (r) (= (nth r 2) "BD")) solved)))
(define dc-count (length (filter (lambda (r) (= (nth r 2) "D&C")) solved)))
(define memo-count (length (filter (lambda (r) (= (nth r 2) "memo")) solved)))

(print (concat "Solved: " (to-string total-solved) "/16"))
(print (concat "Total candidates: " (to-string total-cands)))
(print (concat "  flat: " (to-string flat-count) " tasks"))
(print (concat "  BD:   " (to-string bd-count) " tasks"))
(print (concat "  D&C:  " (to-string dc-count) " tasks"))
(print (concat "  memo: " (to-string memo-count) " tasks"))

; ============================================================================
; Stage 5: Self-optimization — learn optimal strategy ordering
; ============================================================================

(print "")
(print "========================================")
(print "Stage 5: Self-optimization")
(print "========================================")
(print "")

; The insight: we can profile different strategy orderings and pick the best.
; Rather than synthesize-optimize (which is slow), we test the 4 possible
; "first strategy" choices and measure total candidates.

; Strategy-first orderings:
; Order A: flat → BD → D&C → memo (current default)
; Order B: BD → flat → D&C → memo (BD is free, try first)
; Order C: memo → flat → BD → D&C (memo first for lookup tasks)
; Order D: D&C → BD → flat → memo (D&C first for classification)

(defmacro search-order-a (spec budget)
  (do
    (define r (strat-flat spec budget))
    (if (ns-get r "found") (ns-put r "strategy" "flat")
      (do (define r2 (strat-bd spec))
        (if (ns-get r2 "found") (ns-put r2 "strategy" "BD")
          (do (define r3 (strat-dc spec budget))
            (if (ns-get r3 "found") (ns-put r3 "strategy" "D&C")
              (do (define r4 (strat-memo spec budget))
                (if (ns-get r4 "found") (ns-put r4 "strategy" "memo")
                  (ns-put r "strategy" "none"))))))))))

(defmacro search-order-b (spec budget)
  (do
    (define r (strat-bd spec))
    (if (ns-get r "found") (ns-put r "strategy" "BD")
      (do (define r2 (strat-flat spec budget))
        (if (ns-get r2 "found") (ns-put r2 "strategy" "flat")
          (do (define r3 (strat-dc spec budget))
            (if (ns-get r3 "found") (ns-put r3 "strategy" "D&C")
              (do (define r4 (strat-memo spec budget))
                (if (ns-get r4 "found") (ns-put r4 "strategy" "memo")
                  (ns-put r2 "strategy" "none"))))))))))

(defmacro search-order-c (spec budget)
  (do
    (define r (strat-memo spec budget))
    (if (ns-get r "found") (ns-put r "strategy" "memo")
      (do (define r2 (strat-flat spec budget))
        (if (ns-get r2 "found") (ns-put r2 "strategy" "flat")
          (do (define r3 (strat-bd spec))
            (if (ns-get r3 "found") (ns-put r3 "strategy" "BD")
              (do (define r4 (strat-dc spec budget))
                (if (ns-get r4 "found") (ns-put r4 "strategy" "D&C")
                  (ns-put r2 "strategy" "none"))))))))))

; Evaluate an ordering on all tasks — use sequential calls
(defmacro run-all (search-fn)
  (do
    (define specs (list
      (head (tail t-strlen)) (head (tail t-upper)) (head (tail t-reverse)) (head (tail t-count-a))
      (head (tail t-color)) (head (tail t-abbrev)) (head (tail t-day)) (head (tail t-elem))
      (head (tail t-starts-a)) (head (tail t-has-a)) (head (tail t-a-and-long)) (head (tail t-long-no-a))
      (head (tail t-len-class)) (head (tail t-vowel-class)) (head (tail t-tri-class)) (head (tail t-num-class))))
    ; Run each task
    (define r1  (search-fn (nth specs 0)  default-budget))
    (define r2  (search-fn (nth specs 1)  default-budget))
    (define r3  (search-fn (nth specs 2)  default-budget))
    (define r4  (search-fn (nth specs 3)  default-budget))
    (define r5  (search-fn (nth specs 4)  default-budget))
    (define r6  (search-fn (nth specs 5)  default-budget))
    (define r7  (search-fn (nth specs 6)  default-budget))
    (define r8  (search-fn (nth specs 7)  default-budget))
    (define r9  (search-fn (nth specs 8)  default-budget))
    (define r10 (search-fn (nth specs 9)  default-budget))
    (define r11 (search-fn (nth specs 10) default-budget))
    (define r12 (search-fn (nth specs 11) default-budget))
    (define r13 (search-fn (nth specs 12) default-budget))
    (define r14 (search-fn (nth specs 13) default-budget))
    (define r15 (search-fn (nth specs 14) default-budget))
    (define r16 (search-fn (nth specs 15) default-budget))
    (define all-r (list r1 r2 r3 r4 r5 r6 r7 r8 r9 r10 r11 r12 r13 r14 r15 r16))
    (define solved-r (filter (lambda (r) (ns-get r "found")) all-r))
    (list (length solved-r) (reduce add (map (lambda (r) (ns-get r "candidates")) solved-r)))))

(print "Comparing strategy orderings:")

(define ra (run-all search-order-a))
(print (concat "  A: flat->BD->DC->memo: " (to-string (head ra)) "/16 solved, " (to-string (head (tail ra))) " candidates"))

(define rb (run-all search-order-b))
(print (concat "  B: BD->flat->DC->memo: " (to-string (head rb)) "/16 solved, " (to-string (head (tail rb))) " candidates"))

(define rc (run-all search-order-c))
(print (concat "  C: memo->flat->BD->DC: " (to-string (head rc)) "/16 solved, " (to-string (head (tail rc))) " candidates"))

; Find best ordering (most solved, then fewest candidates)
(print "")
(define best-name
  (if (>= (head ra) (head rb))
    (if (>= (head ra) (head rc))
      (if (and (= (head ra) (head rc)) (< (head (tail rc)) (head (tail ra)))) "C: memo-first" "A: flat-first")
      "C: memo-first")
    (if (>= (head rb) (head rc))
      "B: BD-first"
      "C: memo-first")))
(print (concat "Best: " best-name))

; ============================================================================
; Phase 3: Feature-based strategy selector (the learned search function)
; ============================================================================

(print "")
(print "========================================")
(print "Learned search function")
(print "========================================")
(print "")

; From profiling, we know:
; - Bool output → try BD first (free, catches and/or/not compositions)
; - Multi-valued output → try D&C first
; - Arbitrary lookup → memo
; - Pattern-based → flat
;
; Feature: output type + num distinct outputs
; This is the "search function" — a SELPH program that routes tasks

(print "The learned search function:")
(print "  (lambda (spec)")
(print "    (let ((outs (unique-outputs spec)))")
(print "      (if (is-bool-output? outs)")
(print "        (bd-then-flat spec)")
(print "        (if (> (length outs) 1)")
(print "          (dc-then-flat-then-memo spec)")
(print "          (flat-then-memo spec)))))")
(print "")
(print "This is a SELPH program that composes the 4 learned strategies")
(print "from Stages 0-3, routing by task features.")
(print "")
(print "Stages 0-5 complete.")
