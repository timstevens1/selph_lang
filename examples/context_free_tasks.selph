; Context-free language curriculum
; Input: a string
; Output: boolean (recognition) or number (counting/analysis)
;
; Builds from counting → equality → ordering → nesting
; Each stage provides scaffolding for the next.
; Examples kept to 8 per task for synthesis efficiency.

; === Stage 0: Character counting ===
; count-a: count occurrences of "a" in the string
(task "count_a" 2
  ("a" 1) ("aa" 2) ("aaa" 3) ("aaaa" 4)
  ("b" 0) ("ab" 1) ("ba" 1) ("aba" 2))

; count-b: count occurrences of "b"
(task "count_b" 2
  ("b" 1) ("bb" 2) ("bbb" 3)
  ("a" 0) ("ab" 1) ("ba" 1) ("abb" 2) ("aaa" 0))

; len: string length
(task "str_len" 2
  ("a" 1) ("ab" 2) ("abc" 3) ("abcd" 4)
  ("x" 1) ("xy" 2) ("" 0) ("hello" 5))

; === Stage 1: Equality checks (a^n b^n prerequisite) ===
; equal_ab: does the string have equal counts of a and b?
(task "equal_ab" 2
  ("ab" true) ("aabb" true) ("aaabbb" true)
  ("a" false) ("aab" false) ("abb" false)
  ("ba" true) ("" true))

; more_a: does string have more a's than b's?
(task "more_a" 2
  ("a" true) ("aa" true) ("aab" true)
  ("b" false) ("ab" false) ("bb" false)
  ("aba" true) ("bab" false))

; === Stage 1.5: String replacement (scaffolding) ===
; remove_a: remove all a's from string
(task "remove_a" 2
  ("a" "") ("ab" "b") ("aab" "b") ("ba" "b")
  ("aba" "b") ("bbb" "bbb") ("aaa" "")
  ("bab" "bb"))

; remove_b: remove all b's from string
(task "remove_b" 2
  ("b" "") ("ab" "a") ("abb" "a") ("ba" "a")
  ("bab" "a") ("aaa" "aaa") ("bbb" "")
  ("abba" "aa"))

; a_to_b: replace all a's with b's
(task "a_to_b" 2
  ("a" "b") ("ab" "bb") ("aab" "bbb")
  ("ba" "bb") ("aaa" "bbb") ("bbb" "bbb")
  ("aba" "bbb") ("" ""))

; === Stage 2: Structure checks ===
; starts_a: does the string start with "a"?
(task "starts_a" 2
  ("a" true) ("ab" true) ("abc" true) ("aaa" true)
  ("b" false) ("ba" false) ("cba" false) ("" false))

; ends_b: does the string end with "b"?
(task "ends_b" 2
  ("b" true) ("ab" true) ("aab" true) ("bb" true)
  ("a" false) ("ba" false) ("abc" false) ("" false))

; all_a: is the string all a's?
(task "all_a" 2
  ("a" true) ("aa" true) ("aaa" true) ("aaaa" true)
  ("b" false) ("ab" false) ("ba" false) ("aab" false))

; === Stage 2.5: Boolean logic scaffolding ===
; Teach and/or/not so the synthesizer can compose boolean predicates.

; not_starts_a: negation of starts_a
; Expected: (not (starts_a x))
(task "not_starts_a" 2
  ("a" false) ("ab" false) ("abc" false) ("aaa" false)
  ("b" true) ("ba" true) ("cba" true) ("" true))

; starts_a_and_ends_b: conjunction of two predicates
; Expected: (and (starts_a x) (ends_b x))
(task "starts_a_and_ends_b" 2
  ("ab" true) ("aab" true) ("abb" true) ("acb" true)
  ("a" false) ("ba" false) ("b" false) ("abc" false))

; starts_a_or_ends_b: disjunction of two predicates
; Expected: (or (starts_a x) (ends_b x))
(task "starts_a_or_ends_b" 2
  ("ab" true) ("a" true) ("b" true) ("aab" true)
  ("ba" false) ("bc" false) ("cd" false) ("" false))

; === Stage 3: a^n b^n recognition ===
; no_b_before_a: all b's come after all a's
(task "no_b_before_a" 2
  ("ab" true) ("aabb" true) ("aaabbb" true) ("aab" true)
  ("ba" false) ("bab" false) ("abab" false) ("bba" false))

; a^n b^n: equal counts AND proper ordering
(task "anbn" 3
  ("ab" true) ("aabb" true) ("aaabbb" true)
  ("a" false) ("b" false) ("ba" false)
  ("abab" false) ("" true))

; === Stage 4: Palindrome recognition ===
(task "palindrome" 2
  ("a" true) ("aa" true) ("aba" true) ("abba" true)
  ("ab" false) ("abc" false) ("abca" false) ("" true))

; === Stage 5: Bracket matching ===
; count_open: count "(" in string
(task "count_open" 2
  ("()" 1) ("(())" 2) ("((()))" 3)
  ("()()" 2) ("(()" 2) (")" 0)
  ("" 0) ("((((" 4))

; count_close: count ")" in string
(task "count_close" 2
  ("()" 1) ("(())" 2) ("((()))" 3)
  ("()()" 2) ("(()" 1) ("(" 0)
  ("" 0) ("))))" 4))

; matched_parens: equal open and close counts
(task "matched_parens" 2
  ("()" true) ("(())" true) ("()()" true) ("((()))" true)
  ("(" false) (")" false) ("(()" false) ("())" false))
