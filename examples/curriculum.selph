; ============================================================================
; curriculum.selph — The curriculum loop expressed as a SELPH program
; ============================================================================
;
; This demonstrates that the learning strategy itself is a SELPH program,
; meaning synthesis can potentially improve the learning strategy.
;
; The curriculum loop:
;   1. Start with a set of tasks ordered by difficulty
;   2. For each task, attempt synthesis within a budget
;   3. If solved, promote the solution into the library (defmacro)
;   4. Advance to harder tasks, which can now use the promoted solutions
;
; Current limitations:
;   - Dynamic defmacro creation from synthesized source requires an
;     `eval-source` builtin (not yet implemented) to turn a source string
;     back into a live macro at runtime
;   - Task ordering/selection could be expressed as a synthesizable policy
;     once we have richer control flow
;
; What IS functional today:
;   - solve-task calls the real `synthesize` builtin and returns results
;   - Task specs are built as namespace data
;   - Results are inspected and reported
;   - The full loop structure is valid SELPH
; ============================================================================

; --- Sequence prediction helpers (needed by synthesis) ---
; These are the primitives that synthesized programs can use.

(defmacro idx (s)
  (to-number (head (string-split s " "))))

(defmacro v0 (s)
  (to-number (head (tail (string-split s " ")))))

(defmacro v1 (s)
  (to-number (head (tail (tail (string-split s " "))))))

(defmacro v2 (s)
  (to-number (head (tail (tail (tail (string-split s " ")))))))

(defmacro v3 (s)
  (to-number (head (tail (tail (tail (tail (string-split s " "))))))))

(defmacro last (s)
  (to-number (head (tail (tail (tail (tail (string-split s " "))))))))


; ============================================================================
; Part 1: solve-task — attempt synthesis on a single task
; ============================================================================
; Takes a task spec (list of (input, output) pairs), max depth, and budget.
; Returns the namespace that `synthesize` produces:
;   { "found": bool, "candidates": number, "source": string }

(defmacro solve-task (spec max-depth max-budget)
  (synthesize
    (ns-put (ns-put (ns-put (ns-empty)
                             "spec" spec)
                     "max-depth" max-depth)
             "max-candidates" max-budget)))


; ============================================================================
; Part 2: promote-if-solved — extract promotion info from a result
; ============================================================================
; If synthesis found a program, return a namespace describing the promotion.
; Otherwise return false.
;
; NOTE: To actually install the promoted macro at runtime, we would need
; an `eval-source` or `define-from-source` builtin, e.g.:
;   (eval-source (concat "(defmacro " name " (s) " source ")"))
; This is the key missing piece for full self-hosting.

(defmacro promote-if-solved (result task-name)
  (if (ns-get result "found")
    (ns-put (ns-put (ns-put (ns-empty)
                             "name" task-name)
                     "source" (ns-get result "source"))
             "candidates" (ns-get result "candidates"))
    false))


; ============================================================================
; Part 3: make-task — construct a task as SELPH data
; ============================================================================
; A task is a namespace with:
;   "name"  — human-readable identifier
;   "spec"  — list of (input, output) pairs for synthesis
;   "depth" — max AST depth for synthesis search

(defmacro make-task (name depth spec)
  (ns-put (ns-put (ns-put (ns-empty)
                           "name" name)
                   "depth" depth)
           "spec" spec))


; ============================================================================
; Part 4: solve-and-report — solve one task and print results
; ============================================================================
; Solves a task, prints status, and returns the result namespace.

(defmacro solve-and-report (task budget)
  (define task-name (ns-get task "name"))
  (define task-depth (ns-get task "depth"))
  (define task-spec (ns-get task "spec"))
  (print (concat "--- Solving: " task-name
                 " (depth=" (to-string task-depth)
                 ", budget=" (to-string budget) ")"))
  (define result (solve-task task-spec task-depth budget))
  (if (ns-get result "found")
    (print (concat "  SOLVED in "
                   (to-string (ns-get result "candidates"))
                   " candidates: "
                   (ns-get result "source")))
    (print (concat "  FAILED after "
                   (to-string (ns-get result "candidates"))
                   " candidates")))
  result)


; ============================================================================
; Part 5: Define the curriculum — a list of tasks in increasing difficulty
; ============================================================================

(define curriculum (list
  ; Level 0: Constants — should be trivially solvable
  (make-task "const_1" 2
    (list (list "4 1 1 1 1" 1)
          (list "5 1 1 1 1" 1)
          (list "6 1 1 1 1" 1)))

  (make-task "const_5" 2
    (list (list "4 5 5 5 5" 5)
          (list "5 5 5 5 5" 5)
          (list "6 5 5 5 5" 5)))

  ; Level 1: Arithmetic — requires accessing input components
  (make-task "identity" 2
    (list (list "4 0 1 2 3" 4)
          (list "5 1 2 3 4" 5)
          (list "6 2 3 4 5" 6)
          (list "7 3 4 5 6" 7)))

  (make-task "last_plus_1" 2
    (list (list "4 10 11 12 13" 14)
          (list "5 20 21 22 23" 24)
          (list "6 0 1 2 3" 4)
          (list "7 5 6 7 8" 9)))

  ; Level 2: Compositions — benefits from library built in earlier levels
  (make-task "fibonacci" 3
    (list (list "4 1 1 2 3" 5)
          (list "5 1 2 3 5" 8)
          (list "6 2 3 5 8" 13)
          (list "7 3 5 8 13" 21)))
))


; ============================================================================
; Part 6: Run the curriculum loop
; ============================================================================

(print "=== SELPH Curriculum Loop ===")
(print "")

; Solve each task in sequence and collect results
(define budget 50000)

(define results (map (lambda (task) (solve-and-report task budget))
                     curriculum))

; Count successes
(define solved-count (length (filter (lambda (r) (ns-get r "found"))
                                     results)))

(print "")
(print (concat "=== Results: " (to-string solved-count)
               "/" (to-string (length curriculum)) " tasks solved ==="))

; Collect promotions — these are the solutions that would become library macros
(define promotions
  (filter (lambda (p) (not (= p false)))
          (map (lambda (r)
                 (define task (head curriculum))  ; simplified — real version pairs with task
                 (promote-if-solved r "solution"))
               results)))

(print (concat "Promotable solutions: " (to-string (length promotions))))

; ============================================================================
; Part 7: What full self-hosting would look like (aspirational)
; ============================================================================
;
; With additional builtins, the curriculum loop could fully self-host:
;
; (defmacro run-curriculum (tasks budget)
;   ; Solve all tasks, promoting each solution into the live environment
;   (reduce (lambda (state task)
;     (define result (solve-and-report task budget))
;     (if (ns-get result "found")
;       ; NEEDS: eval-source to install the macro at runtime
;       ; (eval-source (concat "(defmacro " (ns-get task "name")
;       ;                      " (s) " (ns-get result "source") ")"))
;       (ns-put state "solved" (add 1 (ns-get state "solved")))
;       state))
;     (ns-put (ns-empty) "solved" 0)
;     tasks))
;
; Builtins needed for full self-hosting:
;   eval-source  — parse and evaluate a SELPH source string at runtime
;   load-file    — load a .selph file into the current environment
;   write-file   — write a string to a file (for persisting the library)
;   time-ms      — wall-clock time for budget management
;
; With these, the curriculum loop itself becomes a synthesizable target:
; we could synthesize better curriculum strategies by treating
; run-curriculum as a program whose fitness is "tasks solved per time."
; ============================================================================

(print "")
(print "Done. The curriculum loop itself is a SELPH program.")
