; --- Base library ---
; Sequence prediction helpers
; Input format: "idx v0 v1 v2 v3" (space-separated numbers)
; idx = position, v0-v3 = context window (v3 = most recent)

(defmacro idx (s)
  (to-number (head (string-split s " "))))

(defmacro v0 (s)
  (to-number (head (tail (string-split s " ")))))

(defmacro v1 (s)
  (to-number (head (tail (tail (string-split s " "))))))

(defmacro v2 (s)
  (to-number (head (tail (tail (tail (string-split s " ")))))))

(defmacro v3 (s)
  (to-number (head (tail (tail (tail (tail (string-split s " "))))))))

(defmacro last (s)
  (to-number (head (tail (tail (tail (tail (string-split s " "))))))))

; --- Promoted solutions ---
; const_1: found in 3 candidates
(defmacro const_1 (s) 1)

; const_5: found in 6 candidates
(defmacro const_5 (s) 5)

; identity: found in 322 candidates
(defmacro identity (s) (idx s))

; double_idx: found in 1937 candidates
(defmacro double_idx (s) (add (abs 2) (v3 s)))

; triple_idx: found in 1621 candidates
(defmacro triple_idx (s) (add (abs 1) (double_idx s)))

; last_plus_1: found in 1620 candidates
(defmacro last_plus_1 (s) (add (abs 1) (v3 s)))

; last_minus_1: found in 3920 candidates
(defmacro last_minus_1 (s) (add (negate 1) (v3 s)))

; triangular: found in 102960 candidates
(defmacro triangular (s) (add (idx s) (v3 s)))

; fibonacci: found in 104262 candidates
(defmacro fibonacci (s) (add (v2 s) (v3 s)))

; double_prev: found in 104587 candidates
(defmacro double_prev (s) (add (v2 s) (fibonacci s)))

; idx_plus_last: found in 335 candidates
(defmacro idx_plus_last (s) (triangular s))
