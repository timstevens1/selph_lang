; Direct synth probes for the g and h sub-specs from M6.

; g(u, t) = u·t + 0.125·t²  (kinematic_s with a_ref = 0.25)
(task-args "g_kinematic" 5
  ((0.5 0.5) 0.28125)
  ((0.5 1.5) 1.03125)
  ((1.5 0.5) 0.78125)
  ((1.5 1.5) 2.53125))

; h(a, t) = ½(a - 0.25)·t²  (kinematic_s with u_ref subtracted)
(task-args "h_kinematic" 5
  ((0.25 0.5) 0.0)
  ((0.25 1.5) 0.0)
  ((0.5  0.5) 0.03125)
  ((0.5  1.5) 0.28125))
