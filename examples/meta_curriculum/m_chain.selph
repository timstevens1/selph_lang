; ─────────────────────────────────────────────────────────────────────────
; M-stage chain dispatcher (§9.45 integration)
; ─────────────────────────────────────────────────────────────────────────
;
; Wires the M-stages M7, M8, M9, M10, M11, M12 into the synth_v2
; multi-arg dispatcher via the existing `__decomposers__` ns hook
; (synth_v2.rs:4750 `try_selph_decomposers`).
;
; This file MUST be loaded after the individual M-stage files. Each
; provides one detect-* entry point:
;
;   m7  → detect-library-shape       (n-ary library reuse)
;   m8  → detect-constant-shape      (forms 1, 2)
;   m9  → detect-unary-scale-shape   (form 2b)
;   m10 → detect-affine-shape        (form 3)
;   m11 → detect-product-shape       (forms 4, 5)
;   m12 → detect-structural-pair     (form S)
;
; The chain converts the synth_v2 spec format
;   (ns ("spec" (list-of-pairs)) ("max-depth" n) ("max-candidates" n))
; into the M-stage spec format
;   (ns ("inputs" ...) ("outputs" ...) ("arity" ...))
; runs each detector in cheap-to-expensive order, and returns the first
; match in the format synth_v2 expects:
;   (ns ("found" true) ("nodes" <Node>) ("candidates" n))

; ── Spec format conversion ───────────────────────────────────────────

(define m-chain-spec-from-synth
  (lambda (synth-spec)
    (let ((pairs (ns-get synth-spec "spec")))
      (let ((rows  (map head pairs))
            (outs  (map (lambda (p) (head (tail p))) pairs)))
        (let ((arity (if (list? (head rows)) (length (head rows)) 1)))
          ; §9.47.5: include test rows if present in the synth spec.
          ; The "test" key contains a list of (input, expected) pairs.
          (let ((test-pairs (try (ns-get synth-spec "test") (list))))
            (let ((test-inputs  (map head test-pairs))
                  (test-outputs (map (lambda (p) (head (tail p))) test-pairs)))
              (ns ("inputs"       rows)
                  ("outputs"      outs)
                  ("arity"        arity)
                  ("test-inputs"  test-inputs)
                  ("test-outputs" test-outputs)))))))))

; ── Result format conversion ─────────────────────────────────────────
;
; M-stage results carry the lambda Node under `source-node`. synth_v2's
; dispatcher (try_selph_decomposers) looks for `nodes`. Translate.

(define m-chain-mn-result-to-synth
  (lambda (mn-result)
    (if (ns-get mn-result "found")
      (ns ("found" true)
          ("nodes" (ns-get mn-result "source-node"))
          ("candidates" 1))
      (ns ("found" false)))))

; ── The chain ────────────────────────────────────────────────────────
;
; §9.47 P1: type-dispatched chain. The chain inspects the first row of
; spec outputs to decide whether to run the numeric branch (M8 → M9 →
; M10 → M12 → M11 → M7) or the string branch (M8s → M10s → M11s → M7).
; Library reuse (M7) is shape-agnostic and runs in both branches; the
; rest are domain-specialized recognizers per Path E in §9.46.4.
;
; Numeric ordering rationale (unchanged from §9.45):
; M8 (cheapest, single-pool scan) → M9 (unary-wrap, 7×) → M10
; (pairwise affine, pool²) → M12 (structural pair, pool²×28) → M11
; (product fit, pool²/³) → M7 (library reuse, only if libs exist).
;
; String ordering: M8s (constant + identity, single scan) → M10s
; (concat pair, pool²) → M11s (string-repeat, pool²) → M7. No M9s
; analogue is needed yet because the string unary catalog
; (upper/lower/reverse) lives inside m_pool_string's unary-l1 flag,
; and M10s consumes that pool — a wrap-then-concat shape gets
; recognized by M10s without a separate unary stage.

; Validate a detected source-node against held-out test pairs.
; Returns true if no test data or if the function passes all test pairs.
(define m-chain-validate-test
  (lambda (source-node spec)
    (let ((test-inputs  (try (ns-get spec "test-inputs") (list)))
          (test-outputs (try (ns-get spec "test-outputs") (list))))
      (if (= (length test-inputs) 0)
        true
        (let ((func (try (eval-node source-node) nil)))
          (if (nil? func)
            false
            (reduce
              (lambda (acc i)
                (and acc
                  (let ((got (try (func (nth test-inputs i)) nil)))
                    (and (not (nil? got))
                         (= got (nth test-outputs i))))))
              (range (length test-inputs))
              true)))))))

; Try one detector function and either return its synth-formatted
; result, or fall through to the next stage by calling `next-thunk`.
; §post: validates against held-out test pairs to prevent overfitting.
(define m-chain-try-or-next
  (lambda (detector spec next-thunk)
    (let ((r (detector spec)))
      (if (ns-get r "found")
        (if (m-chain-validate-test (ns-get r "source-node") spec)
          (m-chain-mn-result-to-synth r)
          (next-thunk))
        (next-thunk)))))

; ── Type detection ───────────────────────────────────────────────────
;
; Inspect the first output value to decide which branch handles this
; spec. Numeric (Int/Num) → numeric chain. String → string chain.
; Anything else falls through to "unknown" and the chain returns
; (found false), letting Flat enumeration take over.

(define m-chain-output-kind
  (lambda (spec)
    (let ((outs (ns-get spec "outputs")))
      (if (= (length outs) 0)
        "unknown"
        (let ((first-out (head outs)))
          (if (or (int? first-out) (num? first-out)) "numeric"
            (if (string? first-out) "string"
              (if (grid? first-out) "grid"
                "unknown"))))))))

; ── Numeric branch ───────────────────────────────────────────────────

(define m-chain-numeric
  (lambda (spec)
    (m-chain-try-or-next detect-constant-shape spec
      (lambda ()
        (m-chain-try-or-next detect-unary-scale-shape spec
          (lambda ()
            (m-chain-try-or-next detect-affine-shape spec
              (lambda ()
                (m-chain-try-or-next detect-structural-pair spec
                  (lambda ()
                    (m-chain-try-or-next detect-product-shape spec
                      (lambda ()
                        (m-chain-try-or-next detect-library-shape spec
                          (lambda () (ns ("found" false))))))))))))))))

; ── String branch ────────────────────────────────────────────────────

(define m-chain-string
  (lambda (spec)
    (m-chain-try-or-next detect-constant-string spec
      (lambda ()
        (m-chain-try-or-next detect-concat-pair spec
          (lambda ()
            (m-chain-try-or-next detect-string-repeat spec
              (lambda ()
                (m-chain-try-or-next detect-library-shape spec
                  (lambda () (ns ("found" false))))))))))))

; ── Grid branch (§9.48 P2) ──────────────────────────────────────────

(define m-chain-grid
  (lambda (spec)
    (m-chain-try-or-next detect-constant-grid spec
      (lambda ()
        (m-chain-try-or-next detect-symmetry-grid spec
          (lambda ()
            (m-chain-try-or-next detect-recolor spec
              (lambda ()
                (m-chain-try-or-next detect-line-draw spec
                  (lambda ()
                    (m-chain-try-or-next detect-proximity-recolor spec
                      (lambda ()
                        (m-chain-try-or-next detect-rectangular-hole-fill spec
                          (lambda ()
                            (m-chain-try-or-next detect-per-object spec
                              (lambda ()
                                (m-chain-try-or-next detect-template-stamp spec
                                  (lambda ()
                                    (m-chain-try-or-next detect-grid-compose spec
                                      (lambda ()
                                        (m-chain-try-or-next detect-library-shape spec
                                          (lambda () (ns ("found" false))))))))))))))))))))))))

; ── Top-level dispatcher ─────────────────────────────────────────────

(define m-chain-decomposer
  (lambda (synth-spec)
    (let ((spec (m-chain-spec-from-synth synth-spec)))
      (let ((kind (m-chain-output-kind spec)))
        (let ((result
                (if (= kind "numeric") (m-chain-numeric spec)
                  (if (= kind "string") (m-chain-string spec)
                    (if (= kind "grid") (m-chain-grid spec)
                      (ns ("found" false)))))))
          (do
            ; §9.66 journal hook: record every successful synthesis so
            ; future analysis can mine recurring structural patterns.
            ; Wrapped in `try` to make journaling fully opt-in — if
            ; m_journal.selph isn't loaded, journal-record! is undefined
            ; and the try silently no-ops.
            (if (try (ns-get result "found") false)
              (try
                (journal-record!
                  (journal-spec-signature synth-spec)
                  (ns-get result "nodes")
                  (concat "m-chain-" kind))
                nil)
              nil)
            result))))))

; ── Register as the global decomposer ────────────────────────────────
;
; synth_v2's `try_selph_decomposers` walks `__decomposers__` and calls
; each entry with the synth spec ns. We register one entry — the chain
; — under a single key.

(define __decomposers__
  (ns ("m-chain" m-chain-decomposer)))

; ── Bypass flag (opt-in) ─────────────────────────────────────────────
;
; Setting this binding tells synth_v2 to skip its own kernel-side
; data literal seeding and the affine-fit pass, leaving the SELPH
; chain as the sole post-enumeration fallback. Use this for the
; §9.45.6 validation gate; leave it unset for production runs that
; want both the kernel pass and the SELPH chain.

(define __bypass_kernel_affine__ true)

; ── Synth probe-skip list ────────────────────────────────────────────
;
; Tell synth_v2's `library_components_from_env` (synth_v2.rs:1117) to
; SKIP every M-stage helper currently in env. Without this, every
; call to `synthesize_args` triggers `probe_function_type` on each of
; the ~30 M-stage recognizers, and each probe runs a full
; `detect-*-shape` invocation on garbage input — turning a 1s task
; into a multi-minute hang.
;
; Implementation: walk `(env-functions)` AT CHAIN LOAD TIME and
; capture every function name as a string. Bind the result as
; `__synth_skip__`. synth_v2 reads this binding and merges it into
; the skip set. Library functions defined AFTER this binding (like
; physics task solutions bound by grow-v2) are NOT in the snapshot
; and remain discoverable.

(define __synth_skip__
  (ns-keys (env-functions)))
