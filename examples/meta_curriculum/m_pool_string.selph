; ─────────────────────────────────────────────────────────────────────────
; m_pool_string: string-domain pool builder (§9.47 P1)
; ─────────────────────────────────────────────────────────────────────────
;
; Path E from §9.46.4: type-dependent pools. The numeric `make-pool`
; (m_pool.selph) operates on Int/Num cols and a numeric unary catalog
; (sqrt/log/exp/...). This file is the parallel string-typed pool
; builder. Same flag interface, same pool entry shape, same skip-set
; integration — only the value type and the unary catalog differ.
;
; Pool entry shape (unchanged from m_pool):
;
;   (ns ("source" Node)        ; AST node for the expression
;       ("col"    list-of-str) ; behavior column over spec inputs
;       ("kind"   string))     ; tag for diagnostics
;
; Flags (in the flags ns):
;
;   "unary-l1"     — single-level unary wraps (string-upper/lower/reverse)
;   "unary-l2"     — second-level wraps over L1 entries
;   "libs"         — library function calls returning strings
;   "constants"    — string atoms extracted via m13's extract-data-atoms
;   "suffixes"     — boolean derived entries: does each base atom end
;                    in -ing, -ed, -s, -er, -est, -ly, -tion ?
;                    (§9.47.3 word-internal features)
;   "prefixes"     — boolean derived entries: does each base atom start
;                    with un-, re-, dis-, pre- ? (§9.47.3)
;   "capital"      — boolean derived entry per atom: is the first char
;                    uppercase? Useful for proper-noun detection. (§9.47.3)
;   "numeric"      — include numeric (Int/Num) input positions as atoms
;                    alongside string atoms. Enables sequence-position
;                    arithmetic shapes via m8s Form 5. (§9.47.3)
;
; Defaults: all false. Detect-* must opt in.
;
; "products" is intentionally omitted: there's no string × string → string
; analogue worth keeping in the pool. Concat is the affine analogue and
; lives inside detect-concat-pair, not in the pool itself.

; ── Spec helpers ─────────────────────────────────────────────────────

(define m-pool-str-spec-inputs  (lambda (s) (ns-get s "inputs")))
(define m-pool-str-spec-outputs (lambda (s) (ns-get s "outputs")))
(define m-pool-str-spec-arity   (lambda (s) (ns-get s "arity")))

; ── Type predicates ──────────────────────────────────────────────────

(define m-pool-str? (lambda (v) (string? v)))

(define m-pool-str-all-strings?
  (lambda (col)
    (reduce (lambda (acc v) (and acc (m-pool-str? v))) col true)))

(define m-pool-str-flag?
  (lambda (flags key)
    (if (ns-has flags key)
      (= (ns-get flags key) true)
      false)))

; ── Pool entry constructor ───────────────────────────────────────────

(define m-pool-str-entry
  (lambda (source col kind)
    (ns ("source" source) ("col" col) ("kind" kind))))

(define m-pool-str-entry-source (lambda (e) (ns-get e "source")))
(define m-pool-str-entry-col    (lambda (e) (ns-get e "col")))
(define m-pool-str-entry-kind   (lambda (e) (ns-get e "kind")))

; ── Unary op catalogue (string version) ──────────────────────────────
;
; Three string-preserving unary ops. string-trim is omitted because it
; depends on whitespace presence — would be a no-op on most data and
; just bloat the pool. char-code/code-char produce ints, not strings,
; so they don't belong in this catalogue (they'd be in a string→int
; cross-type catalogue, deferred per §9.46.5).

(define m-pool-str-unary-ops
  (list
    (list "string-upper"   (lambda (v) (string-upper v)))
    (list "string-lower"   (lambda (v) (string-lower v)))
    (list "string-reverse" (lambda (v) (string-reverse v)))))

; ── Level 0: indexed string atoms ────────────────────────────────────
;
; For each input position, build `(nth x i)` and the column of that
; position's values across spec rows. Filter to positions whose first
; row value is a string — mixed-type spec rows skip non-string slots.

(define m-pool-str-l0
  (lambda (s)
    (let ((arity (m-pool-str-spec-arity s))
          (inputs (m-pool-str-spec-inputs s)))
      (filter (lambda (e) (not (nil? e)))
        (map
          (lambda (i)
            (let ((col (map (lambda (row) (nth row i)) inputs)))
              (if (m-pool-str-all-strings? col)
                (m-pool-str-entry
                  (make-app "nth" (make-symbol "x") (make-int i))
                  col
                  "atom")
                nil)))
          (range arity))))))

; Predicate: every value in col is Int or Num. Used by the L0
; numeric builder to filter to numeric input positions.
(define m-pool-str-all-numeric?
  (lambda (col)
    (reduce (lambda (acc v) (and acc (or (int? v) (num? v)))) col true)))

; L0 numeric atoms: for each input position whose values are all
; numeric (int or num), build an indexed atom. Output kind tag is
; "numeric-atom" so detect-* can distinguish from string atoms by
; pool entry kind without inspecting columns.
(define m-pool-str-l0-numeric
  (lambda (s)
    (let ((arity (m-pool-str-spec-arity s))
          (inputs (m-pool-str-spec-inputs s)))
      (filter (lambda (e) (not (nil? e)))
        (map
          (lambda (i)
            (let ((col (map (lambda (row) (nth row i)) inputs)))
              (if (m-pool-str-all-numeric? col)
                (m-pool-str-entry
                  (make-app "nth" (make-symbol "x") (make-int i))
                  col
                  "numeric-atom")
                nil)))
          (range arity))))))

; ── Unary wraps ──────────────────────────────────────────────────────
;
; For each entry × each unary op, build the wrapped entry. The wrapped
; col must remain all-string (string-upper/lower/reverse all preserve
; string type, so this is automatic). `try` guards against any
; primitive that errors on a malformed input — defensive but rare.

(define m-pool-str-wrap-entry
  (lambda (entry op-pair)
    (let ((op-name (head op-pair))
          (op-fn (head (tail op-pair))))
      (let ((wrapped-col (try (map op-fn (m-pool-str-entry-col entry)) nil)))
        (if (or (nil? wrapped-col) (not (m-pool-str-all-strings? wrapped-col)))
          nil
          (m-pool-str-entry
            (make-app op-name (m-pool-str-entry-source entry))
            wrapped-col
            (concat "wrap-" op-name)))))))

(define m-pool-str-unary-wraps
  (lambda (entries)
    (filter (lambda (e) (not (nil? e)))
      (reduce append
        (map (lambda (entry)
               (map (lambda (op) (m-pool-str-wrap-entry entry op))
                    m-pool-str-unary-ops))
             entries)
        (list)))))

; ── Library function calls ───────────────────────────────────────────
;
; Mirrors m_pool's m-pool-libs but filters columns to all-string. Any
; library function whose output column is non-string for any row is
; rejected (we only want pool entries that satisfy the string-fit
; primitives). Skip set integration is the same as the numeric pool.

(define m-pool-str-safe-apply
  (lambda (f arg-list)
    (try (apply f arg-list) nil)))

(define m-pool-str-effective-arity
  (lambda (lib-fn parent-inputs)
    (let ((sample-row (head parent-inputs)))
      (if (list? sample-row)
        (let ((max-k (length sample-row)))
          (reduce
            (lambda (acc i)
              (if (not (nil? acc))
                acc
                (let ((k (+ i 1)))
                  (let ((sublist (slice sample-row 0 k)))
                    (let ((res (m-pool-str-safe-apply lib-fn (list sublist))))
                      (if (nil? res) nil k))))))
            (range max-k)
            nil))
        nil))))

(define m-pool-str-ordered-tuples
  (lambda (n k)
    (if (= k 0)
      (list (list))
      (let ((shorter (m-pool-str-ordered-tuples n (- k 1))))
        (reduce append
          (map
            (lambda (tup)
              (map
                (lambda (i) (cons i tup))
                (filter
                  (lambda (i) (not (contains tup i)))
                  (range n))))
            shorter)
          (list))))))

(define m-pool-str-build-lib-call
  (lambda (lib-name positions)
    (let ((nth-args (map (lambda (i) (make-app "nth" (make-symbol "x") (make-int i))) positions)))
      (let ((list-node (apply make-app (cons (make-symbol "list") nth-args))))
        (make-app lib-name list-node)))))

(define m-pool-str-lib-column
  (lambda (lib-fn positions inputs)
    ; §9.47.5: wrap the entire column-building map in `try` so that
    ; library functions that error on some input rows (e.g., nth out
    ; of bounds when arity doesn't match) don't crash the pool builder.
    ; Without this, one bad library function kills the entire chain.
    (let ((cols (try
                  (map
                    (lambda (row)
                      (let ((sub (map (lambda (p) (nth row p)) positions)))
                        (m-pool-str-safe-apply lib-fn (list sub))))
                    inputs)
                  nil)))
      (if (nil? cols)
        nil
        (if (reduce (lambda (acc v) (and acc (and (not (nil? v)) (m-pool-str? v))))
                    cols true)
          cols
          nil)))))

(define m-pool-str-skip-set
  (lambda ()
    (try __synth_skip__ (list))))

(define m-pool-str-in-skip?
  (lambda (name)
    (contains (m-pool-str-skip-set) name)))

(define m-pool-str-libs
  (lambda (s)
    (let ((parent-arity (m-pool-str-spec-arity s))
          (inputs (m-pool-str-spec-inputs s)))
      (let ((lib-names
              (filter (lambda (n) (not (m-pool-str-in-skip? n)))
                      (ns-keys (env-functions)))))
        (reduce append
          (map
            (lambda (name)
              (let ((lib-fn (ns-get (env-functions) name)))
                (let ((eff-arity (m-pool-str-effective-arity lib-fn inputs)))
                  (if (or (nil? eff-arity) (> eff-arity parent-arity))
                    (list)
                    (let ((tuples (m-pool-str-ordered-tuples parent-arity eff-arity)))
                      (filter (lambda (e) (not (nil? e)))
                        (map
                          (lambda (positions)
                            (let ((col (m-pool-str-lib-column lib-fn positions inputs)))
                              (if (nil? col)
                                nil
                                ; §9.47.6: skip degenerate columns (constant across
                                ; all rows). A library function that maps every input
                                ; to the same output can't discriminate anything —
                                ; it's noise in the pool, especially for Form 6's
                                ; O(pool²) pair iteration.
                                (if (<= (length (m-pool-str-dedup col)) 1)
                                  nil
                                  (m-pool-str-entry
                                    (m-pool-str-build-lib-call name positions)
                                    col
                                    (concat "lib-" name))))))
                          tuples)))))))
            lib-names)
          (list))))))

; ── String constants from data atoms ─────────────────────────────────
;
; Reuse M13's extract-data-atoms — it already supports strings via
; primitive?. Filter the result to strings only and emit one pool
; entry per unique string with a constant column.
;
; Also seed two baseline string constants ("" and " ") because they
; almost never appear directly in spec rows but are extremely common
; in fit results — separators are the string analogue of the numeric
; baseline {0, 1, -1, 2}.

(define m-pool-str-baseline-constants (list "" " "))

(define m-pool-str-dedup
  (lambda (xs)
    (reduce
      (lambda (acc x)
        (if (contains acc x) acc (append acc (list x))))
      xs
      (list))))

(define m-pool-str-constants
  (lambda (s)
    (let ((n-rows (length (m-pool-str-spec-inputs s)))
          (data-atoms (extract-data-atoms s)))
      (let ((string-atoms
              (m-pool-str-dedup
                (append
                  m-pool-str-baseline-constants
                  (filter m-pool-str? data-atoms)))))
        (map
          (lambda (s-val)
            (m-pool-str-entry
              (make-str s-val)
              (map (lambda (_) s-val) (range n-rows))
              (concat "const-" s-val)))
          string-atoms)))))

; ── Word-internal feature catalogues (§9.47.3) ───────────────────────
;
; Each catalogue is a list of (predicate-name, suffix/prefix-string)
; pairs. The pool builder iterates over (base-atom × catalogue) and
; emits one boolean derived entry per combination. The derived
; column has type list-of-bool; multi-classify and pair-classify
; consume bool columns natively via the same `=` and `contains`
; logic that handles strings.

(define m-pool-str-suffix-catalogue
  (list
    "ing" "ed" "s" "er" "est" "ly" "tion"))

(define m-pool-str-prefix-catalogue
  (list
    "un" "re" "dis" "pre"))

; True iff the first character of `s` is uppercase ASCII (A-Z, code
; 65-90). Used by the `capital` flag's derived entries.
(define m-pool-str-first-upper?
  (lambda (s)
    (if (= (string-length s) 0)
      false
      (let ((c (char-code (string-take s 1))))
        (and (>= c 65) (<= c 90))))))

; Build a derived boolean entry from a base entry and a (op-name,
; argument-string) pair. The op-name is a string-* builtin that
; takes (string, string) → bool, e.g. "string-ends-with".

(define m-pool-str-derived-affix
  (lambda (entry op-name affix)
    (let ((wrapped-col
            (try
              (map (lambda (v)
                     (if (= op-name "string-ends-with")
                       (string-ends-with v affix)
                       (string-starts-with v affix)))
                   (m-pool-str-entry-col entry))
              nil)))
      (if (nil? wrapped-col)
        nil
        (m-pool-str-entry
          (make-app op-name
            (m-pool-str-entry-source entry)
            (make-str affix))
          wrapped-col
          (concat (concat op-name "-") affix))))))

; All suffix-derived entries for one base atom: one entry per
; suffix in the catalogue.
(define m-pool-str-suffix-entries
  (lambda (entry)
    (filter (lambda (e) (not (nil? e)))
      (map (lambda (suf)
             (m-pool-str-derived-affix entry "string-ends-with" suf))
           m-pool-str-suffix-catalogue))))

(define m-pool-str-prefix-entries
  (lambda (entry)
    (filter (lambda (e) (not (nil? e)))
      (map (lambda (pre)
             (m-pool-str-derived-affix entry "string-starts-with" pre))
           m-pool-str-prefix-catalogue))))

; The capital flag emits one derived entry per base atom: a column
; whose value is `true` for rows where the atom's first char is
; uppercase. The source AST is a comparison wrapping char-code, so
; the synthesized lambda evaluates the same predicate at runtime.
;
; AST shape: (if (>= (char-code (string-take e 1)) 65)
;              (if (<= (char-code (string-take e 1)) 90) true false)
;              false)
;
; NOTE: can't use `(make-app "and" ...)` because eval_v2 treats `and`
; as a SpecialApp, not a regular App. The SpecialApp form is
; constructed during tree conversion (convert_tree), not by make-app.
; Using nested make-if instead avoids the mismatch.
(define m-pool-str-capital-entry
  (lambda (entry)
    (let ((wrapped-col
            (try
              (map m-pool-str-first-upper?
                   (m-pool-str-entry-col entry))
              nil)))
      (if (nil? wrapped-col)
        nil
        (let ((take1 (make-app "string-take"
                       (m-pool-str-entry-source entry)
                       (make-int 1))))
          (let ((char-code-node (make-app "char-code" take1)))
            (m-pool-str-entry
              (make-if
                (make-app ">=" char-code-node (make-int 65))
                (make-if
                  (make-app "<=" char-code-node (make-int 90))
                  (make-bool true)
                  (make-bool false))
                (make-bool false))
              wrapped-col
              "first-upper")))))))

(define m-pool-str-capital-entries
  (lambda (entries)
    (filter (lambda (e) (not (nil? e)))
      (map m-pool-str-capital-entry entries))))

(define m-pool-str-derived-features
  (lambda (entries flags)
    (let ((with-suffixes
            (if (m-pool-str-flag? flags "suffixes")
              (reduce append (map m-pool-str-suffix-entries entries) (list))
              (list))))
      (let ((with-prefixes
              (if (m-pool-str-flag? flags "prefixes")
                (append with-suffixes
                  (reduce append (map m-pool-str-prefix-entries entries) (list)))
                with-suffixes)))
        (let ((with-capital
                (if (m-pool-str-flag? flags "capital")
                  (append with-prefixes (m-pool-str-capital-entries entries))
                  with-prefixes)))
          with-capital)))))

; ── Top-level: make-pool-string ──────────────────────────────────────
;
; Build a string pool with the requested levels and inclusions. The
; assembly order matters — L1/L2 wraps depend on what's already in
; the pool, so flags must be applied in dependency order.

(define make-pool-string
  (lambda (s flags)
    (let ((base (m-pool-str-l0 s)))
      (let ((with-unary-l1
              (if (m-pool-str-flag? flags "unary-l1")
                (append base (m-pool-str-unary-wraps base))
                base)))
        (let ((with-unary-l2
                (if (m-pool-str-flag? flags "unary-l2")
                  (let ((l1-wraps
                          (filter
                            (lambda (e)
                              (let ((k (m-pool-str-entry-kind e)))
                                (and (>= (string-length k) 5)
                                     (= (string-take k 5) "wrap-"))))
                            with-unary-l1)))
                    (append with-unary-l1 (m-pool-str-unary-wraps l1-wraps)))
                  with-unary-l1)))
          (let ((with-libs
                  (if (m-pool-str-flag? flags "libs")
                    (append with-unary-l2 (m-pool-str-libs s))
                    with-unary-l2)))
            (let ((with-constants
                    (if (m-pool-str-flag? flags "constants")
                      (append with-libs (m-pool-str-constants s))
                      with-libs)))
              ; §9.47.3: word-internal derived features. The features
              ; are computed from the BASE atoms only (not from
              ; unary-wrapped or library-derived entries) — running
              ; suffix predicates on (string-upper x) for example
              ; would give equivalent information at higher cost.
              (let ((with-derived
                      (append with-constants
                        (m-pool-str-derived-features base flags))))
                ; §9.47.3 numeric atoms — opt-in via the "numeric"
                ; flag. Adds atoms for any input position whose values
                ; are all int/num. Used by m8s Form 5 (sequence-position
                ; arithmetic) to discover ordering shapes like
                ; "if target_idx < verb_idx then subject else object".
                (let ((with-numeric
                        (if (m-pool-str-flag? flags "numeric")
                          (append with-derived (m-pool-str-l0-numeric s))
                          with-derived)))
                  with-numeric)))))))))

; ── Smoke test ───────────────────────────────────────────────────────

(define m-pool-str-test-spec
  (ns ("inputs"  (list (list "hello" "world") (list "foo" "bar") (list "abc" "xyz")))
      ("outputs" (list "hello world" "foo bar" "abc xyz"))
      ("arity"   2)))

(print "─── m_pool_string smoke test ───")
(print (concat "  L0 only: "
               (to-string (length (make-pool-string m-pool-str-test-spec (ns))))
               " entries"))
(print (concat "  +unary-l1: "
               (to-string (length (make-pool-string m-pool-str-test-spec
                                    (ns ("unary-l1" true)))))
               " entries"))
(print (concat "  +constants: "
               (to-string (length (make-pool-string m-pool-str-test-spec
                                    (ns ("unary-l1" true) ("constants" true)))))
               " entries"))
(print (concat "  +suffixes: "
               (to-string (length (make-pool-string m-pool-str-test-spec
                                    (ns ("suffixes" true)))))
               " entries"))
(print (concat "  +suffixes+prefixes+capital: "
               (to-string (length (make-pool-string m-pool-str-test-spec
                                    (ns ("suffixes" true) ("prefixes" true) ("capital" true)))))
               " entries"))
