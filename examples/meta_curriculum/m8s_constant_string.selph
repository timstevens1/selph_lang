; ─────────────────────────────────────────────────────────────────────────
; Meta-curriculum M8s: constant-string fit (§9.47 P1 + P1.5)
; ─────────────────────────────────────────────────────────────────────────
;
; String analogue of m8_constant_fit.selph. Recognizes three shapes:
;
;   Form 1:  target == "constant"      (every output equal)
;   Form 2:  target == g(x)            (output is exactly some pool entry's
;                                       column — the string analogue of
;                                       fit-scale with C=1, since strings
;                                       have no scalar multiplication)
;   Form 3:  target == if (contains <set-A> g(x)) then "label-A" else "label-B"
;            (binary classification by atom membership — added §9.47 P1.5
;            to handle context-sensitive POS tagging where the output is
;            one of two labels determined by which set the discriminating
;            atom falls into)
;
; The string equivalent of M8's fit-affine doesn't exist as a closed-form
; solver — instead each form is its own dedicated check.

; ── Helpers ──────────────────────────────────────────────────────────

(define m8s-spec-outputs (lambda (s) (ns-get s "outputs")))

(define m8s-str? (lambda (v) (string? v)))

(define m8s-cols-equal?
  (lambda (xs ys)
    (if (= (length xs) (length ys))
      (reduce
        (lambda (acc pair) (and acc (= (head pair) (head (tail pair)))))
        (zip xs ys)
        true)
      false)))

(define m8s-string-target
  (lambda (s)
    (let ((outs (m8s-spec-outputs s)))
      (if (reduce (lambda (acc v) (and acc (m8s-str? v))) outs true)
        outs
        nil))))

; ── fit-constant-string primitive ────────────────────────────────────
;
; If every value in target equals the head, return that constant.
; Otherwise return nil. The empty-target case returns nil — a vacuous
; success would emit code that we can't validate against any input.

(define fit-constant-string
  (lambda (target)
    (if (= (length target) 0)
      nil
      (let ((c (head target)))
        (if (reduce (lambda (acc v) (and acc (= v c))) target true)
          c
          nil)))))

; ── Pool builder ─────────────────────────────────────────────────────
;
; M8s consults the L0 pool plus unary-l1 wraps for Forms 2-4, plus
; the §9.47.3 word-internal derived features (suffixes, prefixes,
; capital) for Forms 3-6 to discriminate by morphological features.
; Form 1 doesn't consult the pool at all.
;
; Pool size for typical 2-arg specs: 2 base + 6 unary wraps + 14
; suffix entries + 8 prefix entries + 2 capital entries = ~32
; entries. Cost per task is still trivial (Form 4 pair-iteration is
; ~32² = 1024 fits, each fit linear in row count).

(define m8s-build-pool
  (lambda (s)
    (make-pool-string s
      (ns ("unary-l1" true)
          ("suffixes" true)
          ("prefixes" true)
          ("capital"  true)
          ("numeric"  true)
          ("libs"     true)))))

(define m8s-pool-source (lambda (e) (ns-get e "source")))
(define m8s-pool-col    (lambda (e) (ns-get e "col")))
(define m8s-pool-kind   (lambda (e) (ns-get e "kind")))

; Pool-entry kind priorities for the recursive classifier. Boolean
; derived features (suffix/prefix/capital) come first since they
; generalize best; literal atoms last to avoid memorization.
(define m8s-pool-priority-order
  (list "string-ends-with" "string-starts-with" "first-upper"
        "lib-" "atom" "numeric-atom" "wrap-" "const-"))

(define m8s-kind-matches-prefix?
  (lambda (kind pfx)
    (if (>= (string-length kind) (string-length pfx))
      (= (string-take kind (string-length pfx)) pfx)
      false)))

(define m8s-prioritize-pool
  (lambda (pool)
    (let ((buckets
            (map (lambda (pfx)
                   (filter (lambda (e) (m8s-kind-matches-prefix? (m8s-pool-kind e) pfx))
                           pool))
                 m8s-pool-priority-order)))
      (reduce append buckets (list)))))

; ── fit-multi-classify primitive ─────────────────────────────────────
;
; Generalized partition recognizer. For pool column e-col and target
; output column, check whether e-col cleanly partitions the rows by
; output label. Returns (ns ("labels" ...) ("vals-by-label" ...)) on
; success or nil on failure.
;
; A "clean partition" means: for every pair of distinct output labels
; (l1, l2), the set of e-values appearing in label-l1 rows is disjoint
; from the set appearing in label-l2 rows. If any e-value appears in
; rows of two different labels, the atom doesn't discriminate.
;
; Cap on k: at most 4 distinct labels. Beyond that the emitted
; if-chain becomes unwieldy and the search cost rises faster than
; the value (real curricula past 4 labels usually want a different
; encoding, like one-hot output).
;
; The canonical use case is POS tagging by previous-word membership:
;   "i run"   → e-col[0] = "i",   target = "verb"
;   "the run" → e-col[1] = "the", target = "noun"
; The value sets {"i", "they", ...} and {"the", "a", ...} are
; disjoint, so prev-word is a clean discriminator.

(define m8s-distinct-labels
  (lambda (target)
    (reduce
      (lambda (acc v)
        (if (contains acc v) acc (append acc (list v))))
      target
      (list))))

(define m8s-vals-for-label
  (lambda (e-col target label)
    (reduce
      (lambda (acc i)
        (let ((row-label (nth target i))
              (row-val (nth e-col i)))
          (if (= row-label label)
            (if (contains acc row-val) acc (append acc (list row-val)))
            acc)))
      (range (length target))
      (list))))

(define m8s-disjoint?
  (lambda (xs ys)
    (reduce
      (lambda (acc x) (and acc (not (contains ys x))))
      xs
      true)))

; All pairs of distinct elements from a list (i < j ordering).
(define m8s-distinct-pairs
  (lambda (xs)
    (let ((n (length xs)))
      (reduce append
        (map
          (lambda (i)
            (map (lambda (j) (list (nth xs i) (nth xs j)))
                 (filter (lambda (j) (> j i)) (range n))))
          (range n))
        (list)))))

; Check that the partition implied by `vals-by-label` is clean: every
; pair of label-value sets is disjoint. `vals-by-label` is a list of
; lists (parallel to `labels`) — vals-by-label[i] is the set of
; e-col values appearing in label-i rows.
(define m8s-partition-clean?
  (lambda (vals-by-label)
    (let ((index-pairs (m8s-distinct-pairs (range (length vals-by-label)))))
      (reduce
        (lambda (acc pair)
          (and acc
               (m8s-disjoint?
                 (nth vals-by-label (head pair))
                 (nth vals-by-label (head (tail pair))))))
        index-pairs
        true))))

(define fit-multi-classify
  (lambda (e-col target)
    (let ((labels (m8s-distinct-labels target)))
      (if (or (< (length labels) 2) (> (length labels) 4))
        nil
        (let ((vals-by-label
                (map (lambda (l) (m8s-vals-for-label e-col target l)) labels)))
          (if (m8s-partition-clean? vals-by-label)
            (ns ("labels" labels) ("vals-by-label" vals-by-label))
            nil))))))

; Backwards-compat alias kept for the smoke test.
(define fit-binary-classify fit-multi-classify)

; ── Recursive partial-match helpers (replaces hard-coded Form 6) ─────
;
; The recursive classifier discovers conjunction patterns by:
;   1. Finding a pool entry that cleanly separates AT LEAST ONE label
;      (a "partial discriminator") from the rest.
;   2. Peeling off the cleanly-separated labels into an if-contains
;      chain.
;   3. Recursing on the remaining (ambiguous) rows.
;
; This subsumes Form 6 (2-feature conjunction) and extends to arbitrary
; feature depth — a 3-feature task that Form 6 cannot represent solves
; trivially via 3 levels of recursion.

; Project a column to a subset of row indices.
(define m8s-project-col
  (lambda (col indices)
    (map (lambda (i) (nth col i)) indices)))

; Union the value lists for all labels EXCEPT the one at index `excl`.
; Returns a deduped list.
(define m8s-union-vals-except
  (lambda (vals-by-label excl)
    (reduce
      (lambda (acc i)
        (if (= i excl)
          acc
          (reduce
            (lambda (a v) (if (contains a v) a (append a (list v))))
            (nth vals-by-label i)
            acc)))
      (range (length vals-by-label))
      (list))))

; Group partition: discovers any feature that splits the labels into
; 2+ disjoint groups based on connected-component analysis of label
; signatures (a label's "signature" is the set of feature values it
; appears with).
;
; Two labels are LINKED if their signatures share any value (i.e.,
; some row has feature value v with label L1 AND some row has feature
; value v with label L2 — meaning v alone can't determine the label).
; Connected components are the partition groups.
;
; This subsumes the simpler "peel single label" pattern: a label whose
; signature is disjoint from all others forms a singleton group.
;
; Examples:
;   verb_form ends-in-ing: groups are [{gerund}, {past, base}]
;     (gerund's sig={true} disjoint from past's sig={false} = base's sig)
;   gerund_context ends-in-ing: groups are [{gerund-noun, verb-progressive},
;                                           {common-noun, other}]
;     (gerund-noun and verb-progressive both have sig={true})
;
; Returns nil if only 1 group (no useful split). Returns a namespace
; with groups, group-vals, group-rows on a partition.

; Get the signature of a label = set of feature values appearing in
; rows with that label.
(define m8s-label-sig
  (lambda (e-col target label)
    (m8s-vals-for-label e-col target label)))

; Compute combined signature for a group of labels.
(define m8s-dedup-list
  (lambda (xs)
    (reduce
      (lambda (acc x) (if (contains acc x) acc (append acc (list x))))
      xs (list))))

(define m8s-group-sig
  (lambda (group e-col target)
    (m8s-dedup-list
      (reduce append
        (map (lambda (l) (m8s-label-sig e-col target l)) group)
        (list)))))

; Two label-groups are linked if their signatures share at least one
; feature value (transitive: if any pair of labels across the groups
; share a value).
(define m8s-groups-linked?
  (lambda (g1 g2 e-col target)
    (not (m8s-disjoint?
           (m8s-group-sig g1 e-col target)
           (m8s-group-sig g2 e-col target)))))

; Find the first (i, j) pair (i < j) of linked groups, or nil.
(define m8s-find-link
  (lambda (groups e-col target)
    (let ((n (length groups)))
      (reduce
        (lambda (acc i)
          (if (not (nil? acc)) acc
            (reduce
              (lambda (acc2 j)
                (if (not (nil? acc2)) acc2
                  (if (<= j i) nil
                    (if (m8s-groups-linked?
                          (nth groups i) (nth groups j) e-col target)
                      (list i j) nil))))
              (range n) nil)))
        (range n) nil))))

; Merge groups at positions i and j into one combined group. The merged
; group goes at the end; the originals are removed.
(define m8s-merge-at
  (lambda (groups i j)
    (let ((merged (append (nth groups i) (nth groups j))))
      (let ((kept-indices
              (filter (lambda (k) (not (or (= k i) (= k j))))
                      (range (length groups)))))
        (append
          (map (lambda (k) (nth groups k)) kept-indices)
          (list merged))))))

; Iteratively merge until no two groups share any feature value.
(define m8s-fixpoint-merge
  (lambda (groups e-col target)
    (let ((link (m8s-find-link groups e-col target)))
      (if (nil? link) groups
        (m8s-fixpoint-merge
          (m8s-merge-at groups (head link) (head (tail link)))
          e-col target)))))

; The main partition function. Returns nil (no useful split) or a
; namespace with the groups, their value sets, and their row indices.
;
; Label cap: 8. Above this, the pool space + recursion explodes.
(define fit-partial-classify
  (lambda (e-col target)
    (let ((labels (m8s-distinct-labels target)))
      (if (or (< (length labels) 2) (> (length labels) 8))
        nil
        (let ((distinct-vals (m8s-dedup-list e-col)))
          (if (<= (length distinct-vals) 1)
            nil  ; constant feature column — no split possible
            (let ((initial (map (lambda (l) (list l)) labels)))
              (let ((groups (m8s-fixpoint-merge initial e-col target)))
                (if (<= (length groups) 1)
                  nil  ; All labels merged into one group → no partition
                  (let ((group-vals
                          (map (lambda (g) (m8s-group-sig g e-col target))
                               groups))
                        (group-rows
                          (map (lambda (g)
                                 (filter
                                   (lambda (i) (contains g (nth target i)))
                                   (range (length target))))
                               groups)))
                    (ns ("groups" groups)
                        ("group-vals" group-vals)
                        ("group-rows" group-rows))))))))))))

; Build (if (contains g1-vals e) <body1>
;        (if (contains g2-vals e) <body2>
;          ... <last-body>))
; The last group is the else fall-through (no test).
(define m8s-build-group-chain
  (lambda (e-source group-vals sub-bodies)
    (if (= (length group-vals) 1)
      (head sub-bodies)
      (make-if
        (make-app "contains"
          (m8s-emit-value-list (head group-vals))
          e-source)
        (head sub-bodies)
        (m8s-build-group-chain
          e-source (tail group-vals) (tail sub-bodies))))))

; ── Source emission ──────────────────────────────────────────────────

(define m8s-wrap-lambda
  (lambda (body) (make-lambda (list "x") body)))

(define m8s-emit-bare
  (lambda (c)
    (m8s-wrap-lambda (make-str c))))

(define m8s-emit-atom
  (lambda (g-source)
    (m8s-wrap-lambda g-source)))

; Polymorphic value-to-Node converter. Dispatches on runtime type so
; the emit works for string atoms (Form 3 on base atoms) AND for
; boolean derived features (Form 3 on suffix/prefix predicates from
; the §9.47.3 word-internal feature pool). Without the bool case,
; emitting an if-contains test on a derived feature column would
; crash with "make-str: expected string, got Bool(true)".
(define m8s-value-to-node
  (lambda (v)
    (if (string? v) (make-str v)
      (if (bool? v) (make-bool v)
        (if (int? v) (make-int v)
          (if (num? v) (make-num v)
            (error (concat "m8s-value-to-node: unsupported value type for "
                           (to-string v)))))))))

; Build a `(list v0 v1 ...)` AST node from a list of values, picking
; the right make-* per value type. Used by the multi-classify emit
; when building the literal value-set list.
(define m8s-emit-value-list
  (lambda (vs)
    (let ((nodes (map m8s-value-to-node vs)))
      (apply make-app (cons (make-symbol "list") nodes)))))

; Backwards-compat alias.
(define m8s-emit-string-list m8s-emit-value-list)

; Build a chain of nested ifs that emit the multi-classify decision
; tree. For k labels [l1, l2, l3, ..., lk] with value sets
; [v1, v2, ..., vk-1] (the last label is the else fall-through):
;
;   (if (contains v1 e) l1
;     (if (contains v2 e) l2
;       (if (contains v3 e) l3 ... lk-1)))
;
; The last label is emitted as the else of the deepest if. With k=2
; this collapses to a single if — same shape as the original
; binary-classify emit.
(define m8s-build-classify-chain
  (lambda (e-source labels vals-by-label)
    (let ((k (length labels)))
      (if (= k 1)
        (make-str (head labels))
        (make-if
          (make-app "contains"
            (m8s-emit-string-list (head vals-by-label))
            e-source)
          (make-str (head labels))
          (m8s-build-classify-chain
            e-source
            (tail labels)
            (tail vals-by-label)))))))

(define m8s-emit-multi-classify
  (lambda (e-source labels vals-by-label)
    (m8s-wrap-lambda
      (m8s-build-classify-chain e-source labels vals-by-label))))

; ── Detection ────────────────────────────────────────────────────────

(define m8s-try-form-1
  (lambda (target)
    (let ((c (fit-constant-string target)))
      (if (nil? c)
        nil
        (ns ("kind" "form-1-string") ("c" c)
            ("source-node" (m8s-emit-bare c)))))))

(define m8s-try-form-2
  (lambda (pool target)
    (reduce
      (lambda (acc entry)
        (if (not (nil? acc)) acc
          (if (m8s-cols-equal? (m8s-pool-col entry) target)
            (ns ("kind" "form-2-string")
                ("source-node" (m8s-emit-atom (m8s-pool-source entry))))
            nil)))
      pool
      nil)))

; Distinct-count of a column. Used as the "simplicity score" for
; Form 3's preference: discriminators with fewer distinct column
; values are preferred because they generalize better. A boolean
; suffix predicate (2 distinct vals) beats a literal-word discriminator
; (n distinct vals where n = num training rows).
(define m8s-distinct-count
  (lambda (col)
    (length
      (reduce
        (lambda (acc v) (if (contains acc v) acc (append acc (list v))))
        col
        (list)))))

(define m8s-active-pool
  (lambda (pool)
    (let ((sorted (m8s-prioritize-pool pool)))
      (filter
        (lambda (e)
          (and (not (m8s-kind-matches-prefix? (m8s-pool-kind e) "const-"))
               (> (m8s-distinct-count (m8s-pool-col e)) 1)))
        sorted))))

; Form 3: multi-classify by atom membership. Iterates the entire
; pool, collects all entries that yield a clean partition, and
; picks the entry with the smallest distinct-value count.
;
; The key §9.47.3 change: prefer the SIMPLEST discriminator over the
; FIRST matching one. Without this, base string atoms (which trivially
; partition any spec where each input row is unique) would win over
; derived feature predicates (which discriminate based on a real
; rule). Memorization beats learning unless we score against it.
;
; Tie-break: when two entries have the same distinct count, the one
; encountered earlier in pool order wins (reduce's left-fold
; preserves first-seen).
(define m8s-try-form-3
  (lambda (pool target)
    (let ((hits
            (filter (lambda (e) (not (nil? e)))
              (map
                (lambda (entry)
                  (let ((fit (fit-multi-classify (m8s-pool-col entry) target)))
                    (if (nil? fit)
                      nil
                      (ns ("entry" entry)
                          ("fit"   fit)
                          ("score" (m8s-distinct-count
                                     (m8s-pool-col entry)))))))
                pool))))
      (if (= (length hits) 0)
        nil
        (let ((best
                (reduce
                  (lambda (acc h)
                    (if (or (nil? acc) (< (ns-get h "score") (ns-get acc "score")))
                      h
                      acc))
                  hits
                  nil)))
          (let ((entry (ns-get best "entry"))
                (fit   (ns-get best "fit")))
            (ns ("kind" "form-3-classify")
                ("k"      (length (ns-get fit "labels")))
                ("labels" (ns-get fit "labels"))
                ("score"  (ns-get best "score"))
                ("source-node"
                  (m8s-emit-multi-classify
                    (m8s-pool-source entry)
                    (ns-get fit "labels")
                    (ns-get fit "vals-by-label"))))))))))

; Form 4: pair-equality classify. Iterate ordered pairs (e1, e2) of
; distinct pool entries and build a derived "equality column" where
; col[i] = (e1[i] == e2[i]). Run the binary-classify partition logic
; on the (boolean) equality column. The first clean partition wins.
;
; This is the §9.47 P1.5 addition for subject/object disambiguation
; via pairwise comparison: the discriminating feature is "does atom
; e1 equal atom e2 on this row" — e.g., "is the target word the same
; as the first word of the sentence" gives subject vs object.
;
; Cost: O(pool² × rows). For ~12 pool entries on 6-row specs that's
; ~864 ops, well below any practical budget.

(define m8s-eq-col
  (lambda (col-a col-b)
    (map (lambda (i) (= (nth col-a i) (nth col-b i)))
         (range (length col-a)))))

; True iff col is not all-true and not all-false (otherwise the
; partition would be vacuous).
(define m8s-discriminating?
  (lambda (col)
    (let ((has-true (reduce (lambda (acc v) (or acc v)) col false))
          (has-false (reduce (lambda (acc v) (or acc (not v))) col false)))
      (and has-true has-false))))

; Helper: given the fit result and the source pair, build the
; standard ns describing the form-4 hit. Defined before its caller
; so the env lookup at definition-time of m8s-fit-pair-equality
; resolves correctly.
(define m8s-build-pair-equality-result
  (lambda (e1 e2 fit)
    (let ((labels (ns-get fit "labels"))
          (vals (ns-get fit "vals-by-label")))
      (let ((first-is-true (contains (head vals) true)))
        (let ((true-label  (if first-is-true (head labels) (head (tail labels))))
              (false-label (if first-is-true (head (tail labels)) (head labels))))
          (ns ("kind" "form-4-pair-equality")
              ("true-label"  true-label)
              ("false-label" false-label)
              ("source-node"
                (m8s-wrap-lambda
                  (make-if
                    (make-app "=" (m8s-pool-source e1) (m8s-pool-source e2))
                    (make-str true-label)
                    (make-str false-label))))))))))

; ── Form 5: sequence-position arithmetic (§9.47.3) ───────────────────
;
; Numeric ordering classify. For each ordered pair (e1, e2) of
; distinct numeric pool entries, build an "ordering column" where
; eq[i] = (e1[i] < e2[i]). If discriminating, run binary classify
; on the boolean column and emit
; (if (< e1-source e2-source) "label-true" "label-false").
;
; Structurally parallel to Form 4 (pair-equality) but uses `<` instead
; of `=` and only iterates numeric atoms (kind = "numeric-atom").
; Form 5's typical use case is sequence-position discrimination:
; "if target index < verb index then subject else object."

; Identify a column's value type by inspecting its head. Returns
; "numeric", "string", "bool", or "other". Used to gate Form 5's
; iteration to numeric pool entries only.
(define m8s-pool-col-type
  (lambda (e)
    (let ((c (m8s-pool-col e)))
      (if (= (length c) 0)
        "other"
        (let ((v (head c)))
          (if (or (int? v) (num? v)) "numeric"
            (if (string? v) "string"
              (if (bool? v) "bool" "other"))))))))

(define m8s-numeric-pool-entries
  (lambda (pool)
    (filter (lambda (e) (= (m8s-pool-col-type e) "numeric")) pool)))

(define m8s-lt-col
  (lambda (col-a col-b)
    (map (lambda (i) (< (nth col-a i) (nth col-b i)))
         (range (length col-a)))))

(define m8s-build-ordering-result
  (lambda (e1 e2 fit)
    (let ((labels (ns-get fit "labels"))
          (vals (ns-get fit "vals-by-label")))
      (let ((first-is-true (contains (head vals) true)))
        (let ((true-label  (if first-is-true (head labels) (head (tail labels))))
              (false-label (if first-is-true (head (tail labels)) (head labels))))
          (ns ("kind" "form-5-ordering")
              ("score" 2)
              ("true-label"  true-label)
              ("false-label" false-label)
              ("source-node"
                (m8s-wrap-lambda
                  (make-if
                    (make-app "<" (m8s-pool-source e1) (m8s-pool-source e2))
                    (make-str true-label)
                    (make-str false-label))))))))))

(define m8s-fit-ordering
  (lambda (e1 e2 target)
    (if (= (m8s-pool-col e1) (m8s-pool-col e2))
      nil
      (let ((lt-col (m8s-lt-col (m8s-pool-col e1) (m8s-pool-col e2))))
        (if (not (m8s-discriminating? lt-col))
          nil
          (let ((fit (fit-multi-classify lt-col target)))
            (if (or (nil? fit) (not (= (length (ns-get fit "labels")) 2)))
              nil
              (m8s-build-ordering-result e1 e2 fit))))))))

(define m8s-try-form-5
  (lambda (pool target)
    (let ((numerics (m8s-numeric-pool-entries pool)))
      (reduce
        (lambda (acc e1)
          (if (not (nil? acc))
            acc
            (reduce
              (lambda (acc2 e2)
                (if (not (nil? acc2))
                  acc2
                  (m8s-fit-ordering e1 e2 target)))
              numerics
              nil)))
        numerics
        nil))))

; Attempt the equality-classify fit for an (e1, e2) pair. Returns the
; result ns on success, or nil. Pulled out of m8s-try-form-4 to keep
; nesting depth manageable.
(define m8s-fit-pair-equality
  (lambda (e1 e2 target)
    (if (= (m8s-pool-col e1) (m8s-pool-col e2))
      nil
      (let ((eq-col (m8s-eq-col (m8s-pool-col e1) (m8s-pool-col e2))))
        (if (not (m8s-discriminating? eq-col))
          nil
          (let ((fit (fit-multi-classify eq-col target)))
            (if (or (nil? fit) (not (= (length (ns-get fit "labels")) 2)))
              nil
              (m8s-build-pair-equality-result e1 e2 fit))))))))

(define m8s-try-form-4
  (lambda (pool target)
    (reduce
      (lambda (acc e1)
        (if (not (nil? acc))
          acc
          (reduce
            (lambda (acc2 e2)
              (if (not (nil? acc2))
                acc2
                (m8s-fit-pair-equality e1 e2 target)))
            pool
            nil)))
      pool
      nil)))

; §9.47.5: internal held-out validation. Evaluate a candidate's
; source-node (a lambda) against test rows. Returns true iff the
; lambda produces the expected output for every test row, or if
; there are no test rows (vacuous success).
;
; This runs INSIDE the chain so that Forms 3/6 can filter out
; memorize-the-training-data candidates before returning to the
; dispatcher. Without it, the chain returns the best-scored
; candidate (which may memorize), held-out rejects it externally,
; and no alternative candidate is tried.
(define m8s-validate-candidate
  (lambda (source-node test-inputs test-outputs)
    (if (= (length test-inputs) 0)
      true
      (try
        (let ((fn (eval-node source-node)))
          (reduce
            (lambda (acc i)
              (if acc
                (= (fn (nth test-inputs i)) (nth test-outputs i))
                false))
            (range (length test-inputs))
            true))
        false))))

; §9.47.5: return ALL valid Form 3 hits as a list (not just the best).
; Used by the dispatch to filter by held-out validation per-candidate
; before picking the best-scored survivor.
(define m8s-form3-all-hits
  (lambda (pool target)
    (filter (lambda (e) (not (nil? e)))
      (map
        (lambda (entry)
          (let ((fit (fit-multi-classify (m8s-pool-col entry) target)))
            (if (nil? fit)
              nil
              (ns ("kind" "form-3-classify")
                  ("k"      (length (ns-get fit "labels")))
                  ("labels" (ns-get fit "labels"))
                  ("score"  (m8s-distinct-count (m8s-pool-col entry)))
                  ("source-node"
                    (m8s-emit-multi-classify
                      (m8s-pool-source entry)
                      (ns-get fit "labels")
                      (ns-get fit "vals-by-label")))))))
        pool))))

; Pick the result with the smallest score among non-nil candidates.
; Used to merge Form 3-style and recursive results: both can succeed
; on the same spec, and we want the one whose discriminator has fewest
; distinct values (proxy for "simplest rule").
(define m8s-pick-smaller-score
  (lambda (a b)
    (if (nil? a) b
      (if (nil? b) a
        (if (< (ns-get b "score") (ns-get a "score")) b a)))))

; ── Recursive classifier (replaces hand-coded Form 6) ────────────────
;
; m8s-recursive-classify-body returns (list body-node total-score) or
; nil. The body-node is a raw AST (no lambda wrapper) — only the
; top-level wrapper m8s-try-recursive wraps it in (lambda (x) ...).
;
; row-indices is the list of original row positions still under
; consideration. The pool itself is NOT projected — pool source nodes
; reference (nth x i) which is invariant across recursion levels.
;
; Algorithm:
;   1. If only one distinct label in projected target → return that label.
;   2. Try Form 3 base case: any pool entry whose projected column
;      cleanly partitions all remaining labels → emit classify chain.
;   3. If depth >= max → fail.
;   4. For each active pool entry:
;        - Project its column to row-indices.
;        - Try fit-partial-classify.
;        - If a partial match found, recurse on residual indices.
;        - Track best (lowest total-score) composition.
;   5. Return best or nil.

(define m8s-recursive-max-depth 4)

; Try Form 3 (full clean partition) on the projected target. Returns
; (list body-node score) or nil.
(define m8s-try-form3-projected
  (lambda (pool target row-indices)
    (let ((proj-target (m8s-project-col target row-indices)))
      (let ((labels (m8s-distinct-labels proj-target)))
        (if (or (< (length labels) 2) (> (length labels) 8))
          nil
          ; Iterate pool, find best clean partition (smallest distinct count).
          (let ((hits
                  (filter (lambda (e) (not (nil? e)))
                    (map
                      (lambda (entry)
                        (let ((proj-col (m8s-project-col
                                          (m8s-pool-col entry) row-indices)))
                          (let ((fit (fit-multi-classify proj-col proj-target)))
                            (if (nil? fit)
                              nil
                              (ns ("entry" entry)
                                  ("fit"   fit)
                                  ("score" (m8s-distinct-count proj-col)))))))
                      pool))))
            (if (= (length hits) 0)
              nil
              (let ((best
                      (reduce
                        (lambda (acc h)
                          (if (or (nil? acc)
                                  (< (ns-get h "score") (ns-get acc "score")))
                            h acc))
                        hits nil)))
                (let ((entry (ns-get best "entry"))
                      (fit   (ns-get best "fit")))
                  (list
                    (m8s-build-classify-chain
                      (m8s-pool-source entry)
                      (ns-get fit "labels")
                      (ns-get fit "vals-by-label"))
                    (ns-get best "score")))))))))))

; Recursive body builder. Returns (list body-node total-score) or nil.
;
; KEY DESIGN: try BOTH the Form 3 base case AND recursive partial splits,
; then pick the lower-scoring result. Without this, Form 3 returns the
; (nth x i) memorization atom (which trivially partitions any spec
; where each row's input is unique) and short-circuits the search
; before the proper generalizing split (suffix/prefix predicates) is
; considered. Held-out validation rejects memorization but the dispatch
; would return no candidate at all.
;
; The recursive step uses fit-partial-classify to find a feature that
; splits labels into 2+ groups, then recurses on each group's rows.
; This subsumes the simpler "peel single label" pattern AND handles
; cases where every group has multiple labels (e.g., gerund_context).
(define m8s-recursive-classify-body
  (lambda (pool target row-indices depth)
    (let ((proj-target (m8s-project-col target row-indices))
          (labels-here (m8s-distinct-labels (m8s-project-col target row-indices))))
      (if (= (length labels-here) 1)
        ; Single-label residual → emit the constant. Score 0.
        (list (m8s-value-to-node (head labels-here)) 0)
        (let ((base-hit (m8s-try-form3-projected pool target row-indices))
              (rec-hit
                (if (>= depth m8s-recursive-max-depth)
                  nil
                  (let ((active (m8s-active-pool pool)))
                    (reduce
                      (lambda (best entry)
                        (let ((proj-col (m8s-project-col
                                          (m8s-pool-col entry) row-indices)))
                          (let ((partial (fit-partial-classify proj-col proj-target)))
                            (if (nil? partial)
                              best
                              (let ((group-vals (ns-get partial "group-vals"))
                                    (group-rows-rel (ns-get partial "group-rows")))
                                ; group-rows-rel are indices into row-indices
                                ; (since we used proj-target). Translate to
                                ; absolute row positions in the original target.
                                (let ((group-rows-abs
                                        (map
                                          (lambda (rel)
                                            (map (lambda (j) (nth row-indices j))
                                                 rel))
                                          group-rows-rel)))
                                  ; Recurse on each group. If any sub-recursion
                                  ; returns nil (e.g., depth exhausted), this
                                  ; entry is unusable.
                                  (let ((sub-results
                                          (map
                                            (lambda (g-rows)
                                              (m8s-recursive-classify-body
                                                pool target g-rows (+ depth 1)))
                                            group-rows-abs)))
                                    (let ((all-ok
                                            (reduce
                                              (lambda (a r)
                                                (and a (not (nil? r))))
                                              sub-results true)))
                                      (if (not all-ok) best
                                        (let ((sub-bodies (map head sub-results))
                                              (sub-scores
                                                (map (lambda (r) (head (tail r)))
                                                     sub-results)))
                                          (let ((my-score
                                                  (+ (m8s-distinct-count proj-col)
                                                     (reduce + sub-scores 0))))
                                            (let ((composed
                                                    (m8s-build-group-chain
                                                      (m8s-pool-source entry)
                                                      group-vals sub-bodies)))
                                              (if (or (nil? best)
                                                      (< my-score
                                                         (head (tail best))))
                                                (list composed my-score)
                                                best)))))))))))))
                      active
                      nil)))))
          ; Pick lower-scoring of base case vs recursive split.
          (if (nil? base-hit) rec-hit
            (if (nil? rec-hit) base-hit
              (if (< (head (tail rec-hit)) (head (tail base-hit)))
                rec-hit
                base-hit))))))))

; Try one specific outer pool entry. Returns (list body score) or nil.
; Used by m8s-try-recursive to generate multiple top-level candidates;
; the recursive sub-calls pick their own (single) best inner.
(define m8s-try-with-outer
  (lambda (pool target row-indices entry)
    (let ((proj-target (m8s-project-col target row-indices))
          (proj-col (m8s-project-col
                      (m8s-pool-col entry) row-indices)))
      (let ((partial (fit-partial-classify proj-col proj-target)))
        (if (nil? partial) nil
          (let ((group-vals (ns-get partial "group-vals"))
                (group-rows-rel (ns-get partial "group-rows")))
            (let ((group-rows-abs
                    (map (lambda (rel)
                           (map (lambda (j) (nth row-indices j)) rel))
                         group-rows-rel)))
              (let ((sub-results
                      (map
                        (lambda (g-rows)
                          (m8s-recursive-classify-body
                            pool target g-rows 1))
                        group-rows-abs)))
                (let ((all-ok
                        (reduce
                          (lambda (a r) (and a (not (nil? r))))
                          sub-results true)))
                  (if (not all-ok) nil
                    (let ((sub-bodies (map head sub-results))
                          (sub-scores
                            (map (lambda (r) (head (tail r))) sub-results)))
                      (let ((my-score
                              (+ (m8s-distinct-count proj-col)
                                 (reduce + sub-scores 0))))
                        (let ((composed
                                (m8s-build-group-chain
                                  (m8s-pool-source entry)
                                  group-vals sub-bodies)))
                          (list composed my-score))))))))))))))

; Top-level wrapper. Returns the same shape as the (now-replaced)
; m8s-form6-best-validated — namespace with "kind", "score",
; "source-node", or nil.
;
; KEY DESIGN: generate ONE candidate per top-level pool entry (not just
; the single best). Then validate each against held-out test data and
; pick the lowest-scoring candidate that passes. Without this, the
; classifier picks the lowest-scoring candidate (which may use a
; library function with a wrong partition like run_pos misclassifying
; "she") and gives up if it fails validation, even though another
; candidate with the same score validates correctly.
;
; REJECTS specs where every row has a unique output (labels = rows).
; These are not classification tasks — they are typically string
; composition patterns (concat, repeat) handled by M10s/M11s. Without
; this guard, the recursive classifier "succeeds" via pure memorization
; and short-circuits the chain before M10s gets a chance.
(define m8s-try-recursive
  (lambda (pool target test-ins test-outs)
    (let ((distinct-labels (length (m8s-distinct-labels target))))
      (if (>= distinct-labels (length target))
        nil  ; every row is unique — not a classification task
        (let ((row-indices (range (length target)))
              (active (m8s-active-pool pool)))
          ; Generate one candidate per active pool entry as outer split
          (let ((rec-candidates
                  (filter (lambda (c) (not (nil? c)))
                    (map
                      (lambda (entry)
                        (try (m8s-try-with-outer
                               pool target row-indices entry)
                             nil))
                      active))))
            ; Also include the Form 3 base case (single-feature classify)
            (let ((base-hit (m8s-try-form3-projected
                              pool target row-indices)))
              (let ((all-cands
                      (if (nil? base-hit)
                        rec-candidates
                        (append rec-candidates (list base-hit)))))
                (if (= (length all-cands) 0)
                  nil
                  ; Validate each. If no test data, skip validation.
                  (let ((survivors
                          (if (= (length test-ins) 0)
                            all-cands
                            (filter
                              (lambda (c)
                                (try (m8s-validate-candidate
                                       (m8s-wrap-lambda (head c))
                                       test-ins test-outs)
                                     false))
                              all-cands))))
                    (if (= (length survivors) 0)
                      nil
                      ; Pick lowest-scoring survivor.
                      (let ((best
                              (reduce
                                (lambda (acc c)
                                  (if (or (nil? acc)
                                          (< (head (tail c))
                                             (head (tail acc))))
                                    c acc))
                                survivors nil)))
                        (let ((body  (head best))
                              (score (head (tail best))))
                          (ns ("kind" "form-recursive-classify")
                              ("score" score)
                              ("source-node" (m8s-wrap-lambda body))))))))))))))))

(define detect-constant-string
  (lambda (s)
    (let ((target (m8s-string-target s)))
      (if (nil? target)
        (ns ("found" false) ("reason" "non-string target"))
        (let ((pool (m8s-build-pool s))
              (test-ins  (try (ns-get s "test-inputs") (list)))
              (test-outs (try (ns-get s "test-outputs") (list))))
          ; §9.47.6: validate returns Bool for use with `filter`
          ; (filter requires Bool(true), not just truthy).
          (let ((validate (lambda (r)
                  (if (nil? r) false
                    (m8s-validate-candidate
                      (ns-get r "source-node") test-ins test-outs)))))
            (let ((r1 (m8s-try-form-1 target)))
              (if (and (not (nil? r1))
                       (or (= (length test-ins) 0)
                           (m8s-validate-candidate
                             (ns-get r1 "source-node") test-ins test-outs)))
                (ns-put r1 "found" true)
                (let ((r2 (m8s-try-form-2 pool target)))
                  (if (and (not (nil? r2))
                           (or (= (length test-ins) 0)
                               (m8s-validate-candidate
                                 (ns-get r2 "source-node") test-ins test-outs)))
                    (ns-put r2 "found" true)
                    ; §9.47.5: Score-based merge across Forms 3-6 with
                    ; per-candidate held-out validation. Forms 3 and 6
                    ; can return multiple valid hits internally — we need
                    ; the validate filter applied to EACH candidate, not
                    ; just the final best. Collect all candidates from all
                    ; forms into one list, validate each, pick the smallest
                    ; score among survivors.
                    (let ((all-candidates
                            (append
                              (m8s-form3-all-hits pool target)
                              (append
                                (let ((r4 (m8s-try-form-4 pool target)))
                                  (if (nil? r4) (list) (list (ns-put r4 "score" 2))))
                                (append
                                  (let ((r5 (m8s-try-form-5 pool target)))
                                    (if (nil? r5) (list) (list (ns-put r5 "score" 2))))
                                  (list))))))
                      ; Recursive partial-match classifier replaces hand-coded
                      ; Form 6. Subsumes 2-feature conjunction and extends to
                      ; arbitrary depth (3+ features). Internally validates
                      ; against held-out test pairs and discards if invalid.
                      (let ((f6-best (try (m8s-try-recursive
                                            pool target test-ins test-outs) nil)))
                        (let ((valid-non-f6
                                (if (= (length test-ins) 0)
                                  all-candidates
                                  (filter validate all-candidates))))
                          (let ((all-valid
                                  (if (nil? f6-best)
                                    valid-non-f6
                                    (append valid-non-f6 (list f6-best)))))
                            (if (= (length all-valid) 0)
                              (ns ("found" false) ("reason" "no string shape matched"))
                              (let ((best
                                      (reduce
                                        (lambda (acc h)
                                          (if (or (nil? acc)
                                                  (< (ns-get h "score")
                                                     (ns-get acc "score")))
                                            h acc))
                                        all-valid nil)))
                                (ns-put best "found" true)))))))))))))))))

; ── Smoke tests ──────────────────────────────────────────────────────

(define m8s-make-spec
  (lambda (inputs outputs arity)
    (ns ("inputs" inputs) ("outputs" outputs) ("arity" arity))))

(define m8s-const-spec
  (m8s-make-spec
    (list (list "a" "b") (list "foo" "bar") (list "x" "y"))
    (list "hello" "hello" "hello")
    2))

(define m8s-identity-spec
  (m8s-make-spec
    (list (list "a" "b") (list "foo" "bar") (list "x" "y"))
    (list "a" "foo" "x")
    2))

(define m8s-run-test
  (lambda (label spec)
    (do
      (print (concat "─── " label " ───"))
      (let ((result (detect-constant-string spec)))
        (if (ns-get result "found")
          (print (concat "  ✓ kind=" (ns-get result "kind")))
          (print (concat "  ✗ " (ns-get result "reason"))))))))

(m8s-run-test "constant 'hello'" m8s-const-spec)
(m8s-run-test "identity (nth x 0)" m8s-identity-spec)

; Form 3 smoke: the run-pos ambiguity case in miniature.
(define m8s-run-pos-spec
  (m8s-make-spec
    (list (list "i" "run") (list "they" "run") (list "we" "run")
          (list "a" "run") (list "the" "run") (list "morning" "run"))
    (list "verb" "verb" "verb" "noun" "noun" "noun")
    2))

(m8s-run-test "run pos (binary classify)" m8s-run-pos-spec)

; Recursive classify smoke: verb_form (3 classes via 2 features).
; Form 3 alone fails (no single feature cleanly partitions all 3 classes).
; The recursive classifier should find:
;   ends-in-ing → "gerund" else recurse
;   ends-in-ed  → "past"   else "base"
(define m8s-verb-form-spec
  (m8s-make-spec
    (list (list "running") (list "playing") (list "eating")
          (list "walked") (list "played") (list "opened")
          (list "run") (list "walk") (list "eat"))
    (list "gerund" "gerund" "gerund" "past" "past" "past" "base" "base" "base")
    1))

(m8s-run-test "verb_form (via dispatch)" m8s-verb-form-spec)

; Direct test of the recursive classifier on verb_form. This bypasses
; detect-constant-string and exercises m8s-try-recursive directly.
(let ((pool (m8s-build-pool m8s-verb-form-spec))
      (target (ns-get m8s-verb-form-spec "outputs")))
  (let ((r (try (m8s-try-recursive pool target (list) (list)) nil)))
    (if (nil? r)
      (print "─── recursive verb_form: ✗ NIL")
      (print (concat "─── recursive verb_form: ✓ score="
               (to-string (ns-get r "score")))))))

; gerund_context smoke (4-class, requires 2-feature group partition where
; every group has 2 labels — no single label can be cleanly peeled).
(define m8s-gerund-context-spec
  (m8s-make-spec
    (list (list "the" "running") (list "a" "swimming") (list "the" "playing")
          (list "i" "running") (list "we" "swimming") (list "they" "playing")
          (list "the" "cat") (list "a" "dog") (list "the" "house")
          (list "i" "cat") (list "we" "dog") (list "they" "house"))
    (list "gerund-noun" "gerund-noun" "gerund-noun"
          "verb-progressive" "verb-progressive" "verb-progressive"
          "common-noun" "common-noun" "common-noun"
          "other" "other" "other")
    2))

(let ((pool (m8s-build-pool m8s-gerund-context-spec))
      (target (ns-get m8s-gerund-context-spec "outputs")))
  (let ((r (try (m8s-try-recursive pool target (list) (list)) nil)))
    (if (nil? r)
      (print "─── recursive gerund_context: ✗ NIL")
      (print (concat "─── recursive gerund_context: ✓ score="
               (to-string (ns-get r "score"))
               " src=" (to-string (ns-get r "source-node")))))))
