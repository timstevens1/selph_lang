; ─────────────────────────────────────────────────────────────────────────
; Meta-curriculum M8s: constant-string fit (§9.47 P1 + P1.5)
; ─────────────────────────────────────────────────────────────────────────
;
; String analogue of m8_constant_fit.selph. Recognizes three shapes:
;
;   Form 1:  target == "constant"      (every output equal)
;   Form 2:  target == g(x)            (output is exactly some pool entry's
;                                       column — the string analogue of
;                                       fit-scale with C=1, since strings
;                                       have no scalar multiplication)
;   Form 3:  target == if (contains <set-A> g(x)) then "label-A" else "label-B"
;            (binary classification by atom membership — added §9.47 P1.5
;            to handle context-sensitive POS tagging where the output is
;            one of two labels determined by which set the discriminating
;            atom falls into)
;
; The string equivalent of M8's fit-affine doesn't exist as a closed-form
; solver — instead each form is its own dedicated check.

; ── Helpers ──────────────────────────────────────────────────────────

(define m8s-spec-outputs (lambda (s) (ns-get s "outputs")))

(define m8s-str? (lambda (v) (string? v)))

(define m8s-cols-equal?
  (lambda (xs ys)
    (if (= (length xs) (length ys))
      (reduce
        (lambda (acc pair) (and acc (= (head pair) (head (tail pair)))))
        (zip xs ys)
        true)
      false)))

(define m8s-string-target
  (lambda (s)
    (let ((outs (m8s-spec-outputs s)))
      (if (reduce (lambda (acc v) (and acc (m8s-str? v))) outs true)
        outs
        nil))))

; ── fit-constant-string primitive ────────────────────────────────────
;
; If every value in target equals the head, return that constant.
; Otherwise return nil. The empty-target case returns nil — a vacuous
; success would emit code that we can't validate against any input.

(define fit-constant-string
  (lambda (target)
    (if (= (length target) 0)
      nil
      (let ((c (head target)))
        (if (reduce (lambda (acc v) (and acc (= v c))) target true)
          c
          nil)))))

; ── Pool builder ─────────────────────────────────────────────────────
;
; M8s consults the L0 pool plus unary-l1 wraps for Forms 2-4, plus
; the §9.47.3 word-internal derived features (suffixes, prefixes,
; capital) for Forms 3-6 to discriminate by morphological features.
; Form 1 doesn't consult the pool at all.
;
; Pool size for typical 2-arg specs: 2 base + 6 unary wraps + 14
; suffix entries + 8 prefix entries + 2 capital entries = ~32
; entries. Cost per task is still trivial (Form 4 pair-iteration is
; ~32² = 1024 fits, each fit linear in row count).

(define m8s-build-pool
  (lambda (s)
    (make-pool-string s
      (ns ("unary-l1" true)
          ("suffixes" true)
          ("prefixes" true)
          ("capital"  true)
          ("numeric"  true)
          ("libs"     true)))))

(define m8s-pool-source (lambda (e) (ns-get e "source")))
(define m8s-pool-col    (lambda (e) (ns-get e "col")))
(define m8s-pool-kind   (lambda (e) (ns-get e "kind")))

(define m8s-form6-priority-order
  (list "string-ends-with" "string-starts-with" "first-upper"
        "lib-" "atom" "numeric-atom" "wrap-" "const-"))

(define m8s-form6-budget 2000)

(define m8s-kind-matches-prefix?
  (lambda (kind pfx)
    (if (>= (string-length kind) (string-length pfx))
      (= (string-take kind (string-length pfx)) pfx)
      false)))

(define m8s-prioritize-pool
  (lambda (pool)
    (let ((buckets
            (map (lambda (pfx)
                   (filter (lambda (e) (m8s-kind-matches-prefix? (m8s-pool-kind e) pfx))
                           pool))
                 m8s-form6-priority-order)))
      (reduce append buckets (list)))))

; ── fit-multi-classify primitive ─────────────────────────────────────
;
; Generalized partition recognizer. For pool column e-col and target
; output column, check whether e-col cleanly partitions the rows by
; output label. Returns (ns ("labels" ...) ("vals-by-label" ...)) on
; success or nil on failure.
;
; A "clean partition" means: for every pair of distinct output labels
; (l1, l2), the set of e-values appearing in label-l1 rows is disjoint
; from the set appearing in label-l2 rows. If any e-value appears in
; rows of two different labels, the atom doesn't discriminate.
;
; Cap on k: at most 4 distinct labels. Beyond that the emitted
; if-chain becomes unwieldy and the search cost rises faster than
; the value (real curricula past 4 labels usually want a different
; encoding, like one-hot output).
;
; The canonical use case is POS tagging by previous-word membership:
;   "i run"   → e-col[0] = "i",   target = "verb"
;   "the run" → e-col[1] = "the", target = "noun"
; The value sets {"i", "they", ...} and {"the", "a", ...} are
; disjoint, so prev-word is a clean discriminator.

(define m8s-distinct-labels
  (lambda (target)
    (reduce
      (lambda (acc v)
        (if (contains acc v) acc (append acc (list v))))
      target
      (list))))

(define m8s-vals-for-label
  (lambda (e-col target label)
    (reduce
      (lambda (acc i)
        (let ((row-label (nth target i))
              (row-val (nth e-col i)))
          (if (= row-label label)
            (if (contains acc row-val) acc (append acc (list row-val)))
            acc)))
      (range (length target))
      (list))))

(define m8s-disjoint?
  (lambda (xs ys)
    (reduce
      (lambda (acc x) (and acc (not (contains ys x))))
      xs
      true)))

; All pairs of distinct elements from a list (i < j ordering).
(define m8s-distinct-pairs
  (lambda (xs)
    (let ((n (length xs)))
      (reduce append
        (map
          (lambda (i)
            (map (lambda (j) (list (nth xs i) (nth xs j)))
                 (filter (lambda (j) (> j i)) (range n))))
          (range n))
        (list)))))

; Check that the partition implied by `vals-by-label` is clean: every
; pair of label-value sets is disjoint. `vals-by-label` is a list of
; lists (parallel to `labels`) — vals-by-label[i] is the set of
; e-col values appearing in label-i rows.
(define m8s-partition-clean?
  (lambda (vals-by-label)
    (let ((index-pairs (m8s-distinct-pairs (range (length vals-by-label)))))
      (reduce
        (lambda (acc pair)
          (and acc
               (m8s-disjoint?
                 (nth vals-by-label (head pair))
                 (nth vals-by-label (head (tail pair))))))
        index-pairs
        true))))

(define fit-multi-classify
  (lambda (e-col target)
    (let ((labels (m8s-distinct-labels target)))
      (if (or (< (length labels) 2) (> (length labels) 4))
        nil
        (let ((vals-by-label
                (map (lambda (l) (m8s-vals-for-label e-col target l)) labels)))
          (if (m8s-partition-clean? vals-by-label)
            (ns ("labels" labels) ("vals-by-label" vals-by-label))
            nil))))))

; Backwards-compat alias kept for the smoke test.
(define fit-binary-classify fit-multi-classify)

; ── Source emission ──────────────────────────────────────────────────

(define m8s-wrap-lambda
  (lambda (body) (make-lambda (list "x") body)))

(define m8s-emit-bare
  (lambda (c)
    (m8s-wrap-lambda (make-str c))))

(define m8s-emit-atom
  (lambda (g-source)
    (m8s-wrap-lambda g-source)))

; Polymorphic value-to-Node converter. Dispatches on runtime type so
; the emit works for string atoms (Form 3 on base atoms) AND for
; boolean derived features (Form 3 on suffix/prefix predicates from
; the §9.47.3 word-internal feature pool). Without the bool case,
; emitting an if-contains test on a derived feature column would
; crash with "make-str: expected string, got Bool(true)".
(define m8s-value-to-node
  (lambda (v)
    (if (string? v) (make-str v)
      (if (bool? v) (make-bool v)
        (if (int? v) (make-int v)
          (if (num? v) (make-num v)
            (error (concat "m8s-value-to-node: unsupported value type for "
                           (to-string v)))))))))

; Build a `(list v0 v1 ...)` AST node from a list of values, picking
; the right make-* per value type. Used by the multi-classify emit
; when building the literal value-set list.
(define m8s-emit-value-list
  (lambda (vs)
    (let ((nodes (map m8s-value-to-node vs)))
      (apply make-app (cons (make-symbol "list") nodes)))))

; Backwards-compat alias.
(define m8s-emit-string-list m8s-emit-value-list)

; Build a chain of nested ifs that emit the multi-classify decision
; tree. For k labels [l1, l2, l3, ..., lk] with value sets
; [v1, v2, ..., vk-1] (the last label is the else fall-through):
;
;   (if (contains v1 e) l1
;     (if (contains v2 e) l2
;       (if (contains v3 e) l3 ... lk-1)))
;
; The last label is emitted as the else of the deepest if. With k=2
; this collapses to a single if — same shape as the original
; binary-classify emit.
(define m8s-build-classify-chain
  (lambda (e-source labels vals-by-label)
    (let ((k (length labels)))
      (if (= k 1)
        (make-str (head labels))
        (make-if
          (make-app "contains"
            (m8s-emit-string-list (head vals-by-label))
            e-source)
          (make-str (head labels))
          (m8s-build-classify-chain
            e-source
            (tail labels)
            (tail vals-by-label)))))))

(define m8s-emit-multi-classify
  (lambda (e-source labels vals-by-label)
    (m8s-wrap-lambda
      (m8s-build-classify-chain e-source labels vals-by-label))))

; ── Detection ────────────────────────────────────────────────────────

(define m8s-try-form-1
  (lambda (target)
    (let ((c (fit-constant-string target)))
      (if (nil? c)
        nil
        (ns ("kind" "form-1-string") ("c" c)
            ("source-node" (m8s-emit-bare c)))))))

(define m8s-try-form-2
  (lambda (pool target)
    (reduce
      (lambda (acc entry)
        (if (not (nil? acc)) acc
          (if (m8s-cols-equal? (m8s-pool-col entry) target)
            (ns ("kind" "form-2-string")
                ("source-node" (m8s-emit-atom (m8s-pool-source entry))))
            nil)))
      pool
      nil)))

; Distinct-count of a column. Used as the "simplicity score" for
; Form 3's preference: discriminators with fewer distinct column
; values are preferred because they generalize better. A boolean
; suffix predicate (2 distinct vals) beats a literal-word discriminator
; (n distinct vals where n = num training rows).
(define m8s-distinct-count
  (lambda (col)
    (length
      (reduce
        (lambda (acc v) (if (contains acc v) acc (append acc (list v))))
        col
        (list)))))

(define m8s-form6-active-pool
  (lambda (pool)
    (let ((sorted (m8s-prioritize-pool pool)))
      (filter
        (lambda (e)
          (and (not (m8s-kind-matches-prefix? (m8s-pool-kind e) "const-"))
               (> (m8s-distinct-count (m8s-pool-col e)) 1)))
        sorted))))

; Form 3: multi-classify by atom membership. Iterates the entire
; pool, collects all entries that yield a clean partition, and
; picks the entry with the smallest distinct-value count.
;
; The key §9.47.3 change: prefer the SIMPLEST discriminator over the
; FIRST matching one. Without this, base string atoms (which trivially
; partition any spec where each input row is unique) would win over
; derived feature predicates (which discriminate based on a real
; rule). Memorization beats learning unless we score against it.
;
; Tie-break: when two entries have the same distinct count, the one
; encountered earlier in pool order wins (reduce's left-fold
; preserves first-seen).
(define m8s-try-form-3
  (lambda (pool target)
    (let ((hits
            (filter (lambda (e) (not (nil? e)))
              (map
                (lambda (entry)
                  (let ((fit (fit-multi-classify (m8s-pool-col entry) target)))
                    (if (nil? fit)
                      nil
                      (ns ("entry" entry)
                          ("fit"   fit)
                          ("score" (m8s-distinct-count
                                     (m8s-pool-col entry)))))))
                pool))))
      (if (= (length hits) 0)
        nil
        (let ((best
                (reduce
                  (lambda (acc h)
                    (if (or (nil? acc) (< (ns-get h "score") (ns-get acc "score")))
                      h
                      acc))
                  hits
                  nil)))
          (let ((entry (ns-get best "entry"))
                (fit   (ns-get best "fit")))
            (ns ("kind" "form-3-classify")
                ("k"      (length (ns-get fit "labels")))
                ("labels" (ns-get fit "labels"))
                ("score"  (ns-get best "score"))
                ("source-node"
                  (m8s-emit-multi-classify
                    (m8s-pool-source entry)
                    (ns-get fit "labels")
                    (ns-get fit "vals-by-label"))))))))))

; Form 4: pair-equality classify. Iterate ordered pairs (e1, e2) of
; distinct pool entries and build a derived "equality column" where
; col[i] = (e1[i] == e2[i]). Run the binary-classify partition logic
; on the (boolean) equality column. The first clean partition wins.
;
; This is the §9.47 P1.5 addition for subject/object disambiguation
; via pairwise comparison: the discriminating feature is "does atom
; e1 equal atom e2 on this row" — e.g., "is the target word the same
; as the first word of the sentence" gives subject vs object.
;
; Cost: O(pool² × rows). For ~12 pool entries on 6-row specs that's
; ~864 ops, well below any practical budget.

(define m8s-eq-col
  (lambda (col-a col-b)
    (map (lambda (i) (= (nth col-a i) (nth col-b i)))
         (range (length col-a)))))

; True iff col is not all-true and not all-false (otherwise the
; partition would be vacuous).
(define m8s-discriminating?
  (lambda (col)
    (let ((has-true (reduce (lambda (acc v) (or acc v)) col false))
          (has-false (reduce (lambda (acc v) (or acc (not v))) col false)))
      (and has-true has-false))))

; Helper: given the fit result and the source pair, build the
; standard ns describing the form-4 hit. Defined before its caller
; so the env lookup at definition-time of m8s-fit-pair-equality
; resolves correctly.
(define m8s-build-pair-equality-result
  (lambda (e1 e2 fit)
    (let ((labels (ns-get fit "labels"))
          (vals (ns-get fit "vals-by-label")))
      (let ((first-is-true (contains (head vals) true)))
        (let ((true-label  (if first-is-true (head labels) (head (tail labels))))
              (false-label (if first-is-true (head (tail labels)) (head labels))))
          (ns ("kind" "form-4-pair-equality")
              ("true-label"  true-label)
              ("false-label" false-label)
              ("source-node"
                (m8s-wrap-lambda
                  (make-if
                    (make-app "=" (m8s-pool-source e1) (m8s-pool-source e2))
                    (make-str true-label)
                    (make-str false-label))))))))))

; ── Form 5: sequence-position arithmetic (§9.47.3) ───────────────────
;
; Numeric ordering classify. For each ordered pair (e1, e2) of
; distinct numeric pool entries, build an "ordering column" where
; eq[i] = (e1[i] < e2[i]). If discriminating, run binary classify
; on the boolean column and emit
; (if (< e1-source e2-source) "label-true" "label-false").
;
; Structurally parallel to Form 4 (pair-equality) but uses `<` instead
; of `=` and only iterates numeric atoms (kind = "numeric-atom").
; Form 5's typical use case is sequence-position discrimination:
; "if target index < verb index then subject else object."

; Identify a column's value type by inspecting its head. Returns
; "numeric", "string", "bool", or "other". Used to gate Form 5's
; iteration to numeric pool entries only.
(define m8s-pool-col-type
  (lambda (e)
    (let ((c (m8s-pool-col e)))
      (if (= (length c) 0)
        "other"
        (let ((v (head c)))
          (if (or (int? v) (num? v)) "numeric"
            (if (string? v) "string"
              (if (bool? v) "bool" "other"))))))))

(define m8s-numeric-pool-entries
  (lambda (pool)
    (filter (lambda (e) (= (m8s-pool-col-type e) "numeric")) pool)))

(define m8s-lt-col
  (lambda (col-a col-b)
    (map (lambda (i) (< (nth col-a i) (nth col-b i)))
         (range (length col-a)))))

(define m8s-build-ordering-result
  (lambda (e1 e2 fit)
    (let ((labels (ns-get fit "labels"))
          (vals (ns-get fit "vals-by-label")))
      (let ((first-is-true (contains (head vals) true)))
        (let ((true-label  (if first-is-true (head labels) (head (tail labels))))
              (false-label (if first-is-true (head (tail labels)) (head labels))))
          (ns ("kind" "form-5-ordering")
              ("score" 2)
              ("true-label"  true-label)
              ("false-label" false-label)
              ("source-node"
                (m8s-wrap-lambda
                  (make-if
                    (make-app "<" (m8s-pool-source e1) (m8s-pool-source e2))
                    (make-str true-label)
                    (make-str false-label))))))))))

(define m8s-fit-ordering
  (lambda (e1 e2 target)
    (if (= (m8s-pool-col e1) (m8s-pool-col e2))
      nil
      (let ((lt-col (m8s-lt-col (m8s-pool-col e1) (m8s-pool-col e2))))
        (if (not (m8s-discriminating? lt-col))
          nil
          (let ((fit (fit-multi-classify lt-col target)))
            (if (or (nil? fit) (not (= (length (ns-get fit "labels")) 2)))
              nil
              (m8s-build-ordering-result e1 e2 fit))))))))

(define m8s-try-form-5
  (lambda (pool target)
    (let ((numerics (m8s-numeric-pool-entries pool)))
      (reduce
        (lambda (acc e1)
          (if (not (nil? acc))
            acc
            (reduce
              (lambda (acc2 e2)
                (if (not (nil? acc2))
                  acc2
                  (m8s-fit-ordering e1 e2 target)))
              numerics
              nil)))
        numerics
        nil))))

; ── Form 6: feature conjunction (§9.47.3) ────────────────────────────
;
; Pair-classify by joint column values. For each ordered pair (e1, e2)
; of distinct pool entries, build a "joint column" where each cell is
; a 2-element list `(e1[i], e2[i])`. Run fit-multi-classify on the
; joint column. The first clean partition of joint values into label
; classes wins, scored by the distinct joint-value count.
;
; This is the recognizer for k>2 morphology cases like verb_form,
; where no single feature discriminates all classes but a pair of
; features does:
;   (ends-in-ing, ends-in-ed)
;   (true,  false) → gerund
;   (false, true ) → past
;   (false, false) → base
;
; The emit is a chain of `(if (and (= e1 a) (= e2 b)) label ...)`
; tests with the last label as the else fall-through. Each test is
; a conjunction of two equalities, hence "feature conjunction."
;
; Cost: O(pool² × rows) per spec. Pool with all flags is ~30 entries
; on a typical 2-arg spec → ~900 pairs × 6 rows = 5400 ops. Cheap.

(define m8s-pair-col
  (lambda (col-a col-b)
    (map (lambda (i) (list (nth col-a i) (nth col-b i)))
         (range (length col-a)))))

; Build a `(if (and (= e1 v1) (= e2 v2)) label ...)` chain. Each
; element of `pair-vals` is a 2-element list of joint values; each
; element of `labels` is the corresponding output label. The last
; label has no test — it's the else fall-through.
(define m8s-build-conjunction-chain
  (lambda (e1-source e2-source labels pair-vals)
    (let ((k (length labels)))
      (if (= k 1)
        (m8s-value-to-node (head labels))
        (let ((pv (head pair-vals)))
          (let ((v1 (head pv))
                (v2 (head (tail pv))))
            ; NOTE: can't use (make-app "and" ...) because eval_v2 treats
            ; `and` as a SpecialApp, not a regular App. Use nested make-if
            ; to encode the conjunction: (if test1 (if test2 then else) else).
            (let ((test1 (make-app "=" e1-source (m8s-value-to-node v1)))
                  (test2 (make-app "=" e2-source (m8s-value-to-node v2)))
                  (then-val (m8s-value-to-node (head labels)))
                  (else-val (m8s-build-conjunction-chain
                              e1-source e2-source
                              (tail labels) (tail pair-vals))))
              (make-if test1
                (make-if test2 then-val else-val)
                else-val))))))))

; For Form 6, vals-by-label[i] is a list of 2-element lists. We need
; one representative joint value per label for the emit. Since the
; partition is clean, every joint value in label i maps to label i
; uniquely — but a single label may have multiple distinct joint
; values (e.g., (true, true) and (true, false) both map to gerund).
; The emit needs to test for ALL of them.
;
; Simpler implementation: flatten labels × vals-by-label into a flat
; list of (joint-val, label) pairs, then build the chain with one
; test per joint value. The last entry becomes the else.

(define m8s-flatten-conjunction-vals
  (lambda (labels vals-by-label)
    (reduce append
      (map
        (lambda (i)
          (let ((label (nth labels i))
                (vals (nth vals-by-label i)))
            (map (lambda (v) (list v label)) vals)))
        (range (length labels)))
      (list))))

; Build the conjunction chain from a flat list of (joint-val, label)
; pairs. The last pair's label becomes the else.
(define m8s-build-conjunction-from-pairs
  (lambda (e1-source e2-source pairs)
    (let ((n (length pairs)))
      (if (= n 1)
        (m8s-value-to-node (head (tail (head pairs))))
        (let ((p (head pairs)))
          (let ((joint (head p))
                (label (head (tail p))))
            (let ((v1 (head joint))
                  (v2 (head (tail joint))))
              (let ((test1 (make-app "=" e1-source (m8s-value-to-node v1)))
                    (test2 (make-app "=" e2-source (m8s-value-to-node v2)))
                    (then-val (m8s-value-to-node label))
                    (else-val (m8s-build-conjunction-from-pairs
                                e1-source e2-source (tail pairs))))
                (make-if test1
                  (make-if test2 then-val else-val)
                  else-val)))))))))

(define m8s-fit-conjunction
  (lambda (e1 e2 target)
    (if (= (m8s-pool-col e1) (m8s-pool-col e2))
      nil
      (let ((joint (m8s-pair-col (m8s-pool-col e1) (m8s-pool-col e2))))
        (let ((fit (fit-multi-classify joint target)))
          (if (nil? fit)
            nil
            (let ((labels (ns-get fit "labels"))
                  (vals (ns-get fit "vals-by-label")))
              (let ((flat (m8s-flatten-conjunction-vals labels vals)))
                (ns ("kind" "form-6-conjunction")
                    ("k" (length labels))
                    ("score" (length flat))
                    ("source-node"
                      (m8s-wrap-lambda
                        (m8s-build-conjunction-from-pairs
                          (m8s-pool-source e1)
                          (m8s-pool-source e2)
                          flat))))))))))))

(define m8s-try-form-6
  (lambda (pool target)
    (let ((active (m8s-form6-active-pool pool)))
      (let ((result
              (reduce
                (lambda (state e1)
                  (if (>= (nth state 1) m8s-form6-budget)
                    state
                    (reduce
                      (lambda (st e2)
                        (if (>= (nth st 1) m8s-form6-budget)
                          st
                          (let ((hit (try (m8s-fit-conjunction e1 e2 target) nil)))
                            (list
                              (if (nil? hit) (nth st 0) (append (nth st 0) (list hit)))
                              (+ (nth st 1) 1)))))
                      active
                      state)))
                active
                (list (list) 0))))
        (let ((hits (nth result 0)))
          (if (= (length hits) 0)
            nil
            (reduce
              (lambda (acc h)
                (if (or (nil? acc) (< (ns-get h "score") (ns-get acc "score")))
                  h
                  acc))
              hits
              nil)))))))

; Attempt the equality-classify fit for an (e1, e2) pair. Returns the
; result ns on success, or nil. Pulled out of m8s-try-form-4 to keep
; nesting depth manageable.
(define m8s-fit-pair-equality
  (lambda (e1 e2 target)
    (if (= (m8s-pool-col e1) (m8s-pool-col e2))
      nil
      (let ((eq-col (m8s-eq-col (m8s-pool-col e1) (m8s-pool-col e2))))
        (if (not (m8s-discriminating? eq-col))
          nil
          (let ((fit (fit-multi-classify eq-col target)))
            (if (or (nil? fit) (not (= (length (ns-get fit "labels")) 2)))
              nil
              (m8s-build-pair-equality-result e1 e2 fit))))))))

(define m8s-try-form-4
  (lambda (pool target)
    (reduce
      (lambda (acc e1)
        (if (not (nil? acc))
          acc
          (reduce
            (lambda (acc2 e2)
              (if (not (nil? acc2))
                acc2
                (m8s-fit-pair-equality e1 e2 target)))
            pool
            nil)))
      pool
      nil)))

; §9.47.5: internal held-out validation. Evaluate a candidate's
; source-node (a lambda) against test rows. Returns true iff the
; lambda produces the expected output for every test row, or if
; there are no test rows (vacuous success).
;
; This runs INSIDE the chain so that Forms 3/6 can filter out
; memorize-the-training-data candidates before returning to the
; dispatcher. Without it, the chain returns the best-scored
; candidate (which may memorize), held-out rejects it externally,
; and no alternative candidate is tried.
(define m8s-validate-candidate
  (lambda (source-node test-inputs test-outputs)
    (if (= (length test-inputs) 0)
      true
      (try
        (let ((fn (eval-node source-node)))
          (reduce
            (lambda (acc i)
              (if acc
                (= (fn (nth test-inputs i)) (nth test-outputs i))
                false))
            (range (length test-inputs))
            true))
        false))))

; §9.47.5: return ALL valid Form 3 hits as a list (not just the best).
; Used by the dispatch to filter by held-out validation per-candidate
; before picking the best-scored survivor.
(define m8s-form3-all-hits
  (lambda (pool target)
    (filter (lambda (e) (not (nil? e)))
      (map
        (lambda (entry)
          (let ((fit (fit-multi-classify (m8s-pool-col entry) target)))
            (if (nil? fit)
              nil
              (ns ("kind" "form-3-classify")
                  ("k"      (length (ns-get fit "labels")))
                  ("labels" (ns-get fit "labels"))
                  ("score"  (m8s-distinct-count (m8s-pool-col entry)))
                  ("source-node"
                    (m8s-emit-multi-classify
                      (m8s-pool-source entry)
                      (ns-get fit "labels")
                      (ns-get fit "vals-by-label")))))))
        pool))))

; §9.47.6: short-circuit Form 6 with inline validation.
; Returns the single best validated candidate (or nil).
; State: (best-candidate, pair-count).
(define m8s-form6-best-validated
  (lambda (pool target test-ins test-outs)
    (let ((active (m8s-form6-active-pool pool)))
      (let ((k (length (m8s-distinct-labels target))))
        (let ((has-test (> (length test-ins) 0)))
          (nth
            (reduce
              (lambda (state e1)
                (let ((best (nth state 0))
                      (count (nth state 1)))
                  (if (and (not (nil? best)) (= (ns-get best "score") k))
                    state
                    (if (>= count m8s-form6-budget)
                      state
                      (reduce
                        (lambda (st e2)
                          (let ((b (nth st 0))
                                (c (nth st 1)))
                            (if (and (not (nil? b)) (= (ns-get b "score") k))
                              st
                              (if (>= c m8s-form6-budget)
                                st
                                (let ((hit (try (m8s-fit-conjunction e1 e2 target) nil)))
                                  (if (nil? hit)
                                    (list b (+ c 1))
                                    (let ((dominated (and (not (nil? b))
                                                          (>= (ns-get hit "score")
                                                              (ns-get b "score")))))
                                      (if dominated
                                        (list b (+ c 1))
                                        (let ((ok (if has-test
                                                    (try (m8s-validate-candidate
                                                           (ns-get hit "source-node")
                                                           test-ins test-outs)
                                                         false)
                                                    true)))
                                          (if ok
                                            (list hit (+ c 1))
                                            (list b (+ c 1))))))))))))
                        active
                        state)))))
              active
              (list nil 0))
            0))))))

; Pick the result with the smallest score among non-nil candidates.
; Used to merge Form 3 and Form 6 results: both can succeed on the
; same spec, and we want the one whose discriminator has fewest
; distinct values (proxy for "simplest rule"). Form 6 wins for
; multi-class morphology (verb_form), Form 3 wins for binary or
; truly single-feature shapes.
(define m8s-pick-smaller-score
  (lambda (a b)
    (if (nil? a) b
      (if (nil? b) a
        (if (< (ns-get b "score") (ns-get a "score")) b a)))))

(define detect-constant-string
  (lambda (s)
    (let ((target (m8s-string-target s)))
      (if (nil? target)
        (ns ("found" false) ("reason" "non-string target"))
        (let ((pool (m8s-build-pool s))
              (test-ins  (try (ns-get s "test-inputs") (list)))
              (test-outs (try (ns-get s "test-outputs") (list))))
          ; §9.47.6: validate returns Bool for use with `filter`
          ; (filter requires Bool(true), not just truthy).
          (let ((validate (lambda (r)
                  (if (nil? r) false
                    (m8s-validate-candidate
                      (ns-get r "source-node") test-ins test-outs)))))
            (let ((r1 (m8s-try-form-1 target)))
              (if (and (not (nil? r1))
                       (or (= (length test-ins) 0)
                           (m8s-validate-candidate
                             (ns-get r1 "source-node") test-ins test-outs)))
                (ns-put r1 "found" true)
                (let ((r2 (m8s-try-form-2 pool target)))
                  (if (and (not (nil? r2))
                           (or (= (length test-ins) 0)
                               (m8s-validate-candidate
                                 (ns-get r2 "source-node") test-ins test-outs)))
                    (ns-put r2 "found" true)
                    ; §9.47.5: Score-based merge across Forms 3-6 with
                    ; per-candidate held-out validation. Forms 3 and 6
                    ; can return multiple valid hits internally — we need
                    ; the validate filter applied to EACH candidate, not
                    ; just the final best. Collect all candidates from all
                    ; forms into one list, validate each, pick the smallest
                    ; score among survivors.
                    (let ((all-candidates
                            (append
                              (m8s-form3-all-hits pool target)
                              (append
                                (let ((r4 (m8s-try-form-4 pool target)))
                                  (if (nil? r4) (list) (list (ns-put r4 "score" 2))))
                                (append
                                  (let ((r5 (m8s-try-form-5 pool target)))
                                    (if (nil? r5) (list) (list (ns-put r5 "score" 2))))
                                  (list))))))
                      ; §9.47.6: Form 6 uses short-circuit validated search.
                      (let ((f6-best (try (m8s-form6-best-validated
                                            pool target test-ins test-outs) nil)))
                        (let ((valid-non-f6
                                (if (= (length test-ins) 0)
                                  all-candidates
                                  (filter validate all-candidates))))
                          (let ((all-valid
                                  (if (nil? f6-best)
                                    valid-non-f6
                                    (append valid-non-f6 (list f6-best)))))
                            (if (= (length all-valid) 0)
                              (ns ("found" false) ("reason" "no string shape matched"))
                              (let ((best
                                      (reduce
                                        (lambda (acc h)
                                          (if (or (nil? acc)
                                                  (< (ns-get h "score")
                                                     (ns-get acc "score")))
                                            h acc))
                                        all-valid nil)))
                                (ns-put best "found" true)))))))))))))))))

; ── Smoke tests ──────────────────────────────────────────────────────

(define m8s-make-spec
  (lambda (inputs outputs arity)
    (ns ("inputs" inputs) ("outputs" outputs) ("arity" arity))))

(define m8s-const-spec
  (m8s-make-spec
    (list (list "a" "b") (list "foo" "bar") (list "x" "y"))
    (list "hello" "hello" "hello")
    2))

(define m8s-identity-spec
  (m8s-make-spec
    (list (list "a" "b") (list "foo" "bar") (list "x" "y"))
    (list "a" "foo" "x")
    2))

(define m8s-run-test
  (lambda (label spec)
    (do
      (print (concat "─── " label " ───"))
      (let ((result (detect-constant-string spec)))
        (if (ns-get result "found")
          (print (concat "  ✓ kind=" (ns-get result "kind")))
          (print (concat "  ✗ " (ns-get result "reason"))))))))

(m8s-run-test "constant 'hello'" m8s-const-spec)
(m8s-run-test "identity (nth x 0)" m8s-identity-spec)

; Form 3 smoke: the run-pos ambiguity case in miniature.
(define m8s-run-pos-spec
  (m8s-make-spec
    (list (list "i" "run") (list "they" "run") (list "we" "run")
          (list "a" "run") (list "the" "run") (list "morning" "run"))
    (list "verb" "verb" "verb" "noun" "noun" "noun")
    2))

(m8s-run-test "run pos (binary classify)" m8s-run-pos-spec)
