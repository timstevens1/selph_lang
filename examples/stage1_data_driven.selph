; ============================================================================
; Stage 1: Data-Driven Search — memorize + re-synthesize pattern
; ============================================================================
;
; Demonstrates that when flat synthesis fails (arbitrary mappings),
; memorizing the spec and re-synthesizing with the data as a tree
; enables (ns-get data x) compositions.
;
; The search function: try flat → if fails → memorize → enrich library → retry
;
; Run: selph eval examples/stage1_data_driven.selph
; ============================================================================

; ============================================================================
; Task definitions — 3 categories
; ============================================================================

; --- Category A: Pure lookup (flat WILL fail, memo WILL succeed) ---

; Arbitrary color -> number mapping
(define color-num-spec (list
  (list "red" 1) (list "blue" 2) (list "green" 3)
  (list "yellow" 4) (list "purple" 5) (list "orange" 6)))

; Arbitrary abbreviation -> expansion
(define abbrev-spec (list
  (list "NY" "New York") (list "LA" "Los Angeles")
  (list "SF" "San Francisco") (list "DC" "Washington")
  (list "CH" "Chicago") (list "BN" "Boston")))

; Day abbreviation -> day number
(define day-num-spec (list
  (list "mon" 1) (list "tue" 2) (list "wed" 3)
  (list "thu" 4) (list "fri" 5)))

; Fruit -> category mapping
(define fruit-cat-spec (list
  (list "apple" "tree") (list "banana" "herb") (list "grape" "vine")
  (list "cherry" "tree") (list "melon" "vine") (list "kiwi" "vine")))

; Element -> symbol
(define elem-sym-spec (list
  (list "hydrogen" "H") (list "helium" "He") (list "lithium" "Li")
  (list "carbon" "C") (list "nitrogen" "N") (list "oxygen" "O")))

; --- Category B: Computable (flat WILL succeed, no memo needed) ---

; String length
(define strlen-spec (list
  (list "a" 1) (list "ab" 2) (list "abc" 3) (list "abcd" 4)
  (list "x" 1) (list "xy" 2) (list "z" 1) (list "hello" 5)))

; Uppercase
(define upper-spec (list
  (list "hello" "HELLO") (list "world" "WORLD") (list "abc" "ABC")
  (list "test" "TEST") (list "foo" "FOO") (list "bar" "BAR")))

; String reverse
(define rev-spec (list
  (list "abc" "cba") (list "hello" "olleh") (list "ab" "ba")
  (list "xyz" "zyx") (list "test" "tset") (list "foo" "oof")))

; Count 'a' occurrences
(define counta-spec (list
  (list "a" 1) (list "aa" 2) (list "aaa" 3) (list "b" 0)
  (list "ab" 1) (list "ba" 1) (list "aba" 2) (list "bbb" 0)))

; Starts with 'a'
(define startsa-spec (list
  (list "apple" true) (list "ant" true) (list "ace" true)
  (list "banana" false) (list "cat" false) (list "dog" false)))

; --- Category C: Lookup + composition (needs memo AND composition) ---

; Lookup number, then double it: color -> 2*mapping
(define color-double-spec (list
  (list "red" 2) (list "blue" 4) (list "green" 6)
  (list "yellow" 8) (list "purple" 10) (list "orange" 12)))

; Lookup string, then get its length: abbrev -> len(expansion)
(define abbrev-len-spec (list
  (list "NY" 8) (list "LA" 11)
  (list "SF" 13) (list "DC" 10)
  (list "CH" 7) (list "BN" 6)))

; ============================================================================
; Search strategies
; ============================================================================

(defmacro try-synth (spec max-depth budget)
  (synthesize
    (ns-put (ns-put (ns-put (ns-empty)
      "spec" spec)
      "max-depth" max-depth)
      "max-candidates" budget)))

(defmacro try-synth-with-data (spec data max-depth budget)
  (synthesize
    (ns-put (ns-put (ns-put (ns-put (ns-empty)
      "spec" spec)
      "max-depth" max-depth)
      "max-candidates" budget)
      "trees" (ns-put (ns-empty) "data" data))))

; Strategy 1: Flat synthesis only
(defmacro strategy-flat (spec depth budget)
  (try-synth spec depth budget))

; Strategy 2: Memorize + re-synthesize
(defmacro strategy-memo (spec depth budget)
  (do
    (define data (memorize spec))
    (if (nil? data)
      (ns-put (ns-put (ns-empty) "found" false) "candidates" 0)
      (try-synth-with-data spec data depth budget))))

; Strategy 3: Smart search — try flat first, fall back to memo
(defmacro strategy-smart (spec depth budget)
  (do
    (define flat-result (try-synth spec depth budget))
    (if (ns-get flat-result "found")
      flat-result
      (do
        (define data (memorize spec))
        (if (nil? data)
          flat-result
          (try-synth-with-data spec data depth budget))))))

; ============================================================================
; Phase 1: Profile all tasks with flat vs memo vs smart
; ============================================================================

(print "========================================")
(print "Phase 1: Flat vs Memo profiling")
(print "========================================")
(print "")

(define depth 2)
(define budget 20000)

(defmacro profile (task-name spec)
  (do
    (define r-flat (strategy-flat spec depth budget))
    (define r-memo (strategy-memo spec depth budget))
    (define flat-found (ns-get r-flat "found"))
    (define flat-cands (ns-get r-flat "candidates"))
    (define memo-found (ns-get r-memo "found"))
    (define memo-cands (ns-get r-memo "candidates"))
    (print (concat task-name ":"))
    (print (concat "  flat: " (if flat-found
      (concat (to-string flat-cands) " cand  " (ns-get r-flat "source"))
      (concat (to-string flat-cands) " FAILED"))))
    (print (concat "  memo: " (if memo-found
      (concat (to-string memo-cands) " cand  " (ns-get r-memo "source"))
      (concat (to-string memo-cands) " FAILED"))))
    (list task-name flat-found flat-cands memo-found memo-cands)))

(print "--- Category A: Pure lookup (flat should fail) ---")
(define pa1 (profile "color_num"   color-num-spec))
(define pa2 (profile "abbrev"      abbrev-spec))
(define pa3 (profile "day_num"     day-num-spec))
(define pa4 (profile "fruit_cat"   fruit-cat-spec))
(define pa5 (profile "elem_sym"    elem-sym-spec))

(print "")
(print "--- Category B: Computable (flat should succeed) ---")
(define pb1 (profile "strlen"      strlen-spec))
(define pb2 (profile "upper"       upper-spec))
(define pb3 (profile "reverse"     rev-spec))
(define pb4 (profile "count_a"     counta-spec))
(define pb5 (profile "starts_a"    startsa-spec))

(print "")
(print "--- Category C: Lookup + composition ---")
(define pc1 (profile "color_double" color-double-spec))
(define pc2 (profile "abbrev_len"   abbrev-len-spec))

; ============================================================================
; Phase 2: Smart search — try flat, fall back to memo
; ============================================================================

(print "")
(print "========================================")
(print "Phase 2: Smart search (flat -> memo fallback)")
(print "========================================")
(print "")

(defmacro smart-solve (task-name spec)
  (do
    (define result (strategy-smart spec depth budget))
    (define found (ns-get result "found"))
    (define cands (ns-get result "candidates"))
    (print (concat "  " task-name ": "
      (if found
        (concat (to-string cands) " cand  " (ns-get result "source"))
        (concat (to-string cands) " FAILED"))))
    (list task-name found cands)))

(define s01 (smart-solve "color_num"    color-num-spec))
(define s02 (smart-solve "abbrev"       abbrev-spec))
(define s03 (smart-solve "day_num"      day-num-spec))
(define s04 (smart-solve "fruit_cat"    fruit-cat-spec))
(define s05 (smart-solve "elem_sym"     elem-sym-spec))
(define s06 (smart-solve "strlen"       strlen-spec))
(define s07 (smart-solve "upper"        upper-spec))
(define s08 (smart-solve "reverse"      rev-spec))
(define s09 (smart-solve "count_a"      counta-spec))
(define s10 (smart-solve "starts_a"     startsa-spec))
(define s11 (smart-solve "color_double" color-double-spec))
(define s12 (smart-solve "abbrev_len"   abbrev-len-spec))

; ============================================================================
; Phase 3: Learn strategy selector
; ============================================================================

(print "")
(print "========================================")
(print "Phase 3: Strategy selector")
(print "========================================")
(print "")

; Feature: does flat succeed? If not, memo is needed.
; We want to PREDICT this from task features, not brute force it.
; Feature encoding: num-distinct-outputs / num-examples ratio
; High ratio (many unique outputs) -> likely arbitrary -> memo
; Low ratio -> likely pattern -> flat

(defmacro distinct-count (vals)
  (do
    (define strs (map to-string vals))
    (define sorted (sort strs))
    ; Count unique by comparing adjacent
    (define counted (reduce (lambda (acc s)
      (if (= (ns-get acc "last") s)
        acc
        (ns-put (ns-put acc "count" (add (ns-get acc "count") 1)) "last" s)))
      (ns-put (ns-put (ns-empty) "count" 1) "last" (head sorted))
      (tail sorted)))
    (ns-get counted "count")))

; Actually simpler: check if any output can be computed from input via builtins
; The distinguishing feature: do outputs correlate with input structure?
; For lookup tasks: output has no relation to input string properties
; For computable tasks: output relates to input length, characters, etc.

; Simplest feature: ratio of distinct outputs to examples
; Pure lookup with unique mappings -> ratio = 1.0
; Pattern tasks may also have ratio = 1.0 (e.g., strlen on distinct inputs)
; So we need a better signal.

; Better feature: do ANY two inputs with similar structure produce similar outputs?
; Hard to compute. Let's use a simpler proxy.

; Observation from our profiling:
; - All category A tasks have outputs unrelated to input length/chars
; - Category B tasks have outputs derivable from input properties
; The flat synthesis budget tells us: if flat fails within budget, use memo.

; The strategy is the SEARCH FUNCTION itself:
(print "The learned search function is:")
(print "  (lambda (spec) (strategy-smart spec depth budget))")
(print "  = try flat synthesis; if fails, memorize + re-synthesize")
(print "")

