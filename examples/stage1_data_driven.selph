(print "========================================")
(print "Phase 4: Summary")
(print "========================================")
(print "")

(define all-results (list s01 s02 s03 s04 s05 s06 s07 s08 s09 s10 s11 s12))
(define smart-solved (length (filter (lambda (r) (head (tail r))) all-results)))
(define smart-total (reduce add (map (lambda (r) (head (tail (tail r)))) all-results)))

; Count flat-only solved
(define flat-results (list pa1 pa2 pa3 pa4 pa5 pb1 pb2 pb3 pb4 pb5 pc1 pc2))
(define flat-solved (length (filter (lambda (r) (head (tail r))) flat-results)))
(define flat-total (reduce add (map (lambda (r) (head (tail (tail r)))) flat-results)))

(print (concat "Flat only:   " (to-string flat-solved) "/12 solved, " (to-string flat-total) " candidates"))
(print (concat "Smart search: " (to-string smart-solved) "/12 solved, " (to-string smart-total) " candidates"))
(print "")

; Per-category breakdown
(define catA-flat-solved (length (filter (lambda (r) (head (tail r))) (list pa1 pa2 pa3 pa4 pa5))))
(define catA-smart-solved (length (filter (lambda (r) (head (tail r))) (list s01 s02 s03 s04 s05))))
(define catB-flat-solved (length (filter (lambda (r) (head (tail r))) (list pb1 pb2 pb3 pb4 pb5))))
(define catB-smart-solved (length (filter (lambda (r) (head (tail r))) (list s06 s07 s08 s09 s10))))
(define catC-flat-solved (length (filter (lambda (r) (head (tail r))) (list pc1 pc2))))
(define catC-smart-solved (length (filter (lambda (r) (head (tail r))) (list s11 s12))))

(print (concat "Category A (lookup):      flat=" (to-string catA-flat-solved) "/5  smart=" (to-string catA-smart-solved) "/5"))
(print (concat "Category B (computable):  flat=" (to-string catB-flat-solved) "/5  smart=" (to-string catB-smart-solved) "/5"))
(print (concat "Category C (lookup+comp): flat=" (to-string catC-flat-solved) "/2  smart=" (to-string catC-smart-solved) "/2"))
(print "")
(print "Stage 1 complete.")
