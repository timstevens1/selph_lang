; ─────────────────────────────────────────────────────────────────────────
; String POS curriculum — context-sensitive label disambiguation (§9.47.2)
; ─────────────────────────────────────────────────────────────────────────
;
; Purpose: stress-test the §9.47 P1 string chain on a domain it wasn't
; designed for. The string family was built around fit-style shapes
; (constant fit, concat pair, repeat). POS tagging is fundamentally a
; partition-by-feature shape: the output is one of K labels determined
; by membership of some atom in a discoverable set.
;
; The headline test is the "run" verb/noun ambiguity:
;
;   "i run"     → verb        (preceded by pronoun)
;   "the run"   → noun        (preceded by article)
;
; Same word, different label, discriminated by the previous word's
; class. Solving this requires the chain to (a) find that prev_word
; is the relevant feature and (b) discover the correct partition of
; values. Neither M8s, M10s, nor M11s does this in P1 — they all
; produce columns and check exact equality, not membership-based
; classification.
;
; Encoding: most tasks use a 2-word window (("prev" "target") "label")
; so position 0 is the discriminator. Some stretch tasks use a
; 3-word window or a sentence+index encoding to test whether deeper
; context structure can be discovered.

; ── Stage 0: Trivial controls ────────────────────────────────────────
; These should solve via the existing M8s/M10s — proves the
; multi-arg path is wired correctly for string-typed inputs.

; Constant label, ignores both inputs entirely.
(task-args "always_noun" 2
  (("the" "cat") "noun") (("a" "dog") "noun") (("the" "house") "noun")
  (("an" "apple") "noun") (("the" "tree") "noun") (("a" "book") "noun"))

; Echo position 1 (the target word).
(task-args "echo_target" 2
  (("the" "cat") "cat") (("a" "dog") "dog") (("the" "house") "house")
  (("an" "apple") "apple") (("the" "tree") "tree") (("a" "book") "book"))

; Echo position 0 (the previous word).
(task-args "echo_prev" 2
  (("the" "cat") "the") (("a" "dog") "a") (("the" "house") "the")
  (("an" "apple") "an") (("the" "tree") "the") (("a" "book") "a"))

; Concat the two — sanity check that M10s fires on this domain.
(task-args "concat_window" 2
  (("the" "cat") "thecat") (("a" "dog") "adog") (("the" "house") "thehouse")
  (("an" "apple") "anapple") (("the" "tree") "thetree") (("a" "book") "abook"))

; Concat with space — common POS-tagger output format.
(task-args "concat_window_sp" 2
  (("the" "cat") "the cat") (("a" "dog") "a dog") (("the" "house") "the house")
  (("an" "apple") "an apple") (("the" "tree") "the tree") (("a" "book") "a book"))

; ── Stage 1: Single-feature classification ───────────────────────────
; Output is one of two labels. The discriminating feature is whether
; the previous word is in some small set. The target word is
; constant across rows so the synthesizer must look at position 0.

; Binary classification: prev word is "the" → "definite", else "indefinite".
(task-args "definite_check" 2
  (("the" "cat") "definite") (("the" "dog") "definite") (("the" "house") "definite")
  (("a" "cat") "indefinite") (("a" "dog") "indefinite") (("an" "apple") "indefinite"))

; Article vs. non-article preceding a noun.
(task-args "has_article" 2
  (("the" "cat") "yes") (("a" "dog") "yes") (("an" "apple") "yes")
  (("my" "cat") "no") (("his" "dog") "no") (("their" "apple") "no"))

; Pronoun vs. article — the canonical POS feature.
(task-args "pronoun_or_article" 2
  (("i" "see") "pronoun") (("we" "go") "pronoun") (("they" "run") "pronoun")
  (("the" "cat") "article") (("a" "dog") "article") (("an" "apple") "article"))

; ── Stage 2: The "run" ambiguity ─────────────────────────────────────
; The headline test. Same target word "run" gets different labels
; based on the previous word. The chain must discover that the
; output depends on which set the previous word falls into.

(task-args "run_pos" 2
  (("i" "run") "verb")
  (("they" "run") "verb")
  (("we" "run") "verb")
  (("you" "run") "verb")
  (("a" "run") "noun")
  (("the" "run") "noun")
  (("morning" "run") "noun")
  (("long" "run") "noun"))

; Same idea, more pronouns and modifiers — bigger sets to discriminate.
(task-args "run_pos_extended" 2
  (("i" "run") "verb") (("they" "run") "verb") (("we" "run") "verb")
  (("you" "run") "verb") (("she" "run") "verb") (("he" "run") "verb")
  (("a" "run") "noun") (("the" "run") "noun") (("an" "run") "noun")
  (("my" "run") "noun") (("his" "run") "noun") (("her" "run") "noun"))

; A second ambiguous word: "fly"
(task-args "fly_pos" 2
  (("i" "fly") "verb") (("they" "fly") "verb") (("we" "fly") "verb")
  (("a" "fly") "noun") (("the" "fly") "noun") (("one" "fly") "noun"))

; Two-word ambiguity: "walk"
(task-args "walk_pos" 2
  (("i" "walk") "verb") (("they" "walk") "verb") (("you" "walk") "verb")
  (("a" "walk") "noun") (("the" "walk") "noun") (("morning" "walk") "noun"))

; ── Stage 3: Constructed labels ──────────────────────────────────────
; The label isn't a fixed string per partition — it's a function of
; the inputs. Tests whether the chain composes classification with
; concat-style emission. Likely too hard for P1 string family.

; Tag the target with its part of speech: produce "run/V" or "run/N".
(task-args "run_tagged" 2
  (("i" "run") "run/V") (("they" "run") "run/V") (("we" "run") "run/V")
  (("a" "run") "run/N") (("the" "run") "run/N") (("morning" "run") "run/N"))

; ── Stage 4: 3-word window ───────────────────────────────────────────
; Adds a token before the discriminator. Position 1 is the
; discriminator; position 0 is noise. Tests whether the chain can
; ignore irrelevant atoms.

(task-args "run_pos_3window" 3
  (("yes" "i" "run") "verb") (("now" "they" "run") "verb")
  (("often" "we" "run") "verb") (("today" "you" "run") "verb")
  (("yes" "a" "run") "noun") (("now" "the" "run") "noun")
  (("often" "morning" "run") "noun") (("today" "long" "run") "noun"))

; ── Stage 5: Subject vs object via pairwise equality ────────────────
; The classic syntactic disambiguation. Encoding: positions 0..n-2
; are the sentence words (flat, no nested lists), position n-1 is
; the target word. The label is "subject" if the target equals the
; subject word in the sentence, "object" if it equals the object
; word.
;
; The discriminating function is "target equals sentence-word-at-position-K"
; for some position K. This requires the chain to compare two pool
; entries (target vs subject-position) — the M8s Form 4 pair-equality
; classifier added in §9.47 P1.5.
;
; Note on encoding: a more natural encoding would be
; ((sentence-as-list target-word) → label) but the §9.47 P1 string
; pool only seeds atoms from string-typed positions, not from
; descending into list positions. The flat-tuple encoding keeps
; everything string-typed and lets the existing pool builder work
; without modification. Descending into list atoms is a deferred
; extension.

; Subject + verb + object + target. The discriminator: target == (nth x 0)
; → "subject", target == (nth x 2) → "object". The chain should find
; either ((nth x 3), (nth x 0)) or ((nth x 3), (nth x 2)) as the
; discriminating pair.
(task-args "subj_obj_3word" 4
  (("cats" "chase" "dogs" "cats") "subject")
  (("cats" "chase" "dogs" "dogs") "object")
  (("dogs" "chase" "cats" "dogs") "subject")
  (("dogs" "chase" "cats" "cats") "object")
  (("boys" "see" "girls" "boys") "subject")
  (("boys" "see" "girls" "girls") "object"))

; 5-word sentence + target = 6 positions. Subject is at index 1
; (after "the"), object at index 4 (after the second "the"), target
; at index 5. Discriminator: ((nth x 5), (nth x 1)) or
; ((nth x 5), (nth x 4)).
(task-args "subj_obj_simple" 6
  (("the" "cat" "chased" "the" "dog" "cat") "subject")
  (("the" "cat" "chased" "the" "dog" "dog") "object")
  (("the" "dog" "chased" "the" "cat" "dog") "subject")
  (("the" "dog" "chased" "the" "cat" "cat") "object")
  (("the" "boy" "saw" "the" "girl" "boy") "subject")
  (("the" "boy" "saw" "the" "girl" "girl") "object"))

; ── Stage 6: Mixed POS — three labels ────────────────────────────────
; Stretches binary-classify into multi-class. Three POS labels
; based on the previous word. P1 binary classifier won't handle
; this; tests whether the chain can be extended to k>2.

(task-args "three_pos" 2
  (("i" "run") "verb") (("we" "run") "verb")
  (("the" "run") "noun") (("a" "run") "noun")
  (("very" "fast") "adverb") (("quite" "slow") "adverb")
  (("really" "tall") "adverb"))

; ── Stage 7: Word-internal features (§9.47.3) ────────────────────────
; The label is determined by a morphological property of the target
; word — its suffix, prefix, or capitalization — not by the
; previous-word context. The chain needs derived feature columns
; in the pool to discriminate these.

; Detect gerund by -ing suffix. Single-feature on target.
; Test rows use unseen words to force generalization via suffix predicate.
(task-args "gerund_by_ing" 1
  (("running") "gerund") (("playing") "gerund") (("swimming") "gerund")
  (("eating") "gerund") (("singing") "gerund")
  (("cat") "other") (("dog") "other") (("house") "other") (("tree") "other")
  (test ("dancing") "gerund") (test ("jumping") "gerund")
  (test ("bird") "other") (test ("table") "other"))

; Detect past tense by -ed suffix.
(task-args "past_by_ed" 1
  (("walked") "past") (("played") "past") (("jumped") "past")
  (("kicked") "past") (("opened") "past")
  (("walk") "present") (("play") "present") (("jump") "present") (("open") "present")
  (test ("danced") "past") (test ("closed") "past")
  (test ("dance") "present") (test ("close") "present"))

; Detect plural by -s suffix.
(task-args "plural_by_s" 1
  (("cats") "plural") (("dogs") "plural") (("houses") "plural")
  (("trees") "plural") (("books") "plural")
  (("cat") "singular") (("dog") "singular") (("house") "singular") (("book") "singular")
  (test ("birds") "plural") (test ("fish") "singular"))

; Detect proper noun by initial capital.
(task-args "proper_by_capital" 1
  (("Alice") "proper") (("Bob") "proper") (("Charlie") "proper")
  (("London") "proper") (("Paris") "proper")
  (("cat") "common") (("dog") "common") (("house") "common") (("river") "common")
  (test ("David") "proper") (test ("Tokyo") "proper")
  (test ("chair") "common") (test ("lamp") "common"))

; Detect prefix-derived negation.
(task-args "negation_by_un" 1
  (("undo") "negation") (("untie") "negation") (("unhappy") "negation")
  (("unlock") "negation") (("unfair") "negation")
  (("happy") "neutral") (("tie") "neutral") (("fair") "neutral") (("lock") "neutral")
  (test ("unseen") "negation") (test ("unclear") "negation")
  (test ("seen") "neutral") (test ("clear") "neutral"))

; Three-class morphology: -ing → gerund, -ed → past, otherwise base.
; This is the canonical Phase 2 case: no single suffix discriminates
; all three classes (ing distinguishes gerund from {past, base},
; ed distinguishes past from {gerund, base}). Only the conjunction
; (ends-in-ing × ends-in-ed) gives a clean 3-way partition.
(task-args "verb_form" 1
  (("running") "gerund") (("playing") "gerund") (("eating") "gerund")
  (("walked") "past") (("played") "past") (("opened") "past")
  (("run") "base") (("walk") "base") (("eat") "base")
  (test ("dancing") "gerund") (test ("closed") "past") (test ("dance") "base"))

; ── Stage 8: Feature conjunctions (§9.47.3) ──────────────────────────
; The label depends on the AND of two features. No single feature
; suffices; the chain must combine two pool entries via Form 6.

; Article + -ing → gerund-as-noun. Pronoun + -ing → present-progressive.
; Article + non-ing → noun. Pronoun + non-ing → other.
; Four-way partition over two features: (prev word class × target suffix).
(task-args "gerund_context" 2
  (("the" "running") "gerund-noun") (("a" "swimming") "gerund-noun")
  (("the" "playing") "gerund-noun")
  (("i" "running") "verb-progressive") (("we" "swimming") "verb-progressive")
  (("they" "playing") "verb-progressive")
  (("the" "cat") "common-noun") (("a" "dog") "common-noun")
  (("the" "house") "common-noun")
  (("i" "cat") "other") (("we" "dog") "other") (("they" "house") "other")
  (test ("the" "dancing") "gerund-noun") (test ("she" "dancing") "verb-progressive")
  (test ("a" "bird") "common-noun") (test ("he" "bird") "other"))

; Capitalization + suffix conjunction. Capital + -land/-burg etc would
; be a place name; we test the simpler "capital + -ing" → "proper gerund"
; vs other combinations.
(task-args "capital_morph" 2
  (("Alice" "running") "proper-gerund") (("Bob" "playing") "proper-gerund")
  (("Charlie" "swimming") "proper-gerund")
  (("alice" "running") "common-gerund") (("bob" "playing") "common-gerund")
  (("charlie" "swimming") "common-gerund")
  (("Alice" "cat") "proper-noun") (("Bob" "dog") "proper-noun")
  (("alice" "cat") "common-noun") (("bob" "dog") "common-noun"))

; ── Stage 9: Sequence-position arithmetic (§9.47.3) ──────────────────
; Position of target relative to position of verb determines the
; subject/object label. Encoding gives the indices directly so the
; chain doesn't need to find them — Form 5 (numeric ordering classify)
; just discovers `(< target_idx verb_idx)` as the discriminator.
;
; This is the deferred sequence-position arithmetic from §9.47.2: the
; minimal demonstration that the chain can use numeric atoms to
; discriminate non-numeric outputs.

(task-args "subj_obj_by_idx" 2
  ((1 3) "subject") ((5 3) "object")
  ((0 2) "subject") ((4 2) "object")
  ((2 5) "subject") ((7 5) "object"))

; Variant: comparison against a fixed verb position. Inputs are
; (target_idx, verb_idx) where verb_idx varies but the relationship
; is the same.
(task-args "before_after" 2
  ((0 2) "before") ((1 2) "before") ((3 2) "after") ((4 2) "after")
  ((1 5) "before") ((2 5) "before") ((6 5) "after") ((7 5) "after"))

; Equality-based: same position → "match", different → "diff".
; Should solve via Form 4 (pair-equality on numeric atoms), not Form 5.
(task-args "pos_match" 2
  ((1 1) "match") ((2 2) "match") ((5 5) "match")
  ((1 2) "diff") ((3 5) "diff") ((0 4) "diff"))

; ── Stage 10: Three-feature classification (Tier 3) ──────────────────
; These tasks require THREE features to discriminate all labels —
; impossible for the previous hand-coded Form 6 which iterated
; pairwise pool entries. They prove that the recursive partial-match
; classifier generalizes beyond Form 6 to arbitrary feature depth.
;
; Each task has 6 distinct labels formed from the cross-product of
; three boolean features. The recursive classifier should discover the
; nested structure via 3 levels of recursion.

; capital × ing × ed: 6 labels from 3 morphological features.
; capital  ing  ed → label
;   T       T   F → proper-gerund
;   T       F   T → proper-past
;   T       F   F → proper-base
;   F       T   F → common-gerund
;   F       F   T → common-past
;   F       F   F → common-base
(task-args "word_class_3feat" 1
  (("Running") "proper-gerund") (("Playing") "proper-gerund")
  (("Walked") "proper-past") (("Opened") "proper-past")
  (("Run") "proper-base") (("Walk") "proper-base")
  (("running") "common-gerund") (("playing") "common-gerund")
  (("walked") "common-past") (("opened") "common-past")
  (("run") "common-base") (("walk") "common-base")
  (test ("Dancing") "proper-gerund") (test ("dancing") "common-gerund")
  (test ("Closed") "proper-past") (test ("closed") "common-past")
  (test ("Dance") "proper-base") (test ("dance") "common-base"))

; prev-word-class × ing × ed: 6 labels from prev-word morphology +
; target morphology. Prev-word = article ({the, a}) vs pronoun
; ({i, we, they}). Target morphology = ing/ed/neither.
(task-args "morph_context_3feat" 2
  (("the" "running") "art-gerund") (("a" "swimming") "art-gerund")
  (("the" "walked") "art-past") (("a" "opened") "art-past")
  (("the" "cat") "art-base") (("a" "dog") "art-base")
  (("i" "running") "pro-gerund") (("we" "swimming") "pro-gerund")
  (("i" "walked") "pro-past") (("we" "opened") "pro-past")
  (("i" "cat") "pro-base") (("we" "dog") "pro-base")
  (test ("the" "dancing") "art-gerund") (test ("they" "dancing") "pro-gerund")
  (test ("a" "closed") "art-past") (test ("they" "closed") "pro-past")
  (test ("the" "bird") "art-base") (test ("they" "bird") "pro-base"))

; ── Stage 11: Morphological feature expansion ────────────────────────
; Each task is a single-feature suffix or prefix classifier.
; Goal: amplify the "(if (contains (list ?BOOL?) (string-X (nth x ?INT?)
; ?STR?)) ?STR? ?STR?)" cluster in the journal so its frequency makes
; it a clear candidate for template extraction. Currently 3 instances
; (gerund_by_ing, past_by_ed, plural_by_s); after this stage: 10+.
; All suffixes/prefixes used here are in the m_pool_string catalogue.

(task-args "adverb_by_ly" 1
  (("quickly") "adverb") (("slowly") "adverb") (("happily") "adverb")
  (("kindly") "adverb") (("badly") "adverb")
  (("cat") "other") (("dog") "other") (("house") "other") (("tree") "other")
  (test ("brightly") "adverb") (test ("clearly") "adverb")
  (test ("bird") "other") (test ("table") "other"))

(task-args "comparative_by_er" 1
  (("bigger") "comparative") (("faster") "comparative") (("smarter") "comparative")
  (("warmer") "comparative") (("kinder") "comparative")
  (("big") "base") (("fast") "base") (("smart") "base") (("warm") "base")
  (test ("smaller") "comparative") (test ("colder") "comparative")
  (test ("small") "base") (test ("cold") "base"))

(task-args "superlative_by_est" 1
  (("biggest") "superlative") (("fastest") "superlative") (("smartest") "superlative")
  (("warmest") "superlative") (("kindest") "superlative")
  (("big") "base") (("fast") "base") (("smart") "base") (("warm") "base")
  (test ("smallest") "superlative") (test ("coldest") "superlative")
  (test ("small") "base") (test ("cold") "base"))

(task-args "nominal_by_tion" 1
  (("creation") "nominal") (("invention") "nominal") (("station") "nominal")
  (("nation") "nominal") (("suggestion") "nominal")
  (("create") "verbal") (("invent") "verbal") (("walk") "verbal") (("run") "verbal")
  (test ("attention") "nominal") (test ("dance") "verbal"))

(task-args "redo_by_re" 1
  (("redo") "redo") (("rewrite") "redo") (("rebuild") "redo")
  (("retry") "redo") (("renew") "redo")
  (("undo") "other") (("dislike") "other") (("preview") "other") (("see") "other")
  (test ("repeat") "redo") (test ("write") "other"))

(task-args "negation_by_dis" 1
  (("dislike") "negation") (("disagree") "negation") (("disconnect") "negation")
  (("disable") "negation") (("disappear") "negation")
  (("like") "neutral") (("agree") "neutral") (("redo") "neutral") (("see") "neutral")
  (test ("dismiss") "negation") (test ("connect") "neutral"))

(task-args "temporal_by_pre" 1
  (("preview") "temporal") (("predict") "temporal") (("prepay") "temporal")
  (("preheat") "temporal") (("preset") "temporal")
  (("view") "neutral") (("dict") "neutral") (("undo") "neutral") (("see") "neutral")
  (test ("prefix") "temporal") (test ("pay") "neutral"))

; ── Stage 12: 2-feature recursive (more verb_form-like) ──────────────
; Tests whether the recursive classifier discovers different 2-feature
; combinations beyond the 2 we already have (verb_form, gerund_context).

; 3 classes by 2 suffixes: -er → comparative, -est → superlative, else → base
(task-args "adj_form_3way" 1
  (("bigger") "comparative") (("faster") "comparative") (("warmer") "comparative")
  (("biggest") "superlative") (("fastest") "superlative") (("warmest") "superlative")
  (("big") "base") (("fast") "base") (("warm") "base")
  (test ("smaller") "comparative") (test ("smallest") "superlative") (test ("small") "base"))

; 3 classes mixing suffix types: -ly → adverb, -ed → past-verb, else → noun
(task-args "word_role_3way" 1
  (("quickly") "adverb") (("slowly") "adverb") (("kindly") "adverb")
  (("walked") "past-verb") (("played") "past-verb") (("opened") "past-verb")
  (("cat") "noun") (("dog") "noun") (("house") "noun")
  (test ("brightly") "adverb") (test ("danced") "past-verb") (test ("bird") "noun"))

; 3-way prefix split: re- → repeat, dis- → negate, else → other
(task-args "verb_prefix_3way" 1
  (("redo") "repeat") (("rewrite") "repeat") (("retry") "repeat")
  (("dislike") "negate") (("disagree") "negate") (("disable") "negate")
  (("walk") "other") (("see") "other") (("eat") "other")
  (test ("rebuild") "repeat") (test ("disconnect") "negate") (test ("run") "other"))

; ── Stage 13: 3-feature recursive (Tier 3 expansion) ─────────────────

; 6 classes via 3 features: capital × ly × ed
;   Capital + ly        → proper-adverb
;   Capital + ed        → proper-past
;   Capital + neither   → proper-base
;   lower   + ly        → common-adverb
;   lower   + ed        → common-past
;   lower   + neither   → common-base
(task-args "word_3feat_lyEd" 1
  (("Quickly") "proper-adverb") (("Slowly") "proper-adverb")
  (("Walked") "proper-past") (("Opened") "proper-past")
  (("Run") "proper-base") (("Walk") "proper-base")
  (("quickly") "common-adverb") (("slowly") "common-adverb")
  (("walked") "common-past") (("opened") "common-past")
  (("run") "common-base") (("walk") "common-base")
  (test ("Brightly") "proper-adverb") (test ("brightly") "common-adverb")
  (test ("Closed") "proper-past") (test ("closed") "common-past")
  (test ("Dance") "proper-base") (test ("dance") "common-base"))

; ── Stage 14: 4-feature recursive (push depth to 4) ──────────────────
; This is intentionally beyond what was previously demonstrated.
; The recursive classifier has max-depth 4; this exercises that limit.

; 8 classes by capital × ing × ed × ly
;   First feature splits proper/common (2 groups)
;   Each group splits by ing/ed/ly/none into 4 sub-classes (8 total)
(task-args "word_4feat" 1
  (("Running") "proper-gerund") (("Playing") "proper-gerund")
  (("Walked") "proper-past") (("Opened") "proper-past")
  (("Quickly") "proper-adverb") (("Slowly") "proper-adverb")
  (("Run") "proper-base") (("Walk") "proper-base")
  (("running") "common-gerund") (("playing") "common-gerund")
  (("walked") "common-past") (("opened") "common-past")
  (("quickly") "common-adverb") (("slowly") "common-adverb")
  (("run") "common-base") (("walk") "common-base")
  (test ("Dancing") "proper-gerund") (test ("dancing") "common-gerund")
  (test ("Closed") "proper-past") (test ("closed") "common-past")
  (test ("Brightly") "proper-adverb") (test ("brightly") "common-adverb")
  (test ("Dance") "proper-base") (test ("dance") "common-base"))

; ── Stage 15: Library composition (reuse previous solutions) ─────────
; Tasks where the natural solution composes a previously-solved task
; as a library function. Goal: surface library-reuse patterns in
; the journal — solutions like (lambda (x) (prev_task_name (list ...)))
; or (if (contains ... (prev_task_name ...)) ...).

; Should solve via direct reuse of gerund_by_ing
(task-args "is_gerund_alias" 1
  (("running") "gerund") (("playing") "gerund") (("eating") "gerund")
  (("cat") "other") (("dog") "other") (("house") "other") (("tree") "other")
  (test ("singing") "gerund") (test ("bird") "other"))

; Should compose: if comparative_by_er then "more", else if superlative_by_est then "most", else "base"
(task-args "intensity_3way" 1
  (("bigger") "more") (("faster") "more") (("warmer") "more")
  (("biggest") "most") (("fastest") "most") (("warmest") "most")
  (("big") "base") (("fast") "base") (("warm") "base")
  (test ("smaller") "more") (test ("smallest") "most") (test ("small") "base"))

; Should reuse has_article: prev=article + target=ing → "noun-phrase", else → "other"
(task-args "noun_phrase_check" 2
  (("the" "running") "noun-phrase") (("a" "swimming") "noun-phrase")
  (("the" "playing") "noun-phrase") (("an" "eating") "noun-phrase")
  (("i" "running") "other") (("we" "swimming") "other")
  (("the" "cat") "other") (("a" "dog") "other")
  (("they" "playing") "other") (("i" "cat") "other")
  (test ("the" "dancing") "noun-phrase") (test ("they" "dancing") "other")
  (test ("a" "bird") "other"))
