; Test where promoted macros ARE the outermost function
; RD needs to try macros as candidates, not just builtins

; Base macros to promote
(task "double" 1
  (1 2) (3 6) (5 10) (0 0) (4 8))

(task "triple" 1
  (1 3) (2 6) (3 9) (0 0) (4 12))

(task "increment" 1
  (0 1) (1 2) (5 6) (10 11) (3 4))

; Now: output = double(string-length(x))
; RD should try "double" as outermost, invert to get g(x) = output/2,
; then sub-synth finds (string-length x)
(task "double_len" 2
  ("hi" 4) ("hello" 10) ("a" 2) ("test" 8) ("abc" 6))

; output = triple(string-length(x))
(task "triple_len" 2
  ("hi" 6) ("hello" 15) ("a" 3) ("test" 12) ("abc" 9))

; output = increment(string-length(x))
(task "len_plus_1" 2
  ("hi" 3) ("hello" 6) ("a" 2) ("test" 5) ("abc" 4))

; output = double(increment(x)) — depth 2 composition of promoted macros
(task "double_inc" 2
  (0 2) (1 4) (2 6) (3 8) (5 12))
