; Formal language curriculum — character-native
; Input: "idx c0 c1 c2 c3" (index + 4-char context window, space-separated)
; Output: next character (single-char string)
;
; Uses char_helpers.selph for accessors: idx, c0-c3, last, next-char, prev-char
; Uses char-code/code-char builtins for character arithmetic

; === Stage 0: Constant/repeat patterns ===
; f(i) = "a" always
(task "repeat_a" 2
  ("4 a a a a" "a") ("5 a a a a" "a") ("6 a a a a" "a")
  ("7 a a a a" "a") ("8 a a a a" "a"))

; f(i) = "b" always
(task "repeat_b" 2
  ("4 b b b b" "b") ("5 b b b b" "b") ("6 b b b b" "b")
  ("7 b b b b" "b") ("8 b b b b" "b"))

; === Stage 1: Alternation (period 2) ===
; "ababab..." — next char = c2 (two back in the window)
(task "alt_ab" 2
  ("4 a b a b" "a") ("5 b a b a" "b")
  ("6 a b a b" "a") ("7 b a b a" "b")
  ("8 a b a b" "a"))

; "cdcdcd..." — same pattern with c/d
(task "alt_cd" 2
  ("4 c d c d" "c") ("5 d c d c" "d")
  ("6 c d c d" "c") ("7 d c d c" "d")
  ("8 c d c d" "c"))

; === Stage 2: Period 3 cycle ===
; "abcabcabc..." — next = c1 (three back)
(task "cycle_abc" 2
  ("4 b c a b" "c") ("5 c a b c" "a") ("6 a b c a" "b")
  ("7 b c a b" "c") ("8 c a b c" "a"))

; === Stage 3: Character arithmetic ===
; Ascending: each char is next-char of previous (a b c d e f ...)
; f(i) = next-char(c3)
(task "ascending" 2
  ("4 a b c d" "e") ("5 b c d e" "f")
  ("6 c d e f" "g") ("7 d e f g" "h")
  ("8 e f g h" "i"))

; Descending: each char is prev-char of previous (z y x w v ...)
; f(i) = prev-char(c3)
(task "descending" 2
  ("4 z y x w" "v") ("5 y x w v" "u")
  ("6 x w v u" "t") ("7 w v u t" "s")
  ("8 v u t s" "r"))

; Step by 2: a c e g i k ...
; f(i) = code-char(add(char-code(c3), 2))
(task "step2" 2
  ("4 a c e g" "i") ("5 c e g i" "k")
  ("6 e g i k" "m") ("7 g i k m" "o")
  ("8 i k m o" "q"))

; === Stage 4: Lookahead patterns ===
; Echo c0 (4 positions back) — tests deeper context access
(task "echo_c0" 2
  ("4 a b c d" "a") ("5 b c d a" "b")
  ("6 c d a b" "c") ("7 d a b c" "d")
  ("8 a b c d" "a"))

; Echo c1 (3 positions back)
(task "echo_c1" 2
  ("4 a b c d" "b") ("5 b c d b" "c")
  ("6 c d b c" "d") ("7 d b c d" "b")
  ("8 b c d b" "c"))

; === Stage 5: Character logic ===
; Uppercase if char-code is even, lowercase if odd
; (if (even (char-code c3)) (string-upper c3) (string-lower c3))
(task "case_by_parity" 2
  ("4 a b c d" "D") ("5 b c d D" "d")
  ("6 c d D d" "d") ("7 d D d d" "D")
  ("8 D d d D" "d"))

; === Stage 6: Fibonacci-like on characters ===
; Each char = code-char(add(char-code(c2), char-code(c3)) mod 26 + 97)
; This combines character arithmetic with modular wrapping
(task "char_fib" 3
  ("4 a b c e" "h") ("5 b c e h" "m")
  ("6 c e h m" "u") ("7 e h m u" "h")
  ("8 h m u h" "c"))
